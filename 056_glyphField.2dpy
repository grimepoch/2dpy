def Init():
   # --- author : claude
   # --- an ASCII art renderer : a moving field is sampled onto a character
   # --- grid and drawn with a density ramp, densest glyph = brightest
   # --- note : screen y=0 is the BOTTOM, so text must be drawn y-flipped
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Zoom")
   STR.SetFParam1Name("Contrast")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : monochrome
   # ---    trigger : plasma <-> rings

   GLB.ramp = " .,:;irsXA253hMHGS#9B&@"
   GLB.cw = 26
   GLB.chh = 31
   GLB.nx = int(1280 / GLB.cw) + 1
   GLB.ny = int(720 / GLB.chh) + 1
   xs = np.arange(GLB.nx, dtype=np.float32) * GLB.cw
   ys = np.arange(GLB.ny, dtype=np.float32) * GLB.chh
   GLB.X = np.tile(xs.reshape(1, GLB.nx), (GLB.ny, 1))
   GLB.Y = np.tile(ys.reshape(GLB.ny, 1), (1, GLB.nx))

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.002, 0.016)
   f1 = STR.F1mix(0.7, 2.8)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0

   x = GLB.X * f0
   y = GLB.Y * f0

   if GLB.xmode:
      d = np.sqrt((GLB.X - 640.0) ** 2 + (GLB.Y - 360.0) ** 2) * f0
      v = 0.5 + 0.5 * np.sin(d * 3.0 - time * 2.4)
   else:
      v = (np.sin(x * 2.0 + time * 1.1) +
           np.sin(y * 1.7 - time * 0.8) +
           np.sin((x + y) * 1.3 + time * 0.5)) / 3.0
      v = 0.5 + 0.5 * v
   v = np.clip((v - 0.5) * f1 + 0.5, 0.0, 0.999)

   idx = (v * len(GLB.ramp)).astype(np.int32)

   cr.set_source_rgb(0,0,0)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cr.select_font_face("mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
   cr.set_font_size(GLB.cw)

   ramp = GLB.ramp
   nr = len(ramp) - 1.0

   # --- colour depends only on the ramp level, so build the palette once
   # --- per frame instead of calling hsv_to_rgb for every cell
   pal = []
   for c in range(len(ramp)):
      t = c / nr
      if acc:
         pal.append((t, t, t))
      else:
         r,g,b = hsv_to_rgb((f2 + t * 0.32) % 1.0, 0.85 - 0.5 * t, 0.25 + 0.75 * t)
         pal.append((b, g, r))

   # --- flip ONCE for the whole grid rather than save/scale/restore per glyph
   cr.save()
   cr.scale(1.0, -1.0)
   last = -1
   for j in range(GLB.ny):
      row = idx[j]
      yy = -(j * GLB.chh)
      k = 0
      while k < GLB.nx:
         c = row[k]
         k2 = k + 1
         while k2 < GLB.nx and row[k2] == c:
            k2 = k2 + 1
         if c > 0:
            if c != last:
               p = pal[c]
               cr.set_source_rgb(p[0], p[1], p[2])
               last = c
            cr.move_to(k * GLB.cw, yy)
            cr.show_text(ramp[c] * (k2 - k))
         k = k2
   cr.restore()
