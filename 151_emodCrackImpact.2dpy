def Init():
   # --- author : claude
   # --- every note is a blow to the pane : cracks run out from where it lands
   # --- and the older fractures stay in the glass
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Growth")
   STR.SetFParam1Name("Branching")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"
   # ---    accent : flash on impact
   # ---    trigger : replace the pane

   GLB.seg = []
   GLB.tip = []
   GLB.hits = []
   GLB.prev = []
   for i in range(24):
      GLB.prev.append(0)
   GLB.flash = 0.0

   def impact(x, y, velo):
      n = 4 + int(velo / 24)
      for i in range(n):
         a = i * 2.0 * pi / n + np.random.random() * 0.6
         GLB.tip.append([x, y, a, 0.4 + velo / 127.0])
      GLB.hits.append([x, y, 1.0])
      GLB.flash = velo / 127.0
      while len(GLB.hits) > 10:
         del GLB.hits[0]
   GLB.impact = impact

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(2.0, 20.0)
   f1 = STR.F1mix(0.0, 0.14)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.seg = []
      GLB.tip = []
      GLB.hits = []
      GLB.xmode = 1 if GLB.xmode==0 else 0

   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      if GLB.mode == "midi":
         if ids != 0 and GLB.prev[i] != ids:
            GLB.impact(120.0 + (note % 12) / 11.0 * 1040.0,
                       100.0 + np.random.random() * 520.0, velo)
         GLB.prev[i] = ids
      else:
         if velo > 74 and GLB.prev[i] <= 74:
            GLB.impact(120.0 + i / (GLB.slots * 1.0) * 1040.0,
                       100.0 + np.random.random() * 520.0, velo)
         GLB.prev[i] = velo

   GLB.flash = GLB.flash * 0.85
   b = 0.03
   if acc:
      b = 0.03 + GLB.flash * 0.35
   cr.set_source_rgb(b, b, b + 0.02)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   newtips = []
   for t in GLB.tip:
      if t[3] <= 0.03 or len(GLB.seg) > 900:
         continue
      x0 = t[0]
      y0 = t[1]
      t[2] = t[2] + (np.random.random() - 0.5) * 0.34
      d = f0 * t[3]
      t[0] = t[0] + cos(t[2]) * d
      t[1] = t[1] + sin(t[2]) * d
      t[3] = t[3] * 0.982
      GLB.seg.append([x0, y0, t[0], t[1], t[3]])
      if t[0] < 0 or t[0] > 1280 or t[1] < 0 or t[1] > 720:
         continue
      newtips.append(t)
      if np.random.random() < f1 and len(newtips) < 60:
         newtips.append([t[0], t[1], t[2] + (np.random.random() - 0.5) * 1.6,
                         t[3] * 0.7])
   GLB.tip = newtips
   while len(GLB.seg) > 900:
      del GLB.seg[0]

   bands = 5
   for bd in range(bands):
      lo = bd / (bands * 1.0)
      hi = (bd + 1) / (bands * 1.0)
      t = bd / (bands - 1.0)
      if GLB.xmode:
         c = hsv_to_rgb((f2 + t * 0.5) % 1.0, 0.7, 0.4 + 0.6 * t)
      else:
         c = hsv_to_rgb((f2 + t * 0.08) % 1.0, 0.18, 0.45 + 0.55 * t)
      cr.set_source_rgb(c[2], c[1], c[0])
      cr.set_line_width(0.8 + 3.2 * t)
      any = 0
      for s in GLB.seg:
         if s[4] < lo or s[4] >= hi:
            continue
         cr.move_to(s[0], s[1])
         cr.line_to(s[2], s[3])
         any = 1
      if any:
         cr.stroke()

   for h in GLB.hits:
      h[2] = h[2] * 0.94
      if h[2] < 0.03:
         continue
      for k in range(5, 0, -1):
         u = k / 5.0
         cr.set_source_rgba(1, 1, 1, h[2] * (1.0 - u) * 0.5)
         cr.new_sub_path()
         cr.arc(h[0], h[1], 60.0 * u, 0, 2 * pi)
         cr.fill()
