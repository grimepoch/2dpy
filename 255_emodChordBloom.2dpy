def Init():
   # --- author : claude
   # --- chords as overlapping blooms.  Every note opens a petal at its own
   # --- angle and the canvas holds them, so a chord held down builds a
   # --- rosette and a chord change leaves the old one fading behind the new
   # --- - the harmony is visible as a shape rather than as separate events.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Bloom")
   STR.SetFParam1Name("Persistence")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : the blooms rotate
   # ---    trigger : reseat the rosette

   GLB.st = surface.get_stride() // 4
   GLB.prev = np.zeros(GLB.slots, dtype=np.float32)
   GLB.spin = 0.0
   GLB.cx = 640.0
   GLB.cy = 360.0

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(60.0, 300.0)
   f1 = STR.F1mix(4.0, 8.0)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.cx = 300.0 + np.random.random() * 680.0
      GLB.cy = 200.0 + np.random.random() * 320.0
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   np.subtract(v, np.right_shift(v, int(f1)), out=v)
   v[:, :, 3] = 255
   surface.mark_dirty()

   if acc:
      GLB.spin = GLB.spin + 0.035

   for i in range(GLB.slots):
      d = STR.GetSlotData(i)
      vel = d[2] * 1.0
      if d[0] != 0 and vel > GLB.prev[i] + 5.0:
         n = int(d[1])
         # --- pitch class round the circle of fifths, so related notes sit
         # --- next to each other and a triad opens as a fan
         pc = (n * 7) % 12
         a = pc * 0.5236 + GLB.spin
         rr = f0 * (0.35 + (vel / 127.0) * 0.85)
         oct_ = (n // 12) % 6
         c = hsv_to_rgb((f2 + pc / 12.0) % 1.0, 0.80, 1.0)
         cr.save()
         cr.translate(GLB.cx, GLB.cy)
         cr.rotate(a)
         cr.set_source_rgba(c[2], c[1], c[0], 0.40)
         # --- a petal : two arcs meeting at a point
         w = rr * (0.20 + oct_ * 0.035)
         cr.move_to(0, 0)
         cr.curve_to(w, rr * 0.35, w, rr * 0.75, 0, rr)
         cr.curve_to(-w, rr * 0.75, -w, rr * 0.35, 0, 0)
         cr.close_path()
         cr.fill()
         cr.set_source_rgba(c[2], c[1], c[0], 0.9)
         cr.set_line_width(1.6)
         cr.move_to(0, 0)
         cr.line_to(0, rr)
         cr.stroke()
         cr.restore()
      GLB.prev[i] = vel
