def Init():
   # --- author : claude
   # --- a rack of LED modules reading out what is actually arriving : note
   # --- number, velocity and a bar, one module per slot
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Decay")
   STR.SetFParam1Name("Size")
   STR.SetFParam2Name("Hue")
   # ---    accent : lamp test, all segments on
   # ---    trigger : note number <-> velocity

   # --- 10 slots = FFT analysis bins, 24 slots = MIDI notes
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"

   GLB.map = {"0":"1111110","1":"0110000","2":"1101101","3":"1111001",
              "4":"0110011","5":"1011011","6":"1011111","7":"1110000",
              "8":"1111111","9":"1111011","-":"0000001"," ":"0000000"}
   GLB.n = 12 if GLB.slots == 24 else GLB.slots
   GLB.val = []
   GLB.lvl = []
   for i in range(GLB.n):
      GLB.val.append(0)
      GLB.lvl.append(0.0)

   def seg(x, y, w, h, t, which, on, col, dimc):
      if on:
         cr.set_source_rgb(col[2], col[1], col[0])
      else:
         cr.set_source_rgb(dimc[2], dimc[1], dimc[0])
      h2 = t * 0.5
      if which in "adg":
         if which == "a":
            cy = y + h
         elif which == "g":
            cy = y + h * 0.5
         else:
            cy = y
         cr.move_to(x + h2, cy - h2)
         cr.line_to(x + w - h2, cy - h2)
         cr.line_to(x + w, cy)
         cr.line_to(x + w - h2, cy + h2)
         cr.line_to(x + h2, cy + h2)
         cr.line_to(x, cy)
      else:
         cx = x + w if which in "bc" else x
         if which in "bf":
            y0 = y + h * 0.5
            y1 = y + h
         else:
            y0 = y
            y1 = y + h * 0.5
         cr.move_to(cx - h2, y0 + h2)
         cr.line_to(cx - h2, y1 - h2)
         cr.line_to(cx, y1)
         cr.line_to(cx + h2, y1 - h2)
         cr.line_to(cx + h2, y0 + h2)
         cr.line_to(cx, y0)
      cr.close_path()
      cr.fill()
   GLB.seg = seg

   def digit(x, y, w, h, t, ch, col, dimc, allon):
      pat = GLB.map.get(ch, "0000000")
      order = "abcdefg"
      for i in range(7):
         GLB.seg(x, y, w, h, t, order[i], allon or pat[i] == "1", col, dimc)
   GLB.digit = digit

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.80, 0.99)
   f1 = STR.F1mix(28.0, 56.0)
   f2 = STR.F2()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0

   n = GLB.n
   for k in range(n):
      GLB.lvl[k] = GLB.lvl[k] * f0

   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      if ids == 0:
         continue
      k = (note % 12) if GLB.mode == "midi" else i
      if k < n:
         v = velo / 127.0
         if v > GLB.lvl[k]:
            GLB.lvl[k] = v
            GLB.val[k] = velo if GLB.xmode else note

   cr.set_source_rgb(0.03, 0.02, 0.04)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cols = 4 if n > 6 else 3
   rows = int((n + cols - 1) / cols)
   bw = 1280.0 / cols
   bh = 720.0 / rows

   h = f1
   w = h * 0.58
   t = h * 0.17
   gap = h * 0.24

   for k in range(n):
      v = GLB.lvl[k]
      cx = (k % cols) * bw + bw * 0.5
      cy = 720.0 - (int(k / cols) * bh) - bh * 0.55

      col  = hsv_to_rgb((f2 + k / (n * 1.0) * 0.4) % 1.0, 0.85, 0.25 + 0.75 * v)
      dimc = hsv_to_rgb((f2 + k / (n * 1.0) * 0.4) % 1.0, 0.9, 0.09)

      # --- module body
      cr.set_source_rgb(0.07, 0.06, 0.09)
      cr.rectangle(cx - bw * 0.40, cy - bh * 0.30, bw * 0.80, bh * 0.60)
      cr.fill()

      s = "%3d" % GLB.val[k]
      x = cx - ((w + gap) * 3 - gap) * 0.5
      y = cy - h * 0.5 + bh * 0.06
      for ch in s:
         GLB.digit(x, y, w, h, t, ch, col, dimc, acc)
         x = x + w + gap

      # --- level bar under the digits
      cr.set_source_rgb(col[2], col[1], col[0])
      cr.rectangle(cx - bw * 0.34, cy - bh * 0.25, bw * 0.68 * v, bh * 0.07)
      cr.fill()
