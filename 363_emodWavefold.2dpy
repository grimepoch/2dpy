def Init():
   # --- author : claude
   # --- a wavefolder.  Drive a sine past the rails and instead of clipping
   # --- it, fold it back - so the harder it is pushed the more times it
   # --- turns over, and the spectrum fills up with odd partials that were
   # --- not there a moment ago.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Drive")
   STR.SetFParam1Name("Symmetry")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : hard clip instead of fold
   # ---    trigger : change the input shape

   GLB.st = surface.get_stride() // 4
   GLB.shape = 0
   GLB.lvl = 0.0
   GLB.ph = 0.0

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(1.0, 9.0)
   f1 = STR.F1mix(-0.8, 0.8)
   f2 = STR.F2()

   if trig:
      GLB.shape = (GLB.shape + 1) % 3
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   lv = 0.0
   for i in range(GLB.slots):
      d = STR.GetSlotData(i)
      if d[0] != 0:
         lv = max(lv, d[2] / 127.0)
   GLB.lvl = max(lv, GLB.lvl * 0.90)
   GLB.ph = GLB.ph + 0.012

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   np.subtract(v, np.right_shift(v, 1), out=v)
   v[:, :, 3] = 255
   surface.mark_dirty()

   # --- a heavily folded wave turns over many times per input cycle, so it
   # --- needs several samples per fold or it draws as vertical dashes
   N = 3200
   t = np.linspace(0.0, 1.0, N)
   if GLB.shape == 0:
      x = np.sin(t * 6.2831853 + GLB.ph)
   elif GLB.shape == 1:
      x = 2.0 * np.abs(2.0 * ((t + GLB.ph * 0.16) % 1.0) - 1.0) - 1.0
   else:
      x = ((t + GLB.ph * 0.16) % 1.0) * 2.0 - 1.0

   drive = f0 * (0.4 + GLB.lvl * 1.3)
   y = x * drive + f1
   if acc:
      y = np.clip(y, -1.0, 1.0)
   else:
      # --- the fold : reflect about the rail as many times as it takes.
      # --- Writing it as a triangle wave of the driven signal does all the
      # --- reflections at once.
      y = np.abs(np.mod(y + 1.0, 4.0) - 2.0) - 1.0

   px = t * 1280.0
   py = 360.0 - y * 250.0
   ix = px.astype(np.int32)
   iy = np.clip(py, 1, 718).astype(np.int32)
   ok = (ix > 0) & (ix < 1279)
   c = hsv_to_rgb((f2 + GLB.lvl * 0.2) % 1.0, 0.80, 1.0)
   sx = ix[ok]
   sy = iy[ok]
   for d in (-2, -1, 0, 1, 2):
      yy = np.clip(sy + d, 0, 719)
      v[yy, sx, 0] = int(c[2] * 255)
      v[yy, sx, 1] = int(c[1] * 255)
      v[yy, sx, 2] = int(c[0] * 255)
   v[:, :, 3] = 255
   surface.mark_dirty()

   # --- the rails the signal is folding against
   cr.set_source_rgba(0.8, 0.3, 0.3, 0.35)
   cr.set_line_width(1.0)
   cr.move_to(0, 110)
   cr.line_to(1280, 110)
   cr.move_to(0, 610)
   cr.line_to(1280, 610)
   cr.stroke()
