def Init():
   # --- author : claude
   # --- voronoi cells from drifting sites; numpy finds the owners, then each
   # --- scanline is drawn as runs of equal cells instead of one rect per pixel
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Resolution")
   STR.SetFParam1Name("Sites")
   STR.SetFParam2Name("Drift")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : white cell borders
   # ---    trigger : reseed every site

   GLB.nmax = 26
   GLB.bs   = 0

   def seed():
      GLB.px = np.random.random(GLB.nmax) * 1280.0
      GLB.py = np.random.random(GLB.nmax) * 720.0
      GLB.vx = (np.random.random(GLB.nmax) - 0.5) * 6.0
      GLB.vy = (np.random.random(GLB.nmax) - 0.5) * 6.0
      GLB.hu = np.random.random(GLB.nmax)
   GLB.seed = seed
   GLB.seed()

   def build(bs):
      nx = int(1280 / bs) + 1
      ny = int(720 / bs) + 1
      GLB.nx = nx
      GLB.ny = ny
      GLB.xs = (np.arange(nx) * bs + bs * 0.5).reshape(1, nx, 1).astype(np.float32)
      GLB.ys = (np.arange(ny) * bs + bs * 0.5).reshape(ny, 1, 1).astype(np.float32)
      GLB.bs = bs
   GLB.build = build
   GLB.build(20)

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(8.0, 40.0)
   f1 = STR.F1mix(3.0, 26.0)
   f2 = STR.F2mix(0.0, 2.2)

   time = STR.IT() + STR.FT()

   if trig:
      GLB.seed()
      GLB.xmode = 1 if GLB.xmode==0 else 0

   bs = int(f0)
   if bs < 8:
      bs = 8
   if bs != GLB.bs:
      GLB.build(bs)

   n = int(f1)
   if n < 2:
      n = 2

   # --- move the sites and bounce them off the frame
   GLB.px[:n] = GLB.px[:n] + GLB.vx[:n] * f2
   GLB.py[:n] = GLB.py[:n] + GLB.vy[:n] * f2
   GLB.vx[:n] = np.where((GLB.px[:n] < 0) | (GLB.px[:n] > 1280), -GLB.vx[:n], GLB.vx[:n])
   GLB.vy[:n] = np.where((GLB.py[:n] < 0) | (GLB.py[:n] > 720), -GLB.vy[:n], GLB.vy[:n])
   GLB.px[:n] = np.clip(GLB.px[:n], 0, 1280)
   GLB.py[:n] = np.clip(GLB.py[:n], 0, 720)

   sx = GLB.px[:n].reshape(1, 1, n)
   sy = GLB.py[:n].reshape(1, 1, n)
   dx = GLB.xs - sx
   dy = GLB.ys - sy
   own = np.argmin(dx * dx + dy * dy, axis=2)

   cols = []
   for k in range(n):
      v = 1.0 if not GLB.xmode else 0.35 + 0.65 * ((k % 5) / 4.0)
      r,g,b = hsv_to_rgb((GLB.hu[k] + time * 0.02) % 1.0, 0.7, v)
      cols.append((b, g, r))

   bs1 = bs + 1
   for j in range(GLB.ny):
      row = own[j]
      y = j * bs
      # --- collapse each row into runs of the same owner
      start = 0
      cur = row[0]
      for k in range(1, GLB.nx):
         if row[k] != cur:
            c = cols[cur]
            cr.set_source_rgb(c[0], c[1], c[2])
            cr.rectangle(start * bs, y, (k - start) * bs + 1, bs1)
            cr.fill()
            start = k
            cur = row[k]
      c = cols[cur]
      cr.set_source_rgb(c[0], c[1], c[2])
      cr.rectangle(start * bs, y, (GLB.nx - start) * bs + 1, bs1)
      cr.fill()

   if acc:
      cr.set_source_rgb(1,1,1)
      cr.set_line_width(1.5)
      for k in range(n):
         cr.new_sub_path()
         cr.arc(GLB.px[k], GLB.py[k], 4, 0, 2 * pi)
      cr.stroke()
