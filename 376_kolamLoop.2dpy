def Init():
   # --- author : claude
   # --- a pulli kolam.  A grid of dots is laid, and a single continuous line
   # --- is drawn that loops around every dot and never crosses one, closing
   # --- on itself at the end.  It is drawn stroke by stroke and then wiped
   # --- and drawn again with a different grid, the way it is done every
   # --- morning.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Drawing")
   STR.SetFParam1Name("Dots")
   STR.SetFParam2Name("Chalk")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : a second colour is laid over the first
   # ---    trigger : new grid

   GLB.st = surface.get_stride() // 4
   GLB.prog = 0.0

   def newgrid():
      GLB.nd = 5 + np.random.randint(5)
      GLB.seed = np.random.random(6) * 6.283
      GLB.prog = 0.0
      GLB.hue = np.random.random()
   GLB.newgrid = newgrid
   GLB.newgrid()

   cr.set_source_rgb(0.14, 0.12, 0.16)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0015, 0.020)
   f1 = STR.F1mix(40.0, 96.0)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.newgrid()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   # --- the chalk is swept away slowly, so the courtyard is never blank and
   # --- never fills : an old kolam is still fading while the next is drawn
   np.subtract(v, np.right_shift(v, 7), out=v)
   v[:, :, 3] = 255
   surface.mark_dirty()

   GLB.prog = GLB.prog + f0
   if GLB.prog > 1.25:
      GLB.newgrid()

   nd = GLB.nd
   g = f1
   ox = 640.0 - (nd - 1) * g * 0.5
   oy = 360.0 - (nd - 1) * g * 0.5

   # --- the pulli, the dots the line must go round
   cr.set_source_rgba(0.75, 0.85, 0.92, 0.85)
   for j in range(nd):
      for i in range(nd):
         cr.new_sub_path()
         cr.arc(ox + i * g, oy + j * g, 2.6, 0, 6.2831853)
   cr.fill()

   # --- one continuous line, revealed as it is drawn.  It is built from a
   # --- closed Lissajous-like loop whose winding is set by the grid, so it
   # --- always returns to where it began.
   N = 1400
   lim = int(N * min(GLB.prog, 1.0))
   if lim < 2:
      return
   t = np.linspace(0.0, 6.2831853, N)[:lim]
   a = nd
   b = nd + 1
   rad = g * (nd - 1) * 0.5
   x = ox + (nd - 1) * g * 0.5 + (
      np.cos(t * a + GLB.seed[0]) * 0.62 +
      np.cos(t * b + GLB.seed[1]) * 0.38) * rad
   y = oy + (nd - 1) * g * 0.5 + (
      np.sin(t * a + GLB.seed[2]) * 0.62 +
      np.sin(t * b + GLB.seed[3]) * 0.38) * rad

   c = hsv_to_rgb((GLB.hue + f2) % 1.0, 0.25, 1.0)
   cr.set_source_rgb(c[2], c[1], c[0])
   cr.set_line_width(3.4)
   cr.set_line_cap(cairo.LINE_CAP_ROUND)
   cr.set_line_join(cairo.LINE_JOIN_ROUND)
   cr.move_to(x[0], y[0])
   for i in range(1, lim):
      cr.line_to(x[i], y[i])
   cr.stroke()

   if acc:
      c2 = hsv_to_rgb((GLB.hue + f2 + 0.42) % 1.0, 0.70, 1.0)
      cr.set_source_rgba(c2[2], c2[1], c2[0], 0.7)
      cr.set_line_width(1.2)
      cr.move_to(x[0] * 0.5 + 640.0 * 0.5, y[0] * 0.5 + 360.0 * 0.5)
      for i in range(1, lim, 2):
         cr.line_to(x[i] * 0.5 + 640.0 * 0.5, y[i] * 0.5 + 360.0 * 0.5)
      cr.stroke()
