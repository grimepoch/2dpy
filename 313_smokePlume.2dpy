def Init():
   # --- author : claude
   # --- smoke : density is advected along a curling velocity field, then
   # --- diffused and cooled.  Every frame's density is last frame's, moved.
   # --- note : screen y=0 is the BOTTOM, so smoke rises toward y=720
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Rise")
   STR.SetFParam1Name("Curl")
   STR.SetFParam2Name("Cool")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : two sources
   # ---    trigger : new wind

   GLB.res = 4
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   GLB.d = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   GLB.ph = np.random.random() * 6.28

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.2, 2.2)
   f1 = STR.F1mix(0.0, 9.0)
   f2 = STR.F2mix(0.980, 0.9995)

   time = STR.IT() + STR.FT()

   if trig:
      GLB.ph = np.random.random() * 6.28
      GLB.xmode = 1 if GLB.xmode==0 else 0

   d = GLB.d
   # --- inject at the base
   n = 2 if acc else 1
   for k in range(n):
      cx = int(GLB.nx * (0.5 + (k - (n - 1) * 0.5) * 0.32)
               + 22.0 * sin(time * 0.6 + k))
      d[2:6, cx-5:cx+5] = 1.0

   # --- advect upward in bands, each band pushed sideways by the curl
   nb = 36
   bh = GLB.ny // nb
   up = int(f0) + 1
   for b in range(nb):
      y0 = b * bh
      y1 = y0 + bh
      u = (y0 / (GLB.ny * 1.0))
      sx = int(f1 * sin(u * 7.0 + time * 1.3 + GLB.ph) * (0.3 + u))
      if y0 - up < 0:
         continue
      src = d[y0 - up:y1 - up]
      if sx > 0:
         d[y0:y1, sx:] = src[:, :-sx]
         d[y0:y1, :sx] = 0.0
      elif sx < 0:
         k2 = -sx
         d[y0:y1, :-k2] = src[:, k2:]
         d[y0:y1, -k2:] = 0.0
      else:
         d[y0:y1] = src

   # --- diffuse a little and cool
   d[1:-1,1:-1] = (d[1:-1,1:-1] * 0.6
                   + (d[:-2,1:-1] + d[2:,1:-1] + d[1:-1,:-2] + d[1:-1,2:]) * 0.1)
   np.multiply(d, f2, out=d)
   GLB.d = d

   bands = 22
   q = np.clip((d * bands).astype(np.int32), 0, bands - 1)
   pal = np.zeros((bands, 4), dtype=np.uint8)
   for bd in range(bands):
      t = bd / (bands - 1.0)
      if GLB.xmode:
         c = hsv_to_rgb((0.02 + t * 0.14) % 1.0, 1.0 - t * t, min(1.0, t * 2.2))
      else:
         g = t
         c = (g, g * 0.97, g * 0.94)
      pal[bd][0] = int(c[2] * 255)
      pal[bd][1] = int(c[1] * 255)
      pal[bd][2] = int(c[0] * 255)
      pal[bd][3] = 255

   GLB.sv[:, :GLB.nx] = pal[q]
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
