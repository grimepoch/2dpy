def Init():
   # --- author : claude
   # --- a glacier.  Ice deforms under its own weight, fastest in the middle
   # --- and at the surface, dragging at the walls - so the flowlines bow
   # --- downstream and the surface tears into crevasse fields wherever the
   # --- ice is being stretched. Snow keeps falling at the head and the
   # --- tongue keeps melting, so it flows without ever arriving.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Flow")
   STR.SetFParam1Name("Crevasses")
   STR.SetFParam2Name("Ablation")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : a surge
   # ---    trigger : new valley

   GLB.res = 3
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   yy, xx = np.meshgrid(np.arange(GLB.ny), np.arange(GLB.nx), indexing="ij")
   GLB.iy = yy.astype(np.float32)
   GLB.ix = xx.astype(np.float32)
   GLB.phase = np.zeros(GLB.ny, dtype=np.float32)

   def valley():
      GLB.wob = np.random.random(4) * 6.283
      GLB.dirt = np.random.random((GLB.ny, GLB.nx)).astype(np.float32)
      for k in range(2):
         GLB.dirt = (GLB.dirt + np.roll(GLB.dirt, 3, axis=1) +
                     np.roll(GLB.dirt, -3, axis=1)) / 3.0
   GLB.valley = valley
   GLB.valley()

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.05, 1.2)
   f1 = STR.F1mix(0.0, 1.0)
   f2 = STR.F2mix(0.0, 1.0)
   time = STR.IT() + STR.FT()

   if trig:
      GLB.valley()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   # --- the velocity profile across the valley : plug flow in the middle,
   # --- shear against both walls.  Every row moves at its own speed, which
   # --- is what bows the flowlines.
   u = (GLB.iy[:, 0] / (GLB.ny * 1.0)) * 2.0 - 1.0
   prof = np.clip(1.0 - np.abs(u) ** 3.6, 0.0, 1.0)
   speed = prof * f0 * (3.0 if acc else 1.0)
   GLB.phase = GLB.phase + speed

   # --- ogives and medial moraine, carried along by the flow
   ph = GLB.phase.reshape(GLB.ny, 1)
   band = 0.5 + 0.5 * np.sin((GLB.ix - ph) * 0.055 +
                             np.sin(GLB.iy * 0.03 + GLB.wob[0]) * 2.0)
   moraine = np.exp(-((GLB.iy - GLB.ny * 0.5) / (GLB.ny * 0.05)) ** 2)
   moraine = moraine * (0.5 + 0.5 * np.sin((GLB.ix - ph) * 0.02))

   # --- crevasses open where the ice is being stretched, which is where
   # --- the speed is increasing downstream
   stretch = np.abs(np.roll(prof, -1) - prof).reshape(GLB.ny, 1)
   shear = np.abs(u).reshape(GLB.ny, 1)
   crev = np.sin((GLB.ix - ph) * 0.30 + GLB.iy * 0.10) ** 2
   crev = crev * np.clip((shear - 0.35) * 2.2, 0.0, 1.0) * f1
   crev = crev * np.clip(1.0 - GLB.ix / (GLB.nx * 1.0) * 0.6, 0.0, 1.0)

   # --- the tongue melts out, exposing the dirt the ice has carried
   melt = np.clip((GLB.ix / (GLB.nx * 1.0) - (1.0 - f2)) * 3.0, 0.0, 1.0)
   ice = np.clip(0.55 + band * 0.35 - crev * 0.85, 0.0, 1.2)
   dirt = np.clip(moraine * 0.8 + melt * GLB.dirt * 0.9, 0.0, 1.0)

   red = ice * 195.0 * (1.0 - dirt) + dirt * 120.0
   grn = ice * 225.0 * (1.0 - dirt) + dirt * 100.0
   blu = ice * 250.0 * (1.0 - dirt) + dirt * 78.0
   # --- deep crevasses go blue-black
   red = red - crev * 120.0
   grn = grn - crev * 80.0
   GLB.sv[:, :GLB.nx, 0] = np.clip(red, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 1] = np.clip(grn, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 2] = np.clip(blu, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 3] = 255
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
