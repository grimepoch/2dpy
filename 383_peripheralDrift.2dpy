def Init():
   # --- author : claude
   # --- the peripheral drift illusion.  Repeated runs of black, dark,
   # --- white, light produce apparent motion in the direction of that
   # --- sequence - but only away from where you are looking, because it
   # --- depends on the different speeds at which light and dark are
   # --- processed. Nothing in the frame actually moves unless Drift is up.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Real Drift")
   STR.SetFParam1Name("Cell Size")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : reverse the luminance order, the drift reverses
   # ---    trigger : rings instead of a grid

   GLB.st = surface.get_stride() // 4
   GLB.rings = 0
   GLB.t = 0.0

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0, 0.5)
   f1 = STR.F1mix(34.0, 90.0)
   f2 = STR.F2()

   if trig:
      GLB.rings = 1 - GLB.rings
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   GLB.t = GLB.t + f0

   cr.set_source_rgb(0.48, 0.48, 0.50)
   cr.rectangle(0, 0, 1280, 720)
   cr.fill()

   g = f1
   # --- the four steps.  The ORDER is the whole illusion : black, dark,
   # --- white, light drifts one way, reversed it drifts the other.
   base = hsv_to_rgb(f2 % 1.0, 0.55, 1.0)
   seq = [[0.03, 0.03, 0.03],
          [base[2] * 0.45, base[1] * 0.45, base[0] * 0.45],
          [0.97, 0.97, 0.97],
          [base[2], base[1], base[0]]]
   if acc:
      seq = [seq[3], seq[2], seq[1], seq[0]]

   if GLB.rings:
      nr = int(400 / g) + 1
      for r in range(nr, 0, -1):
         rad = r * g
         nseg = max(6, int(6.2831853 * rad / g))
         for s in range(nseg):
            a0 = s * 6.2831853 / nseg + GLB.t * 0.02
            a1 = a0 + 6.2831853 / nseg
            for q in range(4):
               c = seq[q]
               cr.set_source_rgb(c[0], c[1], c[2])
               b0 = a0 + (a1 - a0) * (q / 4.0)
               b1 = a0 + (a1 - a0) * ((q + 1) / 4.0)
               cr.new_sub_path()
               cr.arc(640, 360, rad, b0, b1)
               cr.arc_negative(640, 360, rad - g * 0.82, b1, b0)
               cr.close_path()
               cr.fill()
   else:
      nx = int(1280 / g) + 2
      ny = int(720 / g) + 2
      for j in range(ny):
         for i in range(nx):
            x = i * g + (j % 2) * g * 0.5 + (GLB.t % g)
            y = j * g
            # --- each cell is the four steps side by side
            for q in range(4):
               c = seq[q]
               cr.set_source_rgb(c[0], c[1], c[2])
               cr.rectangle(x + q * g * 0.2, y, g * 0.2, g * 0.66)
               cr.fill()
