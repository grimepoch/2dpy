def Init():
   # --- author : claude
   # --- a drawing office blueprint : rooms, hatching, dimension lines with
   # --- proper arrow heads and witness lines, and a title block
   # --- note : screen y=0 is the BOTTOM, so text must be drawn y-flipped
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Reveal")
   STR.SetFParam1Name("Hatch")
   STR.SetFParam2Name("Tint")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : white paper print
   # ---    trigger : new plan

   def plan():
      GLB.rooms = []
      # --- split the floor plate recursively into rooms
      stack = [[160.0, 130.0, 830.0, 470.0, 0]]
      while len(stack) > 0 and len(GLB.rooms) < 11:
         r = stack.pop()
         w = r[2]
         h = r[3]
         if (w < 200 or h < 150) or r[4] > 3:
            GLB.rooms.append(r)
            continue
         if w > h:
            c = w * (0.35 + np.random.random() * 0.3)
            stack.append([r[0], r[1], c, h, r[4] + 1])
            stack.append([r[0] + c, r[1], w - c, h, r[4] + 1])
         else:
            c = h * (0.35 + np.random.random() * 0.3)
            stack.append([r[0], r[1], w, c, r[4] + 1])
            stack.append([r[0], r[1] + c, w, h - c, r[4] + 1])
      for r in stack:
         GLB.rooms.append(r)
   GLB.plan = plan
   GLB.plan()

   def text(x, y, s):
      cr.save()
      cr.translate(x, y)
      cr.scale(1.0, -1.0)
      cr.move_to(0, 0)
      cr.show_text(s)
      cr.restore()
   GLB.text = text

   def dim(x0, y0, x1, y1, off, label):
      # --- a dimension line with witness lines and arrow heads
      dx = x1 - x0
      dy = y1 - y0
      L = sqrt(dx * dx + dy * dy)
      if L < 1:
         return
      nx = -dy / L
      ny = dx / L
      ax = x0 + nx * off
      ay = y0 + ny * off
      bx = x1 + nx * off
      by = y1 + ny * off
      cr.move_to(x0, y0)
      cr.line_to(ax + nx * 8, ay + ny * 8)
      cr.move_to(x1, y1)
      cr.line_to(bx + nx * 8, by + ny * 8)
      cr.move_to(ax, ay)
      cr.line_to(bx, by)
      cr.stroke()
      ux = dx / L
      uy = dy / L
      for p in ((ax, ay, 1.0), (bx, by, -1.0)):
         cr.move_to(p[0], p[1])
         cr.line_to(p[0] + ux * 12 * p[2] + nx * 4, p[1] + uy * 12 * p[2] + ny * 4)
         cr.line_to(p[0] + ux * 12 * p[2] - nx * 4, p[1] + uy * 12 * p[2] - ny * 4)
         cr.close_path()
      cr.fill()
      e = cr.text_extents(label)
      GLB.text((ax + bx) * 0.5 - e.width * 0.5, (ay + by) * 0.5 + 7, label)
   GLB.dim = dim

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0()
   f1 = STR.F1mix(9.0, 34.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.plan()
      GLB.xmode = 1 if GLB.xmode==0 else 0

   if acc:
      paper = (0.96, 0.96, 0.95)
      ink = hsv_to_rgb(f2, 0.75, 0.35)
   else:
      paper = hsv_to_rgb((f2 + 0.58) % 1.0, 0.75, 0.30)
      ink = (0.92, 0.94, 1.0)

   cr.set_source_rgb(paper[2], paper[1], paper[0])
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cr.set_source_rgba(ink[2], ink[1], ink[0], 0.18)
   cr.set_line_width(1)
   k = 0
   while k < 1280:
      cr.move_to(k, 0)
      cr.line_to(k, 720)
      k = k + 40
   k = 0
   while k < 720:
      cr.move_to(0, k)
      cr.line_to(1280, k)
      k = k + 40
   cr.stroke()

   cr.set_source_rgb(ink[2], ink[1], ink[0])
   cr.select_font_face("mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
   cr.set_font_size(17)

   # --- rooms appear one at a time
   shown = f0 * len(GLB.rooms) + 0.001
   cr.set_line_width(2.5)
   for i in range(len(GLB.rooms)):
      if i > shown:
         break
      r = GLB.rooms[i]
      cr.rectangle(r[0], r[1], r[2], r[3])
   cr.stroke()

   # --- hatch the room that is currently being drawn
   idx = int(shown) % len(GLB.rooms)
   r = GLB.rooms[idx]
   cr.save()
   cr.rectangle(r[0], r[1], r[2], r[3])
   cr.clip()
   cr.set_source_rgba(ink[2], ink[1], ink[0], 0.45)
   cr.set_line_width(1.4)
   sp = f1
   x = r[0] - r[3]
   while x < r[0] + r[2]:
      cr.move_to(x, r[1])
      cr.line_to(x + r[3], r[1] + r[3])
      x = x + sp
   cr.stroke()
   cr.restore()

   cr.set_source_rgb(ink[2], ink[1], ink[0])
   cr.set_line_width(1.4)
   GLB.dim(r[0], r[1], r[0] + r[2], r[1], -34.0, "%d" % int(r[2]))
   GLB.dim(r[0], r[1] + r[3], r[0], r[1], -34.0, "%d" % int(r[3]))

   for i in range(len(GLB.rooms)):
      if i > shown:
         break
      rr = GLB.rooms[i]
      s = "R%02d" % (i + 1)
      e = cr.text_extents(s)
      GLB.text(rr[0] + rr[2] * 0.5 - e.width * 0.5, rr[1] + rr[3] * 0.5, s)

   # --- title block
   cr.set_line_width(2)
   cr.rectangle(1010, 60, 210, 150)
   cr.stroke()
   cr.move_to(1010, 160)
   cr.line_to(1220, 160)
   cr.move_to(1010, 115)
   cr.line_to(1220, 115)
   cr.stroke()
   cr.set_font_size(15)
   GLB.text(1020, 180, "FLOOR PLAN")
   GLB.text(1020, 135, "SCALE 1:50")
   GLB.text(1020, 90, "SHEET %02d" % (int(time * 0.2) % 40 + 1))
