def Init():
   # --- author : claude
   # --- hexDump crossed with concrete poetry : the bytes on the right are
   # --- real text, and the hex on the left is what that text actually is
   # --- note : screen y=0 is the BOTTOM, so text must be drawn y-flipped
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Churn")
   STR.SetFParam1Name("Text Size")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : highlight the printable run
   # ---    trigger : new passage

   GLB.pass1 = ("THE MACHINE REMEMBERS EVERY FRAME IT HAS EVER DRAWN "
                "AND FORGETS THEM ALL AT THE SAME RATE ")
   GLB.pass2 = ("NOTHING IN THIS BUFFER IS PERMANENT NOT EVEN THE BUFFER "
                "EVERY PIXEL IS ON LOAN FROM THE NEXT ONE ")
   GLB.rows = 20

   def load(t):
      GLB.b = []
      for j in range(GLB.rows):
         row = []
         for i in range(16):
            k = j * 16 + i
            row.append(ord(t[k % len(t)]))
         GLB.b.append(row)
      GLB.hot = np.zeros((GLB.rows, 16))
   GLB.load = load
   GLB.load(GLB.pass1)
   GLB.which = 0

   def text(x, y, s):
      cr.save()
      cr.translate(x, y)
      cr.scale(1.0, -1.0)
      cr.move_to(0, 0)
      cr.show_text(s)
      cr.restore()
   GLB.text = text

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0, 14.0)
   f1 = STR.F1mix(13.0, 26.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.which = 1 - GLB.which
      GLB.load(GLB.pass2 if GLB.which else GLB.pass1)
      GLB.xmode = 1 if GLB.xmode==0 else 0

   # --- corrupt a few bytes, which corrupts the poem too
   for i in range(int(f0)):
      r = np.random.randint(0, GLB.rows)
      c = np.random.randint(0, 16)
      GLB.b[r][c] = np.random.randint(32, 127)
      GLB.hot[r][c] = 1.0
   GLB.hot = GLB.hot * 0.92

   cr.set_source_rgb(0.02, 0.02, 0.03)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cr.select_font_face("mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
   size = f1
   cr.set_font_size(size)
   adv = cr.text_extents("0").x_advance
   lh = size * 1.5

   base = hsv_to_rgb(f2, 0.55 if GLB.xmode else 0.8, 1.0)
   dim = hsv_to_rgb(f2, 0.3, 0.5)

   x0 = 50.0
   xh = x0 + adv * 10.0
   xa = xh + adv * 50.0

   for r in range(GLB.rows):
      y = 690.0 - (r + 1) * lh
      if y < -lh:
         break
      cr.set_source_rgb(dim[2], dim[1], dim[0])
      GLB.text(x0, y, "%08X" % (0x1000 + r * 16))
      asc = ""
      for c in range(16):
         v = GLB.b[r][c]
         h = GLB.hot[r][c]
         if h > 0.02:
            cr.set_source_rgb(1, 1, 1)
         else:
            cr.set_source_rgb(base[2], base[1], base[0])
         gx = xh + c * adv * 3.0 + (adv * 1.2 if c >= 8 else 0.0)
         GLB.text(gx, y, "%02X" % v)
         asc = asc + (chr(v) if v >= 32 and v < 127 else ".")
      if acc:
         cr.set_source_rgba(base[2], base[1], base[0], 0.18)
         cr.rectangle(xa - 4, y - size * 0.22, adv * 17, size * 1.15)
         cr.fill()
      c2 = hsv_to_rgb((f2 + 0.45) % 1.0, 0.6, 1.0)
      cr.set_source_rgb(c2[2], c2[1], c2[0])
      GLB.text(xa, y, asc)
