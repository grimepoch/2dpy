def Init():
   # --- author : claude
   # --- gold leaf being laid and burnished.  Leaf goes onto bole in
   # --- overlapping squares, and burnishing only ever adds shine - so the
   # --- ground fills in unevenly and the joins between leaves stay visible
   # --- in the raking light, which is how you can tell real gilding.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Laying")
   STR.SetFParam1Name("Burnish")
   STR.SetFParam2Name("Light")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : tool the halo
   # ---    trigger : new panel

   GLB.res = 3
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   yy, xx = np.meshgrid(np.arange(GLB.ny), np.arange(GLB.nx), indexing="ij")
   GLB.iy = yy.astype(np.float32)
   GLB.ix = xx.astype(np.float32)

   def panel():
      GLB.leaf = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
      GLB.bur = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
      GLB.tool = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   GLB.panel = panel
   GLB.panel()

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.02, 0.55)
   f1 = STR.F1mix(0.0, 0.06)
   f2 = STR.F2mix(0.0, 6.283)
   time = STR.IT() + STR.FT()

   if trig:
      GLB.panel()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   leaf = GLB.leaf
   bur = GLB.bur
   tool = GLB.tool

   # --- a leaf is laid : a square of gold, slightly askew, never removed
   if np.random.random() < f0:
      s = 26 + np.random.randint(22)
      px = np.random.randint(0, GLB.nx - s)
      py = np.random.randint(0, GLB.ny - s)
      leaf[py:py+s, px:px+s] = np.maximum(leaf[py:py+s, px:px+s],
                                          0.75 + np.random.random() * 0.25)

   # --- burnishing : the agate goes over an area and raises the shine there
   if f1 > 0.002:
      bx = (sin(time * 0.9) * 0.5 + 0.5) * GLB.nx
      by = (cos(time * 0.61) * 0.5 + 0.5) * GLB.ny
      d = (GLB.ix - bx) ** 2 + (GLB.iy - by) ** 2
      np.add(bur, np.exp(-d / 900.0) * f1 * leaf, out=bur)
      np.clip(bur, 0.0, 1.0, out=bur)
   GLB.bur = bur

   if acc:
      # --- punched decoration, struck into the gold around a halo
      a = np.random.random() * 6.2831853
      rr = GLB.ny * 0.30
      px = int(GLB.nx * 0.5 + cos(a) * rr)
      py = int(GLB.ny * 0.5 + sin(a) * rr)
      if 2 < px < GLB.nx - 3 and 2 < py < GLB.ny - 3:
         tool[py-2:py+3, px-2:px+3] = 1.0
   GLB.tool = tool

   # --- raking light : gold is only gold because of the angle it is lit at
   lx = cos(f2)
   ly = sin(f2)
   gx = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   gy = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   surf = leaf * 0.35 + bur * 0.5 - tool * 0.8
   gx[:, 1:] = surf[:, 1:] - surf[:, :-1]
   gy[1:] = surf[1:] - surf[:-1]
   spec = np.clip(0.45 + (gx * lx + gy * ly) * 9.0, 0.0, 1.0)
   shine = np.clip(leaf * (0.35 + bur * 0.85) + spec * spec * 0.85, 0.0, 1.3)
   # --- red bole shows wherever the leaf has not covered
   bole = 1.0 - leaf
   red = shine * 252.0 + bole * 96.0
   grn = shine * 196.0 + bole * 34.0
   blu = shine * 64.0 + bole * 26.0
   GLB.sv[:, :GLB.nx, 0] = np.clip(red, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 1] = np.clip(grn, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 2] = np.clip(blu, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 3] = 255
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
