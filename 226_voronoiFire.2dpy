def Init():
   # --- author : claude
   # --- voronoiDrift crossed with doomFire : each cell carries a heat that
   # --- spreads to its neighbours, so the mosaic burns
   # --- note : screen y=0 is the BOTTOM, so heat rises
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Resolution")
   STR.SetFParam1Name("Sites")
   STR.SetFParam2Name("Cooling")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : cells outlined in black
   # ---    trigger : reseed

   GLB.nmax = 42
   GLB.bs = 0

   def seed():
      GLB.px = np.random.random(GLB.nmax) * 1280.0
      GLB.py = np.random.random(GLB.nmax) * 720.0
      GLB.vx = (np.random.random(GLB.nmax) - 0.5) * 2.5
      GLB.vy = (np.random.random(GLB.nmax) - 0.5) * 2.5
      GLB.heat = np.zeros(GLB.nmax)
   GLB.seed = seed
   GLB.seed()

   def build(bs):
      nx = int(1280 / bs) + 1
      ny = int(720 / bs) + 1
      GLB.nx = nx
      GLB.ny = ny
      GLB.xs = (np.arange(nx) * bs + bs * 0.5).reshape(1, nx, 1).astype(np.float32)
      GLB.ys = (np.arange(ny) * bs + bs * 0.5).reshape(ny, 1, 1).astype(np.float32)
      GLB.bs = bs
   GLB.build = build
   GLB.build(16)

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(10.0, 30.0)
   f1 = STR.F1mix(6.0, 42.0)
   f2 = STR.F2mix(0.86, 0.995)

   time = STR.IT() + STR.FT()

   if trig:
      GLB.seed()
      GLB.xmode = 1 if GLB.xmode==0 else 0

   bs = int(f0)
   if bs != GLB.bs:
      GLB.build(bs)
   n = int(f1)

   GLB.px[:n] = np.mod(GLB.px[:n] + GLB.vx[:n], 1280.0)
   GLB.py[:n] = np.mod(GLB.py[:n] + GLB.vy[:n], 720.0)

   # --- cells near the floor are stoked; heat then rises cell to cell
   GLB.heat[:n] = GLB.heat[:n] * f2
   low = GLB.py[:n] < 120.0
   GLB.heat[:n] = np.where(low, 1.0, GLB.heat[:n])
   for k in range(n):
      if GLB.heat[k] > 0.02:
         continue
      # --- take heat from the nearest cell below
      dy = GLB.py[:n] - GLB.py[k]
      dx = np.abs(GLB.px[:n] - GLB.px[k])
      ok = (dy < 0) & (dy > -260.0) & (dx < 220.0)
      if ok.any():
         GLB.heat[k] = float(np.max(np.where(ok, GLB.heat[:n], 0.0))) * 0.93

   sx = GLB.px[:n].reshape(1, 1, n)
   sy = GLB.py[:n].reshape(1, 1, n)
   dx = GLB.xs - sx
   dy = GLB.ys - sy
   own = np.argmin(dx * dx + dy * dy, axis=2)

   cr.set_source_rgb(0, 0, 0)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cols = []
   hl = GLB.heat[:n].tolist()
   for k in range(n):
      t = hl[k]
      if t < 0.01:
         cols.append((0.02, 0.02, 0.03))
      else:
         r,g,b = hsv_to_rgb((0.02 + t * 0.14) % 1.0, 1.0 - t * t * 0.9,
                            min(1.0, t * 2.0))
         cols.append((b, g, r))

   res = bs
   for j in range(GLB.ny):
      row = own[j]
      y = j * res
      cuts = (np.nonzero(np.diff(row))[0] + 1).tolist()
      starts = [0] + cuts
      ends = cuts + [GLB.nx]
      vals = row[starts].tolist()
      for k in range(len(starts)):
         c = cols[vals[k]]
         cr.set_source_rgb(c[0], c[1], c[2])
         cr.rectangle(starts[k] * res, y, (ends[k] - starts[k]) * res + 1, res + 1)
         cr.fill()

   if acc:
      cr.set_source_rgba(0, 0, 0, 0.8)
      cr.set_line_width(1.6)
      for j in range(GLB.ny):
         row = own[j]
         cuts = (np.nonzero(np.diff(row))[0] + 1).tolist()
         y = j * res
         for c in cuts:
            cr.move_to(c * res, y)
            cr.line_to(c * res, y + res)
      cr.stroke()
