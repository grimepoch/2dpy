def Init():
   # --- author : claude
   # --- rhodonea curves, one per slot.  The petal count is the slot index,
   # --- so the whole set draws a family of roses that never collide.
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Decay")
   STR.SetFParam1Name("Size")
   STR.SetFParam2Name("Hue")
   # ---    accent : fill the petals
   # ---    trigger : stacked <-> nested

   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"

   GLB.n = 12 if GLB.slots == 24 else GLB.slots
   GLB.lvl = []
   for i in range(GLB.n):
      GLB.lvl.append(0.0)
   GLB.steps = 150
   GLB.th = np.linspace(0.0, 2.0 * pi, GLB.steps)

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.80, 0.985)
   f1 = STR.F1mix(80.0, 330.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0

   n = GLB.n
   for k in range(n):
      GLB.lvl[k] = GLB.lvl[k] * f0

   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      if ids == 0:
         continue
      k = (note % 12) if GLB.mode == "midi" else i
      if k < n:
         v = velo / 127.0
         if v > GLB.lvl[k]:
            GLB.lvl[k] = v

   cr.set_source_rgb(0.02, 0.02, 0.04)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   th = GLB.th
   cols = 4 if GLB.xmode else 1
   rows = int((n + cols - 1) / cols)

   for k in range(n):
      v = GLB.lvl[k]
      if v < 0.02:
         continue
      # --- k petals if k is odd, 2k if even: the rhodonea rule
      petals = k + 2
      rr = np.cos(petals * th + time * 0.4)
      if GLB.xmode:
         cx = (k % cols + 0.5) * 1280.0 / cols
         cy = 720.0 - (int(k / cols) + 0.5) * 720.0 / rows
         amp = f1 * 0.34 * v
      else:
         cx = 640.0
         cy = 360.0
         amp = f1 * (0.30 + 0.70 * (k + 1) / n) * v
      xs = (cx + np.cos(th) * rr * amp).tolist()
      ys = (cy + np.sin(th) * rr * amp).tolist()

      r,g,b = hsv_to_rgb((f2 + k / (n * 1.0) * 0.6) % 1.0, 0.85, 0.35 + 0.65 * v)
      cr.move_to(xs[0], ys[0])
      for i in range(1, GLB.steps):
         cr.line_to(xs[i], ys[i])
      cr.close_path()
      if acc:
         # --- one opaque pass: an alpha fill plus a stroke over ten large
         # --- overlapping roses was doing twice the compositing it needed
         cr.set_source_rgb(b * 0.42, g * 0.42, r * 0.42)
         cr.fill()
      else:
         cr.set_source_rgb(b, g, r)
         cr.set_line_width(1.5 + 3.0 * v)
         cr.stroke()
