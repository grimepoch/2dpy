def Init():
   # --- author : claude
   # --- an engraved botanical plate : stem, alternating leaves with venation,
   # --- and a flower head, with the plate's caption underneath.
   # --- Public domain scientific illustration tradition.
   # --- note : screen y=0 is the BOTTOM, so the plant grows UP
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Growth")
   STR.SetFParam1Name("Leaves")
   STR.SetFParam2Name("Bloom")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : hand coloured
   # ---    trigger : new specimen

   GLB.gen = ["ACANTHUS","DIGITALIS","VERONICA","ASTRANTIA","LUPINUS",
              "ECHIUM","SILPHIUM","CAMPANULA"]
   GLB.sp = ["MAJOR","PURPUREA","SPICATA","MINOR","ALBUS","VULGARE"]

   def newplant():
      GLB.g = GLB.gen[np.random.randint(0, len(GLB.gen))]
      GLB.s = GLB.sp[np.random.randint(0, len(GLB.sp))]
      GLB.no = np.random.randint(1, 140)
      GLB.lean = (np.random.random() - 0.5) * 0.5
      GLB.petals = np.random.randint(5, 10)
   GLB.newplant = newplant
   GLB.newplant()

   def leaf(L, W, vein, c, ink):
      # --- one leaf blade with a midrib and side veins
      cr.move_to(0, 0)
      cr.curve_to(L * 0.3, W, L * 0.7, W, L, 0)
      cr.curve_to(L * 0.7, -W, L * 0.3, -W, 0, 0)
      cr.close_path()
      cr.set_source_rgb(c[2], c[1], c[0])
      cr.fill()
      cr.set_source_rgba(ink[2], ink[1], ink[0], 0.8)
      cr.set_line_width(1.4)
      cr.move_to(0, 0)
      cr.line_to(L, 0)
      for i in range(1, vein + 1):
         u = i / (vein + 1.0)
         for s in (-1.0, 1.0):
            cr.move_to(L * u, 0)
            cr.curve_to(L * (u + 0.10), W * 0.5 * s * (1.0 - u),
                        L * (u + 0.16), W * 0.8 * s * (1.0 - u),
                        L * (u + 0.20), W * 0.85 * s * (1.0 - u))
      cr.stroke()
   GLB.leaf = leaf

   def text(x, y, s):
      cr.save()
      cr.translate(x, y)
      cr.scale(1.0, -1.0)
      cr.move_to(0, 0)
      cr.show_text(s)
      cr.restore()
   GLB.text = text

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0()
   f1 = STR.F1mix(3.0, 11.0)
   f2 = STR.F2mix(0.0, 1.0)

   time = STR.IT() + STR.FT()

   if trig:
      GLB.newplant()
      GLB.xmode = 1 if GLB.xmode==0 else 0

   paper = (0.94, 0.93, 0.88)
   ink = (0.14, 0.13, 0.16)
   cr.set_source_rgb(paper[2], paper[1], paper[0])
   cr.rectangle(0,0,1280,720)
   cr.fill()

   grow = 0.15 + 0.85 * f0
   H = 470.0 * grow
   nl = int(f1)
   sway = sin(time * 0.5) * 0.05

   cr.save()
   cr.translate(640, 110)

   # --- the stem
   cr.set_source_rgb(ink[2], ink[1], ink[0])
   cr.set_line_width(6)
   cr.move_to(0, 0)
   steps = 22
   for i in range(1, steps + 1):
      u = i / (steps * 1.0)
      cr.line_to(sin(u * 2.2 + sway) * H * GLB.lean * 0.5, u * H)
   cr.stroke()

   if acc:
      lc = hsv_to_rgb(0.30, 0.55, 0.75)
      fc = hsv_to_rgb((0.85 + f2 * 0.2) % 1.0, 0.6, 0.95)
   else:
      lc = (0.86, 0.87, 0.82)
      fc = (0.90, 0.90, 0.86)

   # --- leaves alternating up the stem
   for k in range(nl):
      u = 0.12 + 0.72 * k / (nl * 1.0)
      x = sin(u * 2.2 + sway) * H * GLB.lean * 0.5
      y = u * H
      s = 1.0 if k % 2 == 0 else -1.0
      L = 150.0 * (1.0 - u * 0.55) * grow
      cr.save()
      cr.translate(x, y)
      cr.rotate(s * (0.55 + 0.25 * sin(time * 0.6 + k)))
      cr.scale(s, 1.0)
      GLB.leaf(L, L * 0.34, 4, lc, ink)
      cr.restore()

   # --- the flower head at the top
   tx = sin(2.2 + sway) * H * GLB.lean * 0.5
   ty = H
   for p in range(GLB.petals):
      a = p * 2.0 * pi / GLB.petals + time * 0.06
      cr.save()
      cr.translate(tx, ty)
      cr.rotate(a)
      GLB.leaf(56.0 * grow, 22.0 * grow, 2, fc, ink)
      cr.restore()
   cr.set_source_rgb(ink[2], ink[1], ink[0])
   cr.new_sub_path()
   cr.arc(tx, ty, 13.0 * grow, 0, 2 * pi)
   cr.fill()

   cr.restore()

   # --- the plate caption
   cr.set_source_rgb(ink[2], ink[1], ink[0])
   cr.select_font_face("serif", cairo.FONT_SLANT_ITALIC, cairo.FONT_WEIGHT_NORMAL)
   cr.set_font_size(34)
   s = GLB.g + " " + GLB.s
   e = cr.text_extents(s)
   GLB.text(640 - e.width * 0.5 - e.x_bearing, 62, s)
   cr.select_font_face("serif", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
   cr.set_font_size(20)
   s2 = "PL. %d" % GLB.no
   e = cr.text_extents(s2)
   GLB.text(640 - e.width * 0.5, 28, s2)
