def Init():
   # --- author : claude
   # --- paper marbling.  Dropping ink at C pushes every existing point
   # --- radially outward by sqrt(1 + r^2/d^2) - the exact area preserving
   # --- map a real drop performs - and the rake then combs the whole bath.
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Rake")
   STR.SetFParam1Name("Drop Size")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : comb the other way
   # ---    trigger : fresh bath

   GLB.pts = 78
   GLB.maxd = 22
   GLB.th = np.linspace(0.0, 2.0 * pi, GLB.pts)

   def fresh():
      GLB.drops = []
   GLB.fresh = fresh
   GLB.fresh()

   def drop(cx, cy, r, hue):
      # --- push every existing point out of the way of the new disc
      for d in GLB.drops:
         dx = d[0] - cx
         dy = d[1] - cy
         d2 = dx * dx + dy * dy
         d2 = np.where(d2 < 1.0, 1.0, d2)
         k = np.sqrt(1.0 + (r * r) / d2)
         d[0] = cx + dx * k
         d[1] = cy + dy * k
      GLB.drops.append([cx + np.cos(GLB.th) * r, cy + np.sin(GLB.th) * r, hue])
      while len(GLB.drops) > GLB.maxd:
         del GLB.drops[0]
   GLB.drop = drop
   GLB.lastbeat = -1

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0, 26.0)
   f1 = STR.F1mix(40.0, 150.0)
   f2 = STR.F2()

   itime = STR.IT()
   time  = itime + STR.FT()

   if trig:
      GLB.fresh()
      GLB.xmode = 1 if GLB.xmode==0 else 0

   if itime != GLB.lastbeat:
      GLB.lastbeat = itime
      GLB.drop(180.0 + np.random.random() * 920.0,
               120.0 + np.random.random() * 480.0,
               f1 * (0.5 + np.random.random()), np.random.random())

   # --- the rake: a travelling sine displacement across the bath
   amp = f0
   if amp > 0.05:
      ph = time * 1.1
      for d in GLB.drops:
         if acc:
            d[0] = d[0] + amp * 0.10 * np.sin(d[1] * 0.02 + ph)
         else:
            d[1] = d[1] + amp * 0.10 * np.sin(d[0] * 0.015 + ph)

   cr.set_source_rgb(0.94, 0.93, 0.89)
   if GLB.xmode:
      cr.set_source_rgb(0.05, 0.04, 0.06)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   for d in GLB.drops:
      xs = d[0].tolist()
      ys = d[1].tolist()
      r,g,b = hsv_to_rgb((d[2] * 0.75 + f2) % 1.0, 0.8, 0.95)
      cr.set_source_rgb(b, g, r)
      cr.move_to(xs[0], ys[0])
      for i in range(1, GLB.pts):
         cr.line_to(xs[i], ys[i])
      cr.close_path()
      cr.fill()
      cr.set_source_rgba(0, 0, 0, 0.35)
      cr.set_line_width(1.2)
      cr.move_to(xs[0], ys[0])
      for i in range(1, GLB.pts):
         cr.line_to(xs[i], ys[i])
      cr.close_path()
      cr.stroke()
