def Init():
   # --- author : claude
   # --- gravitational lensing.  A mass sits in front of a field of distant
   # --- galaxies and bends their light round itself, so what you see is the
   # --- background sampled through a deflection - arcs, and a full Einstein
   # --- ring whenever a source passes exactly behind.  The field drifts, so
   # --- sources are always entering and leaving alignment.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Mass")
   STR.SetFParam1Name("Drift")
   STR.SetFParam2Name("Field")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : a second mass enters the frame
   # ---    trigger : new background field

   GLB.res = 4
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   yy, xx = np.meshgrid(np.arange(GLB.ny), np.arange(GLB.nx), indexing="ij")
   GLB.iy = yy.astype(np.float32)
   GLB.ix = xx.astype(np.float32)
   GLB.pan = 0.0

   def field():
      k = 22
      GLB.gx = np.random.random(k) * GLB.nx * 2.4 - GLB.nx * 0.7
      GLB.gy = np.random.random(k) * GLB.ny * 1.6 - GLB.ny * 0.3
      GLB.gr = np.random.random(k) * 13.0 + 6.0
      GLB.gh = np.random.random(k)
      GLB.gb = np.random.random(k) * 0.7 + 0.6
   GLB.field = field
   GLB.field()

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(200.0, 2600.0)
   f1 = STR.F1mix(0.0, 0.55)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.field()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   GLB.pan = GLB.pan + f1

   # --- deflection : a ray passing at radius r is bent by an angle that
   # --- falls off as 1/r, so the apparent position is pulled outward from
   # --- the lens by the Einstein radius squared over r
   lx = GLB.nx * 0.5
   ly = GLB.ny * 0.5
   dx = GLB.ix - lx
   dy = GLB.iy - ly
   r2 = dx * dx + dy * dy + 4.0
   bend = f0 / r2
   sx = GLB.ix - dx * bend
   sy = GLB.iy - dy * bend
   if acc:
      l2x = GLB.nx * (0.5 + 0.26 * sin(time * 0.4))
      l2y = GLB.ny * (0.5 + 0.26 * cos(time * 0.33))
      d2x = GLB.ix - l2x
      d2y = GLB.iy - l2y
      q2 = d2x * d2x + d2y * d2y + 4.0
      b2 = f0 * 0.55 / q2
      sx = sx - d2x * b2
      sy = sy - d2y * b2

   # --- the background, sampled at the deflected position
   out = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   hue = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   for i in range(len(GLB.gx)):
      px = np.mod(GLB.gx[i] + GLB.pan, GLB.nx * 2.4) - GLB.nx * 0.7
      ddx = sx - px
      ddy = sy - GLB.gy[i]
      # --- a reciprocal falloff rather than an exponential : np.exp over
      # --- the whole grid, once per source, was most of the frame
      d = (ddx * ddx + ddy * ddy) / (GLB.gr[i] * GLB.gr[i])
      g = GLB.gb[i] / (1.0 + d * d)
      hue = np.where(g > out, GLB.gh[i], hue)
      out = np.maximum(out, g)

   lum = np.clip(out * 2.4, 0.0, 1.0)
   h6 = np.mod((hue + f2) * 6.0, 6.0)
   rr = np.clip(np.abs(h6 - 3.0) - 1.0, 0.0, 1.0)
   gg = np.clip(2.0 - np.abs(h6 - 2.0), 0.0, 1.0)
   bb = np.clip(2.0 - np.abs(h6 - 4.0), 0.0, 1.0)
   sat = 0.45
   GLB.sv[:, :GLB.nx, 0] = np.clip(
      ((1.0 - sat) + sat * rr) * lum * 255.0, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 1] = np.clip(
      ((1.0 - sat) + sat * gg) * lum * 255.0, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 2] = np.clip(
      ((1.0 - sat) + sat * bb) * lum * 255.0, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 3] = 255
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
