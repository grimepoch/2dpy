def Init():
   # --- author : claude
   # --- juliaMorph rendered through glyphField's ramp : escape time becomes
   # --- a character, so the fractal is printed rather than plotted
   # --- note : screen y=0 is the BOTTOM, so text must be drawn y-flipped
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Zoom")
   STR.SetFParam1Name("Detail")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : monochrome listing
   # ---    trigger : jump the seed

   GLB.ramp = " .,:;i1tfLCG08@"
   GLB.cw = 16
   GLB.chh = 20
   GLB.nx = int(1280 / GLB.cw) + 1
   GLB.ny = int(720 / GLB.chh) + 1
   xs = np.linspace(-1.6, 1.6, GLB.nx)
   ys = np.linspace(-0.9, 0.9, GLB.ny)
   GLB.X = np.tile(xs.reshape(1, GLB.nx), (GLB.ny, 1)).astype(np.float32)
   GLB.Y = np.tile(ys.reshape(GLB.ny, 1), (1, GLB.nx)).astype(np.float32)
   GLB.jx = 0.0
   GLB.jy = 0.0

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.6, 2.2)
   f1 = STR.F1mix(6.0, 22.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.jx = (np.random.random() - 0.5) * 1.0
      GLB.jy = (np.random.random() - 0.5) * 1.0
      GLB.xmode = 1 if GLB.xmode==0 else 0

   a = time * 0.11
   cx = 0.7885 * cos(a) + GLB.jx * 0.3
   cy = 0.7885 * sin(a) + GLB.jy * 0.3

   zx = GLB.X * f0
   zy = GLB.Y * f0
   it = np.zeros(zx.shape, dtype=np.int32)
   maxi = int(f1)
   alive = np.ones(zx.shape, dtype=bool)
   for i in range(maxi):
      zx2 = zx * zx
      zy2 = zy * zy
      alive = alive & ((zx2 + zy2) < 4.0)
      if not alive.any():
         break
      nzx = zx2 - zy2 + cx
      nzy = 2.0 * zx * zy + cy
      zx = np.where(alive, nzx, zx)
      zy = np.where(alive, nzy, zy)
      it = it + alive

   nr = len(GLB.ramp)
   q = np.clip((it * nr) // (maxi + 1), 0, nr - 1)

   cr.set_source_rgb(0, 0, 0)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cr.select_font_face("mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
   cr.set_font_size(GLB.cw * 1.15)

   pal = []
   for v in range(nr):
      t = v / (nr - 1.0)
      if acc:
         pal.append((t, t, t))
      else:
         r,g,b = hsv_to_rgb((f2 + t * 0.55) % 1.0, 0.85 - 0.5 * t, 0.25 + 0.75 * t)
         pal.append((b, g, r))

   cr.save()
   cr.scale(1.0, -1.0)
   last = -1
   for j in range(GLB.ny):
      row = q[j]
      yy = -(j * GLB.chh)
      cuts = (np.nonzero(np.diff(row))[0] + 1).tolist()
      starts = [0] + cuts
      ends = cuts + [GLB.nx]
      vals = row[starts].tolist()
      for k in range(len(starts)):
         v = vals[k]
         if v == 0:
            continue
         if v != last:
            c = pal[v]
            cr.set_source_rgb(c[0], c[1], c[2])
            last = v
         cr.move_to(starts[k] * GLB.cw, yy)
         cr.show_text(GLB.ramp[v] * (ends[k] - starts[k]))
   cr.restore()
