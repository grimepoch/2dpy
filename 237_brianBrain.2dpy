def Init():
   # --- author : claude
   # --- Brian's Brain : three states, on / dying / off.  A cell only fires if
   # --- exactly two neighbours fired last step, which sends waves across the
   # --- grid instead of settling into stills.
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Cell Size")
   STR.SetFParam1Name("Seed Rate")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : leave a fading wake
   # ---    trigger : reseed

   GLB.cs = 0

   def build(cs):
      GLB.cs = cs
      GLB.nx = 1280 // cs
      GLB.ny = 720 // cs
      GLB.g = (np.random.random((GLB.ny, GLB.nx)) < 0.14).astype(np.int32) * 2
      GLB.wake = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
      GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
      GLB.sst = GLB.small.get_stride() // 4
      GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                          buffer=GLB.small.get_data())
   GLB.build = build
   GLB.build(5)

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(4.0, 12.0)
   f1 = STR.F1mix(0.0, 0.006)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   cs = int(f0)
   if trig or cs != GLB.cs:
      GLB.build(cs)
      if trig:
         GLB.xmode = 1 if GLB.xmode==0 else 0

   g = GLB.g
   on = (g == 2).astype(np.int32)
   n = (np.roll(on,1,0) + np.roll(on,-1,0) + np.roll(on,1,1) + np.roll(on,-1,1)
        + np.roll(np.roll(on,1,0),1,1) + np.roll(np.roll(on,1,0),-1,1)
        + np.roll(np.roll(on,-1,0),1,1) + np.roll(np.roll(on,-1,0),-1,1))
   nxt = np.where(g == 2, 1, np.where(g == 1, 0, np.where(n == 2, 2, 0)))
   if f1 > 0.0002:
      nxt = np.where(np.random.random(g.shape) < f1, 2, nxt)
   GLB.g = nxt
   GLB.wake = np.maximum(GLB.wake * (0.90 if acc else 0.6), (nxt == 2) * 1.0)

   pal = np.zeros((3, 4), dtype=np.uint8)
   cols = [(0.02, 0.02, 0.04),
           hsv_to_rgb((f2 + 0.5) % 1.0, 0.85, 0.55),
           hsv_to_rgb(f2, 0.25, 1.0)]
   for i in range(3):
      pal[i][0] = int(cols[i][2] * 255)
      pal[i][1] = int(cols[i][1] * 255)
      pal[i][2] = int(cols[i][0] * 255)
      pal[i][3] = 255

   img = pal[GLB.g]
   if GLB.xmode or acc:
      w = np.clip(GLB.wake * 150.0, 0, 150).astype(np.uint8)
      img[:, :, 0] = np.maximum(img[:, :, 0], w)
   GLB.sv[:, :GLB.nx] = img
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / cs, 1.0 / cs)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
