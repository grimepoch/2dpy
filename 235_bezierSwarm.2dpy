def Init():
   # --- author : claude
   # --- curves chasing each other.  Every control point is a spring pulled
   # --- toward the point ahead of it, so the whole ribbon lags through any
   # --- change of direction, and the canvas keeps a few seconds of that lag
   # --- as a standing shape.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Chase")
   STR.SetFParam1Name("Trails")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : the leaders scatter
   # ---    trigger : new swarm

   GLB.st = surface.get_stride() // 4
   GLB.nc = 11
   GLB.npt = 7

   def swarm():
      GLB.x = np.random.random((GLB.nc, GLB.npt)) * 1280.0
      GLB.y = np.random.random((GLB.nc, GLB.npt)) * 720.0
      GLB.hx = np.random.random(GLB.nc) * 1280.0
      GLB.hy = np.random.random(GLB.nc) * 720.0
      GLB.ha = np.random.random(GLB.nc) * 6.283
      GLB.hu = np.random.random(GLB.nc)
   GLB.swarm = swarm
   GLB.swarm()

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.04, 0.42)
   f1 = STR.F1mix(3.0, 7.0)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.swarm()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   np.subtract(v, np.right_shift(v, int(f1)), out=v)
   v[:, :, 3] = 255
   surface.mark_dirty()

   turn = 1.1 if acc else 0.16
   GLB.ha = GLB.ha + (np.random.random(GLB.nc) - 0.5) * turn
   sp = 11.0
   GLB.hx = GLB.hx + np.cos(GLB.ha) * sp
   GLB.hy = GLB.hy + np.sin(GLB.ha) * sp
   # --- turn away from the wall rather than wrapping, so the ribbon stays
   # --- continuous and never draws a line right across the frame
   GLB.ha = np.where((GLB.hx < 60) | (GLB.hx > 1220), pi - GLB.ha, GLB.ha)
   GLB.ha = np.where((GLB.hy < 60) | (GLB.hy > 660), -GLB.ha, GLB.ha)
   GLB.hx = np.clip(GLB.hx, 60.0, 1220.0)
   GLB.hy = np.clip(GLB.hy, 60.0, 660.0)

   # --- each point chases the one in front of it
   GLB.x[:, 0] = GLB.x[:, 0] + (GLB.hx - GLB.x[:, 0]) * f0
   GLB.y[:, 0] = GLB.y[:, 0] + (GLB.hy - GLB.y[:, 0]) * f0
   for k in range(1, GLB.npt):
      GLB.x[:, k] = GLB.x[:, k] + (GLB.x[:, k-1] - GLB.x[:, k]) * f0
      GLB.y[:, k] = GLB.y[:, k] + (GLB.y[:, k-1] - GLB.y[:, k]) * f0

   cr.set_line_cap(cairo.LINE_CAP_ROUND)
   cr.set_line_join(cairo.LINE_JOIN_ROUND)
   for c in range(GLB.nc):
      col = hsv_to_rgb((GLB.hu[c] + f2) % 1.0, 0.78, 1.0)
      cr.set_source_rgb(col[2], col[1], col[0])
      cr.set_line_width(2.6)
      cr.move_to(GLB.x[c, 0], GLB.y[c, 0])
      k = 1
      # --- cubic through the chain : two controls and an end point at a time
      while k + 2 < GLB.npt:
         cr.curve_to(GLB.x[c, k], GLB.y[c, k],
                     GLB.x[c, k+1], GLB.y[c, k+1],
                     GLB.x[c, k+2], GLB.y[c, k+2])
         k = k + 3
      cr.stroke()
