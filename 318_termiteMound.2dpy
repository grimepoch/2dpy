def Init():
   # --- author : claude
   # --- termites building.  Each one carries at most one grain and drops it
   # --- where grains already are.  Nothing coordinates them - the pillars
   # --- and arches come out of the fact that a pile attracts more grains,
   # --- which is the actual explanation for the real mounds.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Workers")
   STR.SetFParam1Name("Stigmergy")
   STR.SetFParam2Name("Soil")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : swarming, they dig instead of build
   # ---    trigger : new ground

   GLB.res = 4
   GLB.gx = 1280 // GLB.res
   GLB.gy = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.gx, GLB.gy)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.gy, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   GLB.nb = np.zeros((GLB.gy, GLB.gx), dtype=np.int32)
   GLB.n = 900

   def ground():
      GLB.g = (np.random.random((GLB.gy, GLB.gx)) < 0.10).astype(np.int32)
      GLB.tx = np.random.randint(0, GLB.gx, GLB.n)
      GLB.ty = np.random.randint(0, GLB.gy, GLB.n)
      GLB.carry = np.zeros(GLB.n, dtype=np.int32)
   GLB.ground = ground
   GLB.ground()

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(1.0, 4.99)
   f1 = STR.F1mix(0.05, 0.95)
   f2 = STR.F2()

   if trig:
      GLB.ground()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   g = GLB.g
   nb = GLB.nb
   nb[:, :] = 0
   np.add(nb[1:], g[:-1], out=nb[1:])
   np.add(nb[:-1], g[1:], out=nb[:-1])
   np.add(nb[:, 1:], g[:, :-1], out=nb[:, 1:])
   np.add(nb[:, :-1], g[:, 1:], out=nb[:, :-1])

   for s in range(int(f0)):
      # --- a random walk, all termites at once
      d = np.random.randint(0, 4, GLB.n)
      GLB.tx = np.mod(GLB.tx + np.where(d == 0, 1, 0) -
                      np.where(d == 1, 1, 0), GLB.gx)
      GLB.ty = np.mod(GLB.ty + np.where(d == 2, 1, 0) -
                      np.where(d == 3, 1, 0), GLB.gy)
      here = g[GLB.ty, GLB.tx]
      near = nb[GLB.ty, GLB.tx]
      r = np.random.random(GLB.n)
      empty = GLB.carry == 0
      # --- pick up from bare ground, put down next to other grains.  The
      # --- asymmetry between those two is the whole construction rule.
      if acc:
         take = empty & (here == 1) & (r < 0.9)
         drop = (~empty) & (here == 0) & (near == 0) & (r < 0.5)
      else:
         take = empty & (here == 1) & (near < 2) & (r < 0.55)
         drop = (~empty) & (here == 0) & (r < (0.02 + near * f1 * 0.30))
      if take.any():
         g[GLB.ty[take], GLB.tx[take]] = 0
         GLB.carry = np.where(take, 1, GLB.carry)
      if drop.any():
         g[GLB.ty[drop], GLB.tx[drop]] = 1
         GLB.carry = np.where(drop, 0, GLB.carry)
   GLB.g = g

   c = hsv_to_rgb((0.06 + f2 * 0.10) % 1.0, 0.62, 1.0)
   sel = g == 1
   lit = 0.55 + nb * 0.11
   GLB.sv[:, :GLB.gx, 0] = np.clip(np.where(sel, c[0] * 210.0 * lit, 16.0),
                                   0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.gx, 1] = np.clip(np.where(sel, c[1] * 190.0 * lit, 13.0),
                                   0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.gx, 2] = np.clip(np.where(sel, c[2] * 170.0 * lit, 11.0),
                                   0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.gx, 3] = 255
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()

   cr.set_source_rgb(0.30, 0.75, 1.0)
   for i in range(0, GLB.n, 9):
      if GLB.carry[i] == 0:
         continue
      cr.rectangle(GLB.tx[i] * GLB.res, GLB.ty[i] * GLB.res, 3, 3)
   cr.fill()
