def Init():
   # --- author : claude
   # --- a neon spectrum : the bars are rendered into an offscreen group and
   # --- composited back a few times at growing scale, so they bloom
   # --- note : screen y=0 is the BOTTOM, so bars grow upward from y=0
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Bloom")
   STR.SetFParam1Name("Height")
   STR.SetFParam2Name("Hue")
   # ---    accent : mirror below the baseline
   # ---    trigger : bars <-> tubes

   # --- 10 slots = FFT analysis bins, 24 slots = MIDI notes
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"

   GLB.n = 12 if GLB.slots == 24 else GLB.slots
   GLB.lvl = []
   for i in range(GLB.n):
      GLB.lvl.append(0.0)

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0, 0.9)
   f1 = STR.F1mix(120.0, 560.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0

   n = GLB.n
   for k in range(n):
      GLB.lvl[k] = GLB.lvl[k] * 0.87

   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      if ids == 0:
         continue
      k = (note % 12) if GLB.mode == "midi" else i
      if k < n:
         v = velo / 127.0
         if v > GLB.lvl[k]:
            GLB.lvl[k] = v

   cr.set_source_rgb(0.02, 0.01, 0.03)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cw = 1180.0 / n
   x0 = 640.0 - cw * n * 0.5
   base = 80.0 if not acc else 360.0

   # --- the bright pass
   cr.push_group()
   for k in range(n):
      v = GLB.lvl[k]
      h = 8.0 + f1 * v
      x = x0 + k * cw
      r,g,b = hsv_to_rgb((f2 + k / (n * 1.0) * 0.55) % 1.0, 0.8, 1.0)
      if GLB.xmode:
         cr.set_source_rgb(b, g, r)
         cr.set_line_cap(cairo.LINE_CAP_ROUND)
         cr.set_line_width(cw * 0.42)
         cr.move_to(x + cw * 0.5, base)
         cr.line_to(x + cw * 0.5, base + h)
         cr.stroke()
         if acc:
            cr.move_to(x + cw * 0.5, base)
            cr.line_to(x + cw * 0.5, base - h)
            cr.stroke()
      else:
         lg = cairo.LinearGradient(0, base, 0, base + h)
         lg.add_color_stop_rgb(0.0, b, g, r)
         r2,g2,b2 = hsv_to_rgb((f2 + k / (n * 1.0) * 0.55 + 0.12) % 1.0, 0.35, 1.0)
         lg.add_color_stop_rgb(1.0, b2, g2, r2)
         cr.set_source(lg)
         cr.rectangle(x + 5, base, cw - 10, h)
         cr.fill()
         if acc:
            cr.rectangle(x + 5, base - h, cw - 10, h)
            cr.fill()
   cr.pop_group_to_source()

   cr.paint()
   if f0 > 0.02:
      for k in range(2):
         s = 1.0 + (k + 1) * 0.045 * (0.5 + f0)
         cr.save()
         cr.translate(640, base)
         cr.scale(s, s)
         cr.translate(-640, -base)
         cr.paint_with_alpha(f0 * (0.40 - k * 0.12))
         cr.restore()
