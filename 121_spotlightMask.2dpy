def Init():
   # --- author : claude
   # --- a pattern that only exists where the light falls.  A radial gradient
   # --- is used as a MASK over the source, so the reveal is a real soft edge
   # --- rather than a shape drawn on top.
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Beam Size")
   STR.SetFParam1Name("Softness")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : two beams
   # ---    trigger : hidden pattern changes

   GLB.pat = 0
   # --- a single alpha-only mask surface, reused every frame.  Two beams go
   # --- into it and it is applied in ONE mask operation; a full screen mask
   # --- costs about 12ms, so doing one per beam was the whole budget.
   GLB.msk = cairo.ImageSurface(cairo.FORMAT_A8, 1280, 720)
   GLB.mc = cairo.Context(GLB.msk)

   def hidden(hue, t):
      # --- whatever is being lit; drawn in full, the mask does the hiding
      if GLB.pat == 0:
         k = 0
         y = 0.0
         while y < 720:
            r,g,b = hsv_to_rgb((hue + (k % 9) / 9.0 * 0.5) % 1.0, 0.85, 1.0)
            cr.set_source_rgb(b, g, r)
            cr.rectangle(0, y, 1280, 26)
            cr.fill()
            y = y + 34.0
            k = k + 1
      elif GLB.pat == 1:
         for j in range(10):
            for i in range(18):
               r,g,b = hsv_to_rgb((hue + ((i + j) % 7) / 7.0 * 0.5) % 1.0, 0.8, 1.0)
               cr.set_source_rgb(b, g, r)
               cr.rectangle(i * 72 + 6, j * 72 + 6, 60, 60)
               cr.fill()
      else:
         cr.set_line_width(7)
         for k in range(26):
            r,g,b = hsv_to_rgb((hue + k / 26.0 * 0.6) % 1.0, 0.85, 1.0)
            cr.set_source_rgb(b, g, r)
            cr.move_to(-100 + k * 60, 0)
            cr.line_to(-100 + k * 60 + 420, 720)
            cr.stroke()
   GLB.hidden = hidden

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(90.0, 400.0)
   f1 = STR.F1mix(0.05, 0.95)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.pat = (GLB.pat + 1) % 3
      GLB.xmode = 1 if GLB.xmode==0 else 0

   cr.set_source_rgb(0.02, 0.02, 0.03)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   x1 = 640.0 + 380.0 * sin(time * 0.33)
   y1 = 360.0 + 190.0 * cos(time * 0.47)

   # --- build the beam mask: clear it, then paint each beam's falloff in
   mc = GLB.mc
   mc.save()
   mc.set_operator(cairo.OPERATOR_SOURCE)
   mc.set_source_rgba(0, 0, 0, 0)
   mc.paint()
   mc.set_operator(cairo.OPERATOR_OVER)

   g = cairo.RadialGradient(x1, y1, f0 * (1.0 - f1) * 0.9, x1, y1, f0)
   g.add_color_stop_rgba(0.0, 0, 0, 0, 1.0)
   g.add_color_stop_rgba(0.75, 0, 0, 0, 0.55)
   g.add_color_stop_rgba(1.0, 0, 0, 0, 0.0)
   mc.set_source(g)
   mc.rectangle(x1 - f0, y1 - f0, f0 * 2, f0 * 2)
   mc.fill()

   x2 = 640.0 - 300.0 * sin(time * 0.51 + 1.0)
   y2 = 360.0 - 150.0 * cos(time * 0.29)
   if acc:
      r2 = f0 * 0.7
      g2 = cairo.RadialGradient(x2, y2, r2 * (1.0 - f1), x2, y2, r2)
      g2.add_color_stop_rgba(0.0, 0, 0, 0, 1.0)
      g2.add_color_stop_rgba(1.0, 0, 0, 0, 0.0)
      mc.set_source(g2)
      mc.rectangle(x2 - r2, y2 - r2, r2 * 2, r2 * 2)
      mc.fill()
   mc.restore()
   GLB.msk.flush()

   # --- the lit pattern goes into a group, then the whole group is revealed
   # --- through that one mask
   # --- clip to the beams first: a mask costs in proportion to the area it
   # --- actually covers, and the beams are never the whole frame
   cr.save()
   cr.rectangle(x1 - f0, y1 - f0, f0 * 2, f0 * 2)
   if acc:
      cr.rectangle(x2 - f0 * 0.7, y2 - f0 * 0.7, f0 * 1.4, f0 * 1.4)
   cr.clip()
   cr.push_group()
   GLB.hidden(f2, time)
   cr.pop_group_to_source()
   cr.mask_surface(GLB.msk, 0, 0)
   cr.restore()

   if GLB.xmode:
      # --- the beam cone, so you can see where the light comes from
      cr.set_source_rgba(1, 1, 1, 0.05)
      cr.move_to(x1, y1)
      cr.line_to(x1 - f0 * 0.5, 720)
      cr.line_to(x1 + f0 * 0.5, 720)
      cr.close_path()
      cr.fill()
