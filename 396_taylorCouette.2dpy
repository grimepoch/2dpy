def Init():
   # --- author : claude
   # --- Taylor-Couette flow : fluid between two cylinders, the inner one
   # --- turning.  Above a critical speed the flow breaks into stacked
   # --- counter-rotating rolls, and faster still the rolls themselves start
   # --- to wave - so the pattern keeps changing state without ever settling
   # --- or completing.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Rotation")
   STR.SetFParam1Name("Wavy Mode")
   STR.SetFParam2Name("Dye")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : the outer cylinder counter-rotates
   # ---    trigger : new roll count

   GLB.res = 3
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   yy, xx = np.meshgrid(np.arange(GLB.ny), np.arange(GLB.nx), indexing="ij")
   GLB.iy = yy.astype(np.float32)
   GLB.ix = xx.astype(np.float32)
   # --- the gap runs across the screen, the axis up it
   GLB.gap = (GLB.ix - GLB.nx * 0.18) / (GLB.nx * 0.64)
   GLB.rolls = 9
   GLB.ph = 0.0
   GLB.nb = 200
   GLB.pal = np.zeros((GLB.nb, 3), dtype=np.float32)

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.2, 2.4)
   f1 = STR.F1mix(0.0, 1.0)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.rolls = 5 + np.random.randint(10)
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   g = GLB.gap
   inside = (g > 0.0) & (g < 1.0)
   GLB.ph = GLB.ph + f0 * 0.06

   # --- the rolls, with the wavy mode that appears at higher rotation
   axial = GLB.iy / (GLB.ny * 1.0)
   wob = f1 * 0.16 * np.sin(g * 6.2831853 * 2.0 + time * 2.2) * \
       np.sin(axial * GLB.rolls * 6.2831853 * 0.5 + time * 1.1)
   ang = axial * GLB.rolls * 6.2831853 + wob * 6.2831853
   # --- vortex stream function across the gap : zero at both walls
   psi = np.sin(ang) * np.sin(np.clip(g, 0.0, 1.0) * pi)

   # --- the azimuthal velocity is what the dye actually rides round on, and
   # --- it shears : the inner wall carries it much faster than the outer
   omega = (1.0 - np.clip(g, 0.0, 1.0)) ** 2
   if acc:
      omega = omega - np.clip(g, 0.0, 1.0) ** 2 * 0.8
   swirl = GLB.ph * omega * 6.0

   # --- dye striped round the annulus, carried by the swirl and folded by
   # --- the rolls
   # --- np.mod can hand back the modulus itself once the argument is large
   # --- enough that the remainder rounds up in float, so this is clipped
   # --- rather than trusted
   q = np.mod((swirl + psi * 2.6 + f2 * 6.2831853) *
              (GLB.nb / 6.2831853), GLB.nb).astype(np.int32)
   np.clip(q, 0, GLB.nb - 1, out=q)
   for i in range(GLB.nb):
      t = i / (GLB.nb * 1.0)
      c = hsv_to_rgb((f2 + t * 0.25) % 1.0, 0.72, 0.35 + 0.65 * abs(
         sin(t * 6.2831853 * 2.0)))
      GLB.pal[i, 0] = c[0] * 255.0
      GLB.pal[i, 1] = c[1] * 255.0
      GLB.pal[i, 2] = c[2] * 255.0
   col = GLB.pal[q]
   shade = np.clip(0.35 + np.abs(psi) * 0.85, 0.0, 1.0)
   red = np.where(inside, col[:, :, 0] * shade, 10.0)
   grn = np.where(inside, col[:, :, 1] * shade, 11.0)
   blu = np.where(inside, col[:, :, 2] * shade, 14.0)
   # --- the two cylinder walls
   wall = (np.abs(g) < 0.012) | (np.abs(g - 1.0) < 0.012)
   red = np.where(wall, 150.0, red)
   grn = np.where(wall, 158.0, grn)
   blu = np.where(wall, 166.0, blu)
   GLB.sv[:, :GLB.nx, 0] = np.clip(red, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 1] = np.clip(grn, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 2] = np.clip(blu, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 3] = 255
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
