def Init():
   # --- author : claude
   # --- a dendrite grown once in a 60 degree wedge and then mirrored around,
   # --- which is exactly why real snowflakes have six identical arms
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Growth")
   STR.SetFParam1Name("Branching")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : filled plates instead of needles
   # ---    trigger : grow a new crystal

   def grow(branch):
      # --- one arm: a spine with side needles at 60 degrees
      GLB.seg = []
      stack = [[0.0, 0.0, pi * 0.5, 150.0, 0]]
      while len(stack) > 0 and len(GLB.seg) < 260:
         s = stack.pop()
         x0 = s[0]
         y0 = s[1]
         a = s[2]
         L = s[3]
         d = s[4]
         x1 = x0 + cos(a) * L
         y1 = y0 + sin(a) * L
         GLB.seg.append([x0, y0, x1, y1, d])
         if d < 4:
            # --- the spine carries on
            stack.append([x1, y1, a, L * 0.62, d + 1])
            # --- and throws needles off at the crystal angle
            nb = 2 if np.random.random() < branch else 1
            for k in range(nb):
               f = 0.30 + 0.42 * np.random.random()
               mx = x0 + (x1 - x0) * f
               my = y0 + (y1 - y0) * f
               for sgn in (-1.0, 1.0):
                  stack.append([mx, my, a + sgn * pi / 3.0, L * 0.44, d + 2])
      GLB.branch = branch
   GLB.grow = grow
   GLB.grow(0.5)

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.2, 1.6)
   f1 = STR.F1()
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.grow(f1)
      GLB.xmode = 1 if GLB.xmode==0 else 0

   cr.set_source_rgb(0.02, 0.03, 0.06)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cr.save()
   cr.translate(640, 360)
   cr.rotate(time * 0.05)
   sc = f0
   cr.scale(sc, sc)

   cr.set_line_cap(cairo.LINE_CAP_ROUND)
   cr.set_line_join(cairo.LINE_JOIN_ROUND)

   # --- six arms, each drawn twice as a mirrored pair
   for arm in range(6):
      cr.save()
      cr.rotate(arm * pi / 3.0)
      for mirror in range(2):
         cr.save()
         if mirror:
            cr.scale(-1.0, 1.0)
         for d in range(5):
            t = d / 4.0
            if GLB.xmode:
               r,g,b = hsv_to_rgb((f2 + t * 0.4) % 1.0, 0.6, 1.0)
            else:
               r,g,b = hsv_to_rgb((f2 + 0.55 + t * 0.08) % 1.0, 0.25 + 0.3 * t, 1.0)
            cr.set_source_rgb(b, g, r)
            cr.set_line_width((7.0 - d * 1.2) / sc)
            any = 0
            for s in GLB.seg:
               if s[4] != d:
                  continue
               cr.move_to(s[0], s[1])
               cr.line_to(s[2], s[3])
               any = 1
            if any:
               cr.stroke()
         cr.restore()
      # --- the hexagonal plate at the middle
      if acc:
         r,g,b = hsv_to_rgb((f2 + 0.5) % 1.0, 0.4, 1.0)
         cr.set_source_rgba(b, g, r, 0.35)
         cr.move_to(0, 0)
         for k in range(3):
            a = (k - 1) * pi / 3.0 + pi * 0.5
            cr.line_to(cos(a) * 60.0, sin(a) * 60.0)
         cr.close_path()
         cr.fill()
      cr.restore()

   cr.restore()
