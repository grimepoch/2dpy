def Init():
   # --- author : claude
   # --- marginalia.  A vine grows out from the edge of the page, throwing
   # --- leaves and gold bosses as it goes, and the page is never repainted -
   # --- so the border is built by the vine rather than drawn as a border.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Growth")
   STR.SetFParam1Name("Foliage")
   STR.SetFParam2Name("Pigment")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : gold leaf
   # ---    trigger : a new page

   GLB.cap = 90

   def newpage():
      GLB.n = 0
      GLB.vx = np.zeros(GLB.cap)
      GLB.vy = np.zeros(GLB.cap)
      GLB.va = np.zeros(GLB.cap)
      GLB.vl = np.zeros(GLB.cap)
      GLB.vw = np.zeros(GLB.cap)
      cr.set_source_rgb(0.72, 0.82, 0.90)
      cr.rectangle(0, 0, 1280, 720)
      cr.fill()
      cr.set_source_rgb(0.62, 0.72, 0.82)
      cr.set_line_width(2.0)
      cr.rectangle(70, 50, 1140, 620)
      cr.stroke()
   GLB.newpage = newpage

   def shoot(k):
      for i in range(k):
         if GLB.n >= GLB.cap:
            return
         j = GLB.n
         side = np.random.randint(4)
         if side == 0:
            GLB.vx[j] = 70.0
            GLB.vy[j] = 50.0 + np.random.random() * 620.0
            GLB.va[j] = 0.0
         elif side == 1:
            GLB.vx[j] = 1210.0
            GLB.vy[j] = 50.0 + np.random.random() * 620.0
            GLB.va[j] = pi
         elif side == 2:
            GLB.vx[j] = 70.0 + np.random.random() * 1140.0
            GLB.vy[j] = 50.0
            GLB.va[j] = 1.5708
         else:
            GLB.vx[j] = 70.0 + np.random.random() * 1140.0
            GLB.vy[j] = 670.0
            GLB.va[j] = -1.5708
         GLB.vl[j] = 140.0 + np.random.random() * 190.0
         GLB.vw[j] = 4.5
         GLB.n = j + 1
   GLB.shoot = shoot
   GLB.newpage()
   GLB.shoot(5)


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(1.5, 6.0)
   f1 = STR.F1mix(0.04, 0.30)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.newpage()
      GLB.shoot(5)
      GLB.xmode = 1 if GLB.xmode == 0 else 0
   if GLB.n < 3:
      GLB.shoot(4)

   cr.set_line_cap(cairo.LINE_CAP_ROUND)
   born = []
   i = 0
   while i < GLB.n:
      # --- a vine curls : it turns steadily, not randomly
      GLB.va[i] = GLB.va[i] + sin(GLB.vl[i] * 0.06) * 0.16 + (
         np.random.random() - 0.5) * 0.10
      x0 = GLB.vx[i]
      y0 = GLB.vy[i]
      x1 = x0 + cos(GLB.va[i]) * f0
      y1 = y0 + sin(GLB.va[i]) * f0
      GLB.vx[i] = x1
      GLB.vy[i] = y1
      GLB.vl[i] = GLB.vl[i] - f0
      GLB.vw[i] = max(1.0, GLB.vw[i] * 0.994)

      c = hsv_to_rgb((0.30 + f2 * 0.18) % 1.0, 0.72, 0.55)
      cr.set_source_rgb(c[2], c[1], c[0])
      cr.set_line_width(GLB.vw[i])
      cr.move_to(x0, y0)
      cr.line_to(x1, y1)
      cr.stroke()

      # --- a leaf, thrown off to alternating sides
      if np.random.random() < f1:
         side = 1.0 if (int(GLB.vl[i]) % 2) == 0 else -1.0
         a = GLB.va[i] + side * 1.1
         ln = 20.0 + np.random.random() * 26.0
         # --- a leaf is two curves bulging to EITHER side of its own axis.
         # --- Control points along the axis, however far out, only ever give
         # --- a sliver - the offset has to be perpendicular.
         ux = cos(a)
         uy = sin(a)
         wd = ln * 0.42
         px = -uy * wd
         py = ux * wd
         tx = x1 + ux * ln
         ty = y1 + uy * ln
         lc = hsv_to_rgb((0.26 + f2 * 0.22) % 1.0, 0.66, 0.72)
         cr.set_source_rgb(lc[2], lc[1], lc[0])
         cr.move_to(x1, y1)
         cr.curve_to(x1 + ux * ln * 0.30 + px, y1 + uy * ln * 0.30 + py,
                     x1 + ux * ln * 0.72 + px, y1 + uy * ln * 0.72 + py,
                     tx, ty)
         cr.curve_to(x1 + ux * ln * 0.72 - px, y1 + uy * ln * 0.72 - py,
                     x1 + ux * ln * 0.30 - px, y1 + uy * ln * 0.30 - py,
                     x1, y1)
         cr.fill()
         # --- the midrib
         cr.set_source_rgb(lc[2] * 0.6, lc[1] * 0.6, lc[0] * 0.6)
         cr.set_line_width(1.0)
         cr.move_to(x1, y1)
         cr.line_to(tx, ty)
         cr.stroke()

      if acc and np.random.random() < 0.05:
         # --- a gold boss, burnished
         cr.set_source_rgb(0.28, 0.76, 0.98)
         cr.new_sub_path()
         cr.arc(x1, y1, 7.0, 0, 6.2831853)
         cr.fill()
         cr.set_source_rgb(0.72, 0.94, 1.0)
         cr.new_sub_path()
         cr.arc(x1 - 2, y1 + 2, 2.4, 0, 6.2831853)
         cr.fill()

      off = (x1 < 60 or x1 > 1220 or y1 < 40 or y1 > 680)
      if off or GLB.vl[i] <= 0.0:
         last = GLB.n - 1
         GLB.vx[i] = GLB.vx[last]
         GLB.vy[i] = GLB.vy[last]
         GLB.va[i] = GLB.va[last]
         GLB.vl[i] = GLB.vl[last]
         GLB.vw[i] = GLB.vw[last]
         GLB.n = GLB.n - 1
      else:
         if np.random.random() < 0.012 and GLB.n + len(born) < GLB.cap:
            born.append([x1, y1, GLB.va[i] + 1.2, GLB.vl[i] * 0.6,
                         GLB.vw[i] * 0.7])
         i = i + 1
   for b in born:
      j = GLB.n
      GLB.vx[j] = b[0]
      GLB.vy[j] = b[1]
      GLB.va[j] = b[2]
      GLB.vl[j] = b[3]
      GLB.vw[j] = b[4]
      GLB.n = j + 1
