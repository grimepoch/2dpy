def Init():
   # --- author : claude
   # --- a lyric line with the fill sweeping across it in time, the next
   # --- line queued underneath.  The sweep is a clip, not a second string.
   # --- note : screen y=0 is the BOTTOM, so text must be drawn y-flipped
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Bars Per Line")
   STR.SetFParam1Name("Text Size")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : bounce the ball
   # ---    trigger : skip to the next line

   GLB.lines = ["EVERY FRAME A NEW DECISION",
                "THE CLOCK DOES NOT WAIT FOR YOU",
                "SIXTEEN MILLISECONDS OF ROOM",
                "PAINT IT BEFORE THE BEAT LANDS",
                "NOTHING HERE IS EVER FINISHED",
                "ONE THOUSAND TWO HUNDRED EIGHTY",
                "HOLD THE LINE AND LET IT RING"]
   GLB.i = 0
   GLB.ph = 0.0

   def text(x, y, s):
      cr.save()
      cr.translate(x, y)
      cr.scale(1.0, -1.0)
      cr.move_to(0, 0)
      cr.show_text(s)
      cr.restore()
   GLB.text = text

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(1.0, 8.0)
   f1 = STR.F1mix(34.0, 72.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.i = (GLB.i + 1) % len(GLB.lines)
      GLB.ph = 0.0
      GLB.xmode = 1 if GLB.xmode==0 else 0

   # --- one line takes f0 beats
   GLB.ph = (time / f0) % 1.0
   idx = int(time / f0) % len(GLB.lines)

   cr.set_source_rgb(0.04, 0.02, 0.06)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cr.select_font_face("sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
   cr.set_font_size(f1)

   s = GLB.lines[(GLB.i + idx) % len(GLB.lines)]
   nx = GLB.lines[(GLB.i + idx + 1) % len(GLB.lines)]
   e = cr.text_extents(s)
   x = 640 - e.width * 0.5 - e.x_bearing
   y = 390.0

   base = hsv_to_rgb(f2, 0.25, 0.45)
   lit  = hsv_to_rgb((f2 + 0.12) % 1.0, 0.85, 1.0)

   # --- unsung
   cr.set_source_rgb(base[2], base[1], base[0])
   GLB.text(x, y, s)

   # --- sung, clipped to the sweep
   cut = x + e.x_bearing + e.width * GLB.ph
   cr.save()
   cr.rectangle(0, y - f1 * 0.6, cut, f1 * 2.0)
   cr.clip()
   cr.set_source_rgb(lit[2], lit[1], lit[0])
   GLB.text(x, y, s)
   if GLB.xmode:
      cr.set_source_rgba(lit[2], lit[1], lit[0], 0.35)
      cr.rectangle(0, y - 14, cut, 6)
      cr.fill()
   cr.restore()

   # --- the bouncing ball
   if acc:
      bx = cut
      by = y + f1 * 1.25 + abs(sin(GLB.ph * pi * len(s) * 0.25)) * 34.0
      cr.set_source_rgb(1, 1, 1)
      cr.new_sub_path()
      cr.arc(bx, by, 11, 0, 2 * pi)
      cr.fill()

   # --- the line coming up
   cr.set_font_size(f1 * 0.6)
   e2 = cr.text_extents(nx)
   cr.set_source_rgba(base[2], base[1], base[0], 0.8)
   GLB.text(640 - e2.width * 0.5 - e2.x_bearing, 250, nx)

   # --- progress bar
   cr.set_source_rgba(lit[2], lit[1], lit[0], 0.8)
   cr.rectangle(0, 0, 1280 * GLB.ph, 7)
   cr.fill()
