def Init():
   # --- author : claude
   # --- a heat equation with sources and sinks : the plate's temperature at
   # --- every point is last frame's, relaxed toward its neighbours, so heat
   # --- actually conducts rather than being redrawn
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Conduct")
   STR.SetFParam1Name("Sources")
   STR.SetFParam2Name("Palette")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : isotherm contours
   # ---    trigger : move the sources

   GLB.res = 4
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   GLB.t = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)

   def place():
      GLB.src = []
      for i in range(8):
         GLB.src.append([np.random.random(), np.random.random(),
                         1.0 if i % 2 == 0 else -1.0,
                         np.random.random() * 6.28])
   GLB.place = place
   GLB.place()

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.05, 0.24)
   f1 = STR.F1mix(2.0, 8.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.place()
      GLB.xmode = 1 if GLB.xmode==0 else 0

   t = GLB.t
   for s in range(2):
      lap = np.zeros_like(t)
      lap[1:-1,1:-1] = (t[:-2,1:-1] + t[2:,1:-1] + t[1:-1,:-2] + t[1:-1,2:]
                        - 4.0 * t[1:-1,1:-1])
      t = t + lap * f0
   # --- the sources hold their temperature, they are not just added
   n = int(f1)
   for i in range(n):
      sp = GLB.src[i]
      x = int((0.12 + 0.76 * sp[0]) * GLB.nx + 12.0 * sin(time * 0.5 + sp[3]))
      y = int((0.12 + 0.76 * sp[1]) * GLB.ny + 12.0 * cos(time * 0.4 + sp[3]))
      t[y-3:y+3, x-3:x+3] = sp[2]
   np.multiply(t, 0.9995, out=t)
   GLB.t = t

   val = np.clip(t * 0.5 + 0.5, 0.0, 1.0)
   bands = 26
   q = np.clip((val * bands).astype(np.int32), 0, bands - 1)
   if acc:
      # --- isotherms: only every third band is lit
      q = np.where((q % 3) == 0, q, 0)

   pal = np.zeros((bands, 4), dtype=np.uint8)
   for bd in range(bands):
      u = bd / (bands - 1.0)
      if GLB.xmode:
         c = hsv_to_rgb((f2 + u * 0.9) % 1.0, 0.85, 0.15 + 0.85 * u)
      else:
         c = hsv_to_rgb((f2 + 0.66 - u * 0.66) % 1.0, 0.95 - 0.5 * u,
                        0.12 + 0.88 * u)
      pal[bd][0] = int(c[2] * 255)
      pal[bd][1] = int(c[1] * 255)
      pal[bd][2] = int(c[0] * 255)
      pal[bd][3] = 255

   GLB.sv[:, :GLB.nx] = pal[q]
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
