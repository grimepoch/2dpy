def Init():
   # --- author : claude
   # --- a real wave equation on a height field : two previous states are kept
   # --- and the new one is 2*now - before + laplacian, which is the actual
   # --- discrete wave equation.  Drops are dropped in and the rings interfere.
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Tension")
   STR.SetFParam1Name("Damping")
   STR.SetFParam2Name("Depth")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : show as height, not shading
   # ---    trigger : big drop in the middle

   GLB.res = 3
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   GLB.a = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   GLB.b = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   # --- render the height field into a small surface, then blit it up with a
   # --- NEAREST scale; emitting cairo rects for it costs ~60x more
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   GLB.lastbeat = -1

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.05, 0.48)
   f1 = STR.F1mix(0.970, 0.9995)
   f2 = STR.F2mix(1.0, 9.0)

   itime = STR.IT()
   time  = itime + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0
      GLB.a[GLB.ny // 2 - 3:GLB.ny // 2 + 3, GLB.nx // 2 - 3:GLB.nx // 2 + 3] = 320.0

   # --- a drop on every beat
   if itime != GLB.lastbeat:
      GLB.lastbeat = itime
      x = np.random.randint(6, GLB.nx - 6)
      y = np.random.randint(6, GLB.ny - 6)
      GLB.a[y-2:y+2, x-2:x+2] = 220.0

   a = GLB.a
   b = GLB.b
   lap = np.zeros_like(a)
   lap[1:-1, 1:-1] = (a[:-2, 1:-1] + a[2:, 1:-1] + a[1:-1, :-2] + a[1:-1, 2:]
                      - 4.0 * a[1:-1, 1:-1])
   nxt = (2.0 * a - b + lap * f0) * f1
   GLB.b = a
   GLB.a = nxt

   # --- shade from the SLOPE, which is what makes water look like water
   gx = np.zeros_like(nxt)
   gy = np.zeros_like(nxt)
   gx[:, 1:-1] = nxt[:, 2:] - nxt[:, :-2]
   gy[1:-1, :] = nxt[2:, :] - nxt[:-2, :]

   if acc:
      val = np.clip(nxt * 0.012 + 0.5, 0.0, 1.0)
   else:
      val = np.clip((gx + gy) * 0.02 + 0.5, 0.0, 1.0)

   bands = 24
   q = np.clip((val * bands).astype(np.int32), 0, bands - 1)

   pal = np.zeros((bands, 4), dtype=np.uint8)
   for bd in range(bands):
      t = bd / (bands - 1.0)
      if GLB.xmode:
         c = hsv_to_rgb((f2 * 0.05 + t * 0.7) % 1.0, 0.8, 0.25 + 0.75 * t)
      else:
         c = hsv_to_rgb((0.52 + t * 0.08) % 1.0, 0.85 - 0.55 * t, 0.2 + 0.8 * t)
      pal[bd][0] = int(c[2] * 255)
      pal[bd][1] = int(c[1] * 255)
      pal[bd][2] = int(c[0] * 255)
      pal[bd][3] = 255

   GLB.sv[:, :GLB.nx] = pal[q]
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
