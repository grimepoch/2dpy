def Init():
   # --- author : claude
   # --- a reef accreting.  Polyps settle only on existing skeleton and only
   # --- where there is water moving past, so the colony grows outward and
   # --- upward into the current and shades out its own interior - which is
   # --- why real coral is a surface, not a solid.
   # --- note : screen y=0 is the BOTTOM, so the substrate is at low y
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Settlement")
   STR.SetFParam1Name("Current")
   STR.SetFParam2Name("Pigment")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : bleaching event
   # ---    trigger : new substrate

   GLB.res = 3
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   GLB.cnt = np.zeros((GLB.ny, GLB.nx), dtype=np.int32)
   GLB.age = 0

   def substrate():
      GLB.g = np.zeros((GLB.ny, GLB.nx), dtype=np.int32)
      GLB.g[0:3, :] = 1
      for k in range(9):
         px = np.random.randint(10, GLB.nx - 10)
         GLB.g[0:6, px-4:px+4] = 1
      GLB.t = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
      GLB.age = 0
   GLB.substrate = substrate
   GLB.substrate()

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.01, 0.16)
   f1 = STR.F1mix(0.0, 1.0)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig or (GLB.g[-4:, :]).any():
      GLB.substrate()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   g = GLB.g
   t = GLB.t
   c = GLB.cnt
   c[:, :] = 0
   np.add(c[1:], g[:-1], out=c[1:])
   np.add(c[:-1], g[1:], out=c[:-1])
   np.add(c[:, 1:], g[:, :-1], out=c[:, 1:])
   np.add(c[:, :-1], g[:, 1:], out=c[:, :-1])

   # --- the current sweeps across, so the windward side gets fed more
   drift = sin(time * 0.4) * f1
   xs = np.arange(GLB.nx).reshape(1, GLB.nx).astype(np.float32)
   feed = 0.6 + 0.4 * np.sin(xs * 0.02 + time * 0.9 + drift * 4.0)
   # --- a polyp needs skeleton to sit on, and open water above it
   open_ = (g == 0) & (c > 0) & (c < 3)
   p = np.where(open_, f0 * feed, 0.0)
   go = p > np.random.random((GLB.ny, GLB.nx))
   g[go] = 1
   GLB.age = GLB.age + 1
   t[go] = GLB.age
   GLB.g = g
   GLB.t = t

   live = g == 1
   rel = np.clip(t / (GLB.age + 1.0), 0.0, 1.0)
   # --- new growth at the tips carries the pigment, old skeleton is bare
   if acc:
      hue = 0.0
      sat = 0.05
   else:
      hue = f2
      sat = 0.80
   cc = hsv_to_rgb(hue % 1.0, sat, 1.0)
   cd = hsv_to_rgb((hue + 0.10) % 1.0, sat * 0.5, 0.62)
   red = np.where(live, (cd[0] + (cc[0] - cd[0]) * rel) * 255.0, 6.0)
   grn = np.where(live, (cd[1] + (cc[1] - cd[1]) * rel) * 255.0, 12.0)
   blu = np.where(live, (cd[2] + (cc[2] - cd[2]) * rel) * 255.0, 26.0)
   GLB.sv[:, :GLB.nx, 0] = np.clip(red, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 1] = np.clip(grn, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 2] = np.clip(blu, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 3] = 255
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
