def Init():
   # --- author : claude
   # --- a maze carved into an isometric block field : the walls are columns,
   # --- so the maze reads as architecture rather than a plan
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Height")
   STR.SetFParam1Name("Grid")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : wireframe
   # ---    trigger : carve a new maze

   GLB.n = 0
   GLB.tw = 30.0
   GLB.th = 17.0

   def carve(n):
      # --- recursive backtracker on an n x n grid of cells
      GLB.n = n
      g = np.ones((n, n), dtype=np.int32)
      stack = [[n // 2, n // 2]]
      g[n // 2][n // 2] = 0
      while len(stack) > 0:
         c = stack[len(stack) - 1]
         opts = []
         for d in ([2,0],[-2,0],[0,2],[0,-2]):
            x = c[0] + d[0]
            y = c[1] + d[1]
            if x > 0 and x < n - 1 and y > 0 and y < n - 1 and g[y][x] == 1:
               opts.append([x, y, d])
         if len(opts) == 0:
            stack.pop()
            continue
         o = opts[np.random.randint(0, len(opts))]
         g[c[1] + o[2][1] // 2][c[0] + o[2][0] // 2] = 0
         g[o[1]][o[0]] = 0
         stack.append([o[0], o[1]])
      GLB.g = g
   GLB.carve = carve
   GLB.carve(21)

   def column(sx, sy, h, top, lft, rgt, wire):
      tw = GLB.tw
      th = GLB.th
      cr.move_to(sx - tw, sy)
      cr.line_to(sx, sy - th)
      cr.line_to(sx, sy - th + h)
      cr.line_to(sx - tw, sy + h)
      cr.close_path()
      cr.set_source_rgb(lft[2], lft[1], lft[0])
      if wire:
         cr.stroke()
      else:
         cr.fill()
      cr.move_to(sx + tw, sy)
      cr.line_to(sx, sy - th)
      cr.line_to(sx, sy - th + h)
      cr.line_to(sx + tw, sy + h)
      cr.close_path()
      cr.set_source_rgb(rgt[2], rgt[1], rgt[0])
      if wire:
         cr.stroke()
      else:
         cr.fill()
      cr.move_to(sx - tw, sy + h)
      cr.line_to(sx, sy - th + h)
      cr.line_to(sx + tw, sy + h)
      cr.line_to(sx, sy + th + h)
      cr.close_path()
      cr.set_source_rgb(top[2], top[1], top[0])
      if wire:
         cr.stroke()
      else:
         cr.fill()
   GLB.column = column

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(10.0, 120.0)
   # --- each column is three separate fills, so the grid size is the budget
   f1 = STR.F1mix(9.0, 15.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   n = int(f1)
   if n % 2 == 0:
      n = n + 1
   if trig or n != GLB.n:
      GLB.carve(n)
      if trig:
         GLB.xmode = 1 if GLB.xmode==0 else 0

   cr.set_source_rgb(0.02, 0.01, 0.03)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   n = GLB.n
   cr.set_line_width(1.2)
   GLB.tw = 620.0 / n
   GLB.th = GLB.tw * 0.56

   # --- Precompute the palette.  Colour depends only on wall/floor and the
   # --- depth band, so 3 hsv_to_rgb calls per column (nearly 2000 a frame)
   # --- were pure waste.
   nb = 6
   pal = []
   for w in range(2):
      row = []
      for b in range(nb):
         d = (b + 0.5) / nb
         if GLB.xmode:
            hue = (f2 + d * 0.5) % 1.0
         else:
            hue = (f2 + (0.12 if w else 0.55)) % 1.0
         sat = 0.55 if w else 0.30
         row.append([hsv_to_rgb(hue, sat, 1.00 - d * 0.35),
                     hsv_to_rgb(hue, sat + 0.15, 0.48 - d * 0.2),
                     hsv_to_rgb(hue, sat + 0.10, 0.72 - d * 0.28)])
      pal.append(row)

   # --- back to front so the painter's algorithm occludes correctly
   for j in range(n):
      for i in range(n):
         u = i - (n - 1) * 0.5
         v = j - (n - 1) * 0.5
         sx = 640 + (u - v) * GLB.tw
         sy = 250 - (u + v) * GLB.th
         wall = GLB.g[j][i]
         if wall:
            h = f0
         else:
            h = 4.0
         bi = int((i + j) * nb / (2.0 * n))
         if bi > nb - 1:
            bi = nb - 1
         pp = pal[1 if wall else 0][bi]
         top = pp[0]
         lft = pp[1]
         rgt = pp[2]
         if acc:
            GLB.column(sx, sy, h, top, top, top, 1)
         else:
            GLB.column(sx, sy, h, top, lft, rgt, 0)
