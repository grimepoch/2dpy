def Init():
   # --- author : claude
   # --- Physarum : agents deposit a trail, sense it ahead of them and turn
   # --- toward the strongest.  The trail map IS the previous frame, decayed
   # --- and blurred, so the network is entirely self organised.
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Sense Angle")
   STR.SetFParam1Name("Turn")
   STR.SetFParam2Name("Decay")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : agents shown as sparks
   # ---    trigger : rescatter the colony

   GLB.res = 3
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   GLB.trail = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   GLB.n = 2600

   def scatter():
      a = np.random.random(GLB.n) * 6.28
      r = np.sqrt(np.random.random(GLB.n)) * (GLB.ny * 0.42)
      GLB.px = GLB.nx * 0.5 + np.cos(a) * r
      GLB.py = GLB.ny * 0.5 + np.sin(a) * r
      GLB.pa = np.random.random(GLB.n) * 6.28
   GLB.scatter = scatter
   GLB.scatter()

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.2, 1.4)
   f1 = STR.F1mix(0.1, 1.2)
   f2 = STR.F2mix(0.85, 0.995)

   time = STR.IT() + STR.FT()

   if trig:
      GLB.scatter()
      GLB.xmode = 1 if GLB.xmode==0 else 0

   tr = GLB.trail
   # --- the trail map is the memory: blur it and let it evaporate
   tr[1:-1,1:-1] = (tr[1:-1,1:-1] * 0.55
                    + (tr[:-2,1:-1] + tr[2:,1:-1] + tr[1:-1,:-2] + tr[1:-1,2:]) * 0.1125)
   np.multiply(tr, f2, out=tr)

   # --- sense three points ahead and steer toward the strongest
   sa = f0
   d = 7.0
   ix = np.clip((GLB.px + np.cos(GLB.pa) * d).astype(np.int32), 0, GLB.nx - 1)
   iy = np.clip((GLB.py + np.sin(GLB.pa) * d).astype(np.int32), 0, GLB.ny - 1)
   fc = tr[iy, ix]
   ix = np.clip((GLB.px + np.cos(GLB.pa + sa) * d).astype(np.int32), 0, GLB.nx - 1)
   iy = np.clip((GLB.py + np.sin(GLB.pa + sa) * d).astype(np.int32), 0, GLB.ny - 1)
   fl = tr[iy, ix]
   ix = np.clip((GLB.px + np.cos(GLB.pa - sa) * d).astype(np.int32), 0, GLB.nx - 1)
   iy = np.clip((GLB.py + np.sin(GLB.pa - sa) * d).astype(np.int32), 0, GLB.ny - 1)
   fr = tr[iy, ix]

   turn = np.where((fl > fc) & (fl > fr), f1,
                   np.where((fr > fc) & (fr > fl), -f1, 0.0))
   turn = turn + (np.random.random(GLB.n) - 0.5) * 0.25
   GLB.pa = GLB.pa + turn
   GLB.px = np.mod(GLB.px + np.cos(GLB.pa) * 1.4, GLB.nx)
   GLB.py = np.mod(GLB.py + np.sin(GLB.pa) * 1.4, GLB.ny)

   xi = GLB.px.astype(np.int32)
   yi = GLB.py.astype(np.int32)
   np.add.at(tr, (yi, xi), 1.0)
   GLB.trail = tr

   val = np.clip(tr * 0.9, 0.0, 1.0)
   bands = 22
   q = np.clip((val * bands).astype(np.int32), 0, bands - 1)
   pal = np.zeros((bands, 4), dtype=np.uint8)
   for bd in range(bands):
      t = bd / (bands - 1.0)
      if GLB.xmode:
         c = hsv_to_rgb((0.55 + t * 0.4) % 1.0, 0.9 - 0.6 * t, 0.05 + 0.95 * t)
      else:
         c = hsv_to_rgb((0.12 - t * 0.10) % 1.0, 0.95 - 0.7 * t, 0.05 + 0.95 * t)
      pal[bd][0] = int(c[2] * 255)
      pal[bd][1] = int(c[1] * 255)
      pal[bd][2] = int(c[0] * 255)
      pal[bd][3] = 255

   GLB.sv[:, :GLB.nx] = pal[q]
   if acc:
      GLB.sv[yi, xi] = [255, 255, 255, 255]
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
