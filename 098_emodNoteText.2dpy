def Init():
   # --- author : claude
   # --- a readout of what is actually arriving : note names and velocities
   # --- printed as they land, oldest scrolling away
   # --- note : screen y=0 is the BOTTOM, so text must be drawn y-flipped
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Scroll")
   STR.SetFParam1Name("Text Size")
   STR.SetFParam2Name("Hue")
   # ---    accent : show the raw slot table
   # ---    trigger : names <-> numbers

   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"

   GLB.names = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"]
   GLB.log = []
   GLB.prev = []
   for i in range(24):
      GLB.prev.append(0)
   GLB.scroll = 0.0

   def text(x, y, s):
      cr.save()
      cr.translate(x, y)
      cr.scale(1.0, -1.0)
      cr.move_to(0, 0)
      cr.show_text(s)
      cr.restore()
   GLB.text = text

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.2, 3.0)
   f1 = STR.F1mix(20.0, 44.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0

   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      if GLB.mode == "midi":
         if ids != 0 and GLB.prev[i] != ids:
            GLB.log.append([note, velo, i, 1.0])
         GLB.prev[i] = ids
      else:
         if velo > 74 and GLB.prev[i] <= 74:
            GLB.log.append([i, velo, i, 1.0])
         GLB.prev[i] = velo
   while len(GLB.log) > 34:
      del GLB.log[0]

   GLB.scroll = GLB.scroll + f0

   cr.set_source_rgb(0.03, 0.03, 0.04)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cr.select_font_face("mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
   size = f1
   cr.set_font_size(size)
   lh = size * 1.5

   base = hsv_to_rgb(f2, 0.6, 1.0)

   n = len(GLB.log)
   for k in range(n):
      e = GLB.log[n - 1 - k]
      y = 640.0 - k * lh
      if y < -lh:
         break
      d = 1.0 - k / 26.0
      if d < 0.12:
         d = 0.12
      if GLB.xmode:
         s = "%3d  vel %3d  slot %2d" % (e[0], e[1], e[2])
      else:
         s = "%-2s%-2d vel %3d  slot %2d" % (GLB.names[e[0] % 12], e[0] // 12,
                                             e[1], e[2])
      c = hsv_to_rgb((f2 + (e[0] % 12) / 12.0 * 0.5) % 1.0, 0.75, d)
      cr.set_source_rgb(c[2], c[1], c[0])
      GLB.text(90, y, s)
      # --- a velocity bar beside the line
      cr.set_source_rgba(c[2], c[1], c[0], 0.55)
      cr.rectangle(620, y, (e[1] / 127.0) * 560.0, size * 0.62)
      cr.fill()

   if acc:
      # --- the raw slot table down the right hand side
      cr.set_font_size(20)
      cr.set_source_rgb(base[2], base[1], base[0])
      GLB.text(980, 690, "id  note vel")
      for i in range(GLB.slots):
         (ids, note, velo) = STR.GetSlotData(i)
         if ids == 0:
            cr.set_source_rgba(base[2], base[1], base[0], 0.3)
         else:
            cr.set_source_rgb(1, 1, 1)
         GLB.text(980, 660 - i * 24, "%3d %4d %4d" % (ids, note, velo))
