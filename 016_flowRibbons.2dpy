def Init():
   # --- author : claude
   # --- a few hundred motes dragged through a curling flow field, each one
   # --- leaving a tapered ribbon behind it
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Fade")
   STR.SetFParam1Name("Flow Scale")
   STR.SetFParam2Name("Speed")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : ribbons turn to sparks
   # ---    trigger : scatter them all again

   GLB.n = 240
   GLB.hue = 0.0

   def scatter():
      GLB.px = np.random.random(GLB.n) * 1280.0
      GLB.py = np.random.random(GLB.n) * 720.0
      GLB.ox = GLB.px.copy()
      GLB.oy = GLB.py.copy()
      GLB.hh = np.random.random(GLB.n) * 0.25
   GLB.scatter = scatter
   GLB.scatter()

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.02, 0.30)
   f1 = STR.F1mix(0.0012, 0.010)
   f2 = STR.F2mix(1.0, 9.0)

   time = STR.IT() + STR.FT()

   if trig:
      GLB.scatter()
      GLB.xmode = 1 if GLB.xmode==0 else 0

   # --- clear screen
   cr.set_source_rgba(0,0,0,f0)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   GLB.hue = (GLB.hue + 0.0018) % 1.0

   GLB.ox = GLB.px.copy()
   GLB.oy = GLB.py.copy()

   # --- curl-ish field: the angle is a sum of two out of phase waves
   a = (np.sin(GLB.px * f1 + time * 0.7) +
        np.cos(GLB.py * f1 * 1.3 - time * 0.5)) * pi
   if GLB.xmode:
      a = a + np.arctan2(360.0 - GLB.py, 640.0 - GLB.px)

   GLB.px = GLB.px + np.cos(a) * f2
   GLB.py = GLB.py + np.sin(a) * f2

   # --- wrap, and lift the pen so wrapping does not draw a streak across
   wrapped = ((GLB.px < -5) | (GLB.px > 1285) | (GLB.py < -5) | (GLB.py > 725))
   GLB.px = np.mod(GLB.px, 1280.0)
   GLB.py = np.mod(GLB.py, 720.0)

   cr.set_line_cap(cairo.LINE_CAP_ROUND)
   px = GLB.px
   py = GLB.py
   ox = GLB.ox
   oy = GLB.oy
   hh = GLB.hh

   for i in range(GLB.n):
      if wrapped[i]:
         continue
      r,g,b = hsv_to_rgb((GLB.hue + hh[i]) % 1.0, 0.85, 1.0)
      cr.set_source_rgba(b, g, r, 0.85)
      if acc:
         cr.set_line_width(1.0)
         cr.move_to(px[i], py[i])
         cr.line_to(px[i] + 1, py[i] + 1)
      else:
         cr.set_line_width(1.0 + 3.0 * hh[i] * 4.0)
         cr.move_to(ox[i], oy[i])
         cr.line_to(px[i], py[i])
      cr.stroke()
