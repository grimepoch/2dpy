def Init():
   # --- author : claude
   # --- bloom done properly : the bright pass is rendered into an offscreen
   # --- group, then composited back over itself several times at low alpha
   # --- and growing scale, which reads as a glow without a blur kernel
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Bloom")
   STR.SetFParam1Name("Orbs")
   STR.SetFParam2Name("Speed")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : orbs trail
   # ---    trigger : rescatter

   GLB.nmax = 22

   def scatter():
      GLB.px = np.random.random(GLB.nmax) * 1280.0
      GLB.py = np.random.random(GLB.nmax) * 720.0
      GLB.vx = (np.random.random(GLB.nmax) - 0.5) * 5.0
      GLB.vy = (np.random.random(GLB.nmax) - 0.5) * 5.0
      GLB.rr = 14.0 + np.random.random(GLB.nmax) * 34.0
      GLB.hu = np.random.random(GLB.nmax)
   GLB.scatter = scatter
   GLB.scatter()
   GLB.fr = 0

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0, 0.9)
   f1 = STR.F1mix(3.0, 22.0)
   f2 = STR.F2mix(0.1, 2.4)

   time = STR.IT() + STR.FT()

   if trig:
      GLB.scatter()
      GLB.xmode = 1 if GLB.xmode==0 else 0

   GLB.fr = GLB.fr + 1
   if acc:
      if GLB.fr % 2 == 0:
         cr.set_source_rgba(0, 0, 0, 0.26)
         cr.rectangle(0,0,1280,720)
         cr.fill()
   else:
      cr.set_source_rgb(0.01, 0.01, 0.02)
      cr.rectangle(0,0,1280,720)
      cr.fill()

   n = int(f1)
   GLB.px[:n] = GLB.px[:n] + GLB.vx[:n] * f2
   GLB.py[:n] = GLB.py[:n] + GLB.vy[:n] * f2
   GLB.vx[:n] = np.where((GLB.px[:n] < 30) | (GLB.px[:n] > 1250), -GLB.vx[:n], GLB.vx[:n])
   GLB.vy[:n] = np.where((GLB.py[:n] < 30) | (GLB.py[:n] > 690), -GLB.vy[:n], GLB.vy[:n])
   GLB.px[:n] = np.clip(GLB.px[:n], 30, 1250)
   GLB.py[:n] = np.clip(GLB.py[:n], 30, 690)

   lx = GLB.px.tolist()
   ly = GLB.py.tolist()
   lr = GLB.rr.tolist()
   lh = GLB.hu.tolist()

   # --- the bright pass, into its own group
   cr.push_group()
   for i in range(n):
      r,g,b = hsv_to_rgb((lh[i] * (0.9 if GLB.xmode else 0.3) + time * 0.03) % 1.0, 0.75, 1.0)
      rad = lr[i] * (1.0 + 0.18 * sin(time * 1.7 + i))
      rg = cairo.RadialGradient(lx[i], ly[i], 0, lx[i], ly[i], rad)
      rg.add_color_stop_rgba(0.0, b, g, r, 1.0)
      rg.add_color_stop_rgba(0.55, b, g, r, 0.65)
      rg.add_color_stop_rgba(1.0, b, g, r, 0.0)
      cr.set_source(rg)
      cr.rectangle(lx[i] - rad, ly[i] - rad, rad * 2, rad * 2)
      cr.fill()
   cr.pop_group_to_source()

   # --- composite it back a few times, each pass scaled up a little
   cr.save()
   cr.paint()
   if f0 > 0.02:
      for k in range(2):
         s = 1.0 + (k + 1) * 0.05 * (0.4 + f0)
         cr.save()
         cr.translate(640, 360)
         cr.scale(s, s)
         cr.translate(-640, -360)
         cr.paint_with_alpha(f0 * (0.38 - k * 0.11))
         cr.restore()
   cr.restore()
