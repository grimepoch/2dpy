def Init():
   # --- author : claude
   # --- words rushing at the camera and past it, scaled by their depth so
   # --- they arrive out of nothing and blow through the frame
   # --- note : screen y=0 is the BOTTOM, so text must be drawn y-flipped
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Speed")
   STR.SetFParam1Name("Spread")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : outline only
   # ---    trigger : tumble them

   GLB.words = ["SIGNAL","FRAME","CLOCK","PHASE","NOISE","GAIN","LOOP","EDGE",
                "DRIFT","PULSE","SCAN","GRAIN","BLOOM","SHIFT","BEAT","RASTER",
                "GLOW","SYNC","FIELD","TRACE"]
   GLB.n = 14

   def spawn(i, z):
      GLB.w[i] = np.random.randint(0, len(GLB.words))
      GLB.z[i] = z
      GLB.ox[i] = (np.random.random() - 0.5) * 2.0
      GLB.oy[i] = (np.random.random() - 0.5) * 2.0
      GLB.rot[i] = (np.random.random() - 0.5) * 0.8
      GLB.hu[i] = np.random.random()
   GLB.spawn = spawn

   GLB.w = [0] * GLB.n
   GLB.z = [0.0] * GLB.n
   GLB.ox = [0.0] * GLB.n
   GLB.oy = [0.0] * GLB.n
   GLB.rot = [0.0] * GLB.n
   GLB.hu = [0.0] * GLB.n
   for i in range(GLB.n):
      GLB.spawn(i, 0.06 + (i / (GLB.n * 1.0)) * 1.6)

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.004, 0.05)
   f1 = STR.F1mix(60.0, 620.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0

   cr.set_source_rgb(0.03, 0.02, 0.04)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cr.select_font_face("sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)

   # --- draw far to near so nearer words cover the ones behind
   order = []
   for i in range(GLB.n):
      order.append([GLB.z[i], i])
   order.sort()
   order.reverse()

   for it in order:
      i = it[1]
      GLB.z[i] = GLB.z[i] - f0
      if GLB.z[i] < 0.05:
         GLB.spawn(i, 1.7)
         continue

      k = 1.0 / GLB.z[i]
      size = 22.0 * k
      if size > 900:
         continue
      x = 640 + GLB.ox[i] * f1 * k
      y = 360 + GLB.oy[i] * f1 * k * 0.56
      if x < -900 or x > 2180 or y < -700 or y > 1420:
         continue

      # --- fade in from the far plane, out as it passes
      a = 1.0
      if GLB.z[i] > 1.3:
         a = (1.7 - GLB.z[i]) / 0.4
      if GLB.z[i] < 0.18:
         a = GLB.z[i] / 0.18
      if a <= 0:
         continue

      s = GLB.words[GLB.w[i]]
      cr.set_font_size(size)
      e = cr.text_extents(s)
      r,g,b = hsv_to_rgb((GLB.hu[i] * 0.3 + f2) % 1.0, 0.7, 1.0)

      cr.save()
      cr.translate(x, y)
      if GLB.xmode:
         cr.rotate(GLB.rot[i] + time * 0.3)
      else:
         cr.rotate(GLB.rot[i] * (1.0 - GLB.z[i]))
      cr.scale(1.0, -1.0)
      cr.move_to(-e.width * 0.5 - e.x_bearing, e.height * 0.5)
      if acc:
         cr.text_path(s)
         cr.restore()
         cr.set_source_rgba(b, g, r, a)
         cr.set_line_width(1.0 + size * 0.02)
         cr.stroke()
      else:
         cr.set_source_rgba(b, g, r, a)
         cr.show_text(s)
         cr.restore()
