def Init():
   # --- author : claude
   # --- the incoming levels wrapped into a circle, read as a closed waveform
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Fade")
   STR.SetFParam1Name("Depth")
   STR.SetFParam2Name("Smoothing")
   # ---    accent : mirror it inward
   # ---    trigger : line <-> filled band

   # --- 10 slots = FFT analysis bins, 24 slots = MIDI notes
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"

   GLB.lanes = 12 if GLB.slots == 24 else GLB.slots
   GLB.lvl = []
   for i in range(GLB.lanes):
      GLB.lvl.append(0.0)
   GLB.steps = 180
   GLB.rot = 0.0

   def sample(u):
      # --- periodic cosine interpolation between lane centres, so the ring
      # --- closes on itself with no seam
      n = GLB.lanes
      p = u * n
      i0 = int(floor(p)) % n
      i1 = (i0 + 1) % n
      t = p - floor(p)
      t = 0.5 - 0.5 * cos(t * pi)
      return GLB.lvl[i0] * (1.0 - t) + GLB.lvl[i1] * t
   GLB.sample = sample

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.05, 0.75)
   f1 = STR.F1mix(30.0, 230.0)
   f2 = STR.F2mix(0.55, 0.97)

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0

   # --- clear screen
   cr.set_source_rgba(0,0,0,f0)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   n = GLB.lanes
   for k in range(n):
      GLB.lvl[k] = GLB.lvl[k] * f2

   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      if ids == 0:
         continue
      k = (note % 12) if GLB.mode == "midi" else i
      if k < n:
         v = velo / 127.0
         if v > GLB.lvl[k]:
            GLB.lvl[k] = v

   GLB.rot = GLB.rot + 0.006
   base = 170.0 + 20.0 * sin(time * 0.7)
   steps = GLB.steps

   cr.save()
   cr.translate(640, 360)
   cr.rotate(GLB.rot)

   r1,g1,b1 = hsv_to_rgb((time * 0.04) % 1.0, 0.85, 1.0)
   r2,g2,b2 = hsv_to_rgb((time * 0.04 + 0.35) % 1.0, 0.9, 1.0)

   # --- outer trace
   cr.new_path()
   for s in range(steps + 1):
      u = (s % steps) / (steps * 1.0)
      a = u * 2.0 * pi
      r = base + f1 * GLB.sample(u)
      x = cos(a) * r
      y = sin(a) * r
      if s == 0:
         cr.move_to(x, y)
      else:
         cr.line_to(x, y)
   cr.close_path()

   if GLB.xmode:
      # --- close the band back along the base circle and fill between
      for s in range(steps, -1, -1):
         u = (s % steps) / (steps * 1.0)
         a = u * 2.0 * pi
         x = cos(a) * base
         y = sin(a) * base
         cr.line_to(x, y)
      lg = cairo.LinearGradient(-400, 0, 400, 0)
      lg.add_color_stop_rgba(0.0, b1, g1, r1, 0.85)
      lg.add_color_stop_rgba(1.0, b2, g2, r2, 0.85)
      cr.set_source(lg)
      cr.fill()
   else:
      cr.set_source_rgb(b1, g1, r1)
      cr.set_line_width(3)
      cr.stroke()

   if acc:
      # --- and the same wave folded inward
      cr.new_path()
      for s in range(steps + 1):
         u = (s % steps) / (steps * 1.0)
         a = u * 2.0 * pi
         r = base - f1 * GLB.sample(u) * 0.6
         if r < 8:
            r = 8
         x = cos(a) * r
         y = sin(a) * r
         if s == 0:
            cr.move_to(x, y)
         else:
            cr.line_to(x, y)
      cr.close_path()
      cr.set_source_rgb(b2, g2, r2)
      cr.set_line_width(2)
      cr.stroke()

   cr.restore()
