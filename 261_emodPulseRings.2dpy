def Init():
   # --- author : claude
   # --- every hit throws a ring, and the rings are never redrawn - they are
   # --- pushed outward through the canvas itself by resampling the previous
   # --- frame slightly larger each time.  The expansion is what makes them
   # --- thin and fade as they go, which is not something a redrawn circle
   # --- does on its own.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Expansion")
   STR.SetFParam1Name("Persistence")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : the field inverts and rings collapse inward
   # ---    trigger : move the origin

   GLB.buf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1280, 720)
   GLB.bcr = cairo.Context(GLB.buf)
   GLB.st = surface.get_stride() // 4
   GLB.prev = np.zeros(GLB.slots, dtype=np.float32)
   GLB.ox = 640.0
   GLB.oy = 360.0

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(1.004, 1.045)
   f1 = STR.F1mix(5.0, 8.0)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.ox = np.random.random() * 900.0 + 190.0
      GLB.oy = np.random.random() * 520.0 + 100.0
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   GLB.bcr.set_operator(cairo.OPERATOR_SOURCE)
   GLB.bcr.set_source_surface(surface, 0, 0)
   GLB.bcr.paint()

   z = f0
   if acc:
      z = 2.0 - f0
   cr.save()
   cr.translate(GLB.ox, GLB.oy)
   cr.scale(z, z)
   cr.translate(-GLB.ox, -GLB.oy)
   cr.set_source_surface(GLB.buf, 0, 0)
   cr.get_source().set_filter(cairo.FILTER_NEAREST)
   cr.paint()
   cr.restore()

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   # --- expansion spreads the same light over z^2 the area, so the loss has
   # --- to rise with the zoom or the screen washes out
   np.subtract(v, np.right_shift(v, int(f1)), out=v)
   if z > 1.02:
      np.subtract(v, np.right_shift(v, 5), out=v)
   v[:, :, 3] = 255
   surface.mark_dirty()

   for i in range(GLB.slots):
      d = STR.GetSlotData(i)
      vel = d[2] * 1.0
      if d[0] != 0 and vel > GLB.prev[i] + 5.0:
         n = int(d[1])
         c = hsv_to_rgb((f2 + (n % 12) / 12.0) % 1.0, 0.80, 1.0)
         cr.set_source_rgb(c[2], c[1], c[0])
         cr.set_line_width(2.0 + (vel / 127.0) * 7.0)
         r = 12.0 + (n % 36) * 2.4
         cr.new_sub_path()
         cr.arc(GLB.ox, GLB.oy, r, 0, 6.2831853)
         cr.stroke()
      GLB.prev[i] = vel
