def Init():
   # --- author : claude
   # --- a rubber lattice with one pressure point per slot; loud slots push
   # --- the mesh out of shape around their anchor
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Grid")
   STR.SetFParam1Name("Push")
   STR.SetFParam2Name("Reach")
   # ---    accent : draw the anchors
   # ---    trigger : push out <-> pull in

   # --- 10 slots = FFT analysis bins, 24 slots = MIDI notes
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"

   GLB.lanes = 12 if GLB.slots == 24 else GLB.slots
   GLB.lvl = []
   GLB.ax = []
   GLB.ay = []
   for k in range(GLB.lanes):
      GLB.lvl.append(0.0)
      a = k * 2.0 * pi / GLB.lanes
      GLB.ax.append(640.0 + 330.0 * cos(a))
      GLB.ay.append(360.0 + 210.0 * sin(a))

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(8.0, 26.0)
   f1 = STR.F1mix(20.0, 190.0)
   f2 = STR.F2mix(90.0, 400.0)

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0

   cr.set_source_rgb(0.02, 0.01, 0.03)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   n = GLB.lanes
   for k in range(n):
      GLB.lvl[k] = GLB.lvl[k] * 0.90

   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      if ids == 0:
         continue
      k = (note % 12) if GLB.mode == "midi" else i
      if k < n:
         v = velo / 127.0
         if v > GLB.lvl[k]:
            GLB.lvl[k] = v

   sgn = -1.0 if GLB.xmode else 1.0
   nx = int(f0)
   ny = int(nx * 720.0 / 1280.0) + 1
   r2 = f2 * f2

   # --- displace every vertex once, then draw the lattice from the cache
   vx = []
   vy = []
   for j in range(ny + 1):
      rowx = []
      rowy = []
      for i in range(nx + 1):
         x = i * 1280.0 / nx
         y = j * 720.0 / ny
         dx = 0.0
         dy = 0.0
         for k in range(n):
            v = GLB.lvl[k]
            if v < 0.02:
               continue
            ex = x - GLB.ax[k]
            ey = y - GLB.ay[k]
            d2 = ex * ex + ey * ey
            if d2 > r2:
               continue
            d = sqrt(d2) + 0.001
            fall = 1.0 - d / f2
            push = sgn * f1 * v * fall * fall / d
            dx = dx + ex * push
            dy = dy + ey * push
         rowx.append(x + dx)
         rowy.append(y + dy)
      vx.append(rowx)
      vy.append(rowy)

   cr.set_line_width(1.4)
   r,g,b = hsv_to_rgb((time * 0.05) % 1.0, 0.7, 1.0)
   cr.set_source_rgba(b, g, r, 0.9)

   for j in range(ny + 1):
      cr.move_to(vx[j][0], vy[j][0])
      for i in range(1, nx + 1):
         cr.line_to(vx[j][i], vy[j][i])
   for i in range(nx + 1):
      cr.move_to(vx[0][i], vy[0][i])
      for j in range(1, ny + 1):
         cr.line_to(vx[j][i], vy[j][i])
   cr.stroke()

   if acc:
      for k in range(n):
         v = GLB.lvl[k]
         rr,gg,bb = hsv_to_rgb((k / (n * 1.0)) % 1.0, 0.85, 1.0)
         cr.set_source_rgba(bb, gg, rr, 0.35 + 0.65 * v)
         cr.new_sub_path()
         cr.arc(GLB.ax[k], GLB.ay[k], 5 + 22 * v, 0, 2 * pi)
         cr.fill()
