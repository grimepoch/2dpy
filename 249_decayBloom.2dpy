def Init():
   # --- author : claude
   # --- bloom by dilation : every frame the standing image is spread by one
   # --- pixel in each direction with a running maximum, then decayed, so
   # --- bright marks swell and bleed outward before they die
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Spread")
   STR.SetFParam1Name("Decay")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : spread upward only, like heat
   # ---    trigger : new emitter pattern

   GLB.st = surface.get_stride() // 4
   GLB.kind = 0
   GLB.fr = 0

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0()
   f1 = STR.F1mix(2.0, 6.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.kind = (GLB.kind + 1) % 3
      GLB.xmode = 1 if GLB.xmode==0 else 0

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8, buffer=surface.get_data())

   # --- dilate: a running maximum against a shifted copy of itself.  This is
   # --- what makes light bleed rather than just fade.
   # --- a dilate pass costs ~5ms, so alternate which direction runs on which
   # --- frame; over two frames the bleed is isotropic anyway
   GLB.fr = GLB.fr + 1
   if f0 > 0.15:
      if GLB.fr % 2 == 0:
         np.maximum(v[:-1], v[1:], out=v[:-1])
         if f0 > 0.6 and not acc:
            np.maximum(v[1:], v[:-1], out=v[1:])
      else:
         np.maximum(v[:, :-1], v[:, 1:], out=v[:, :-1])
         if f0 > 0.6:
            np.maximum(v[:, 1:], v[:, :-1], out=v[:, 1:])

   np.subtract(v, np.right_shift(v, int(f1)), out=v)
   v[:, :, 3] = 255
   surface.mark_dirty()

   # --- emitters
   c = hsv_to_rgb((f2 + time * 0.05) % 1.0, 0.8, 1.0)
   cr.set_source_rgb(c[2], c[1], c[0])
   if GLB.kind == 0:
      for k in range(5):
         a = time * 0.8 + k * 1.256
         cr.new_sub_path()
         cr.arc(640 + 340 * cos(a), 360 + 230 * sin(a * 1.3), 9, 0, 2 * pi)
      cr.fill()
   elif GLB.kind == 1:
      cr.set_line_width(5)
      cr.move_to(200, 360 + 200 * sin(time))
      for i in range(1, 22):
         u = i / 21.0
         cr.line_to(200 + u * 880, 360 + 200 * sin(time + u * 5.0))
      cr.stroke()
   else:
      for k in range(9):
         u = (k + 0.5) / 9.0
         h = 90 + 220 * (0.5 + 0.5 * sin(time * 1.6 + k))
         cr.rectangle(u * 1280 - 10, 40, 20, h)
      cr.fill()
