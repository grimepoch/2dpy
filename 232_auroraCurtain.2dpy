def Init():
   # --- author : claude
   # --- aurora.  The curtain is drawn thin and bright, then the canvas is
   # --- smeared upward and dimmed every frame - the visible glow is almost
   # --- entirely made of where the curtain USED to be, which is how the real
   # --- thing looks when it moves.
   # --- note : screen y=0 is the BOTTOM, so "up" is toward row 719
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Substorm")
   STR.SetFParam1Name("Persistence")
   STR.SetFParam2Name("Altitude")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : the curtain breaks into rays
   # ---    trigger : new field line

   GLB.st = surface.get_stride() // 4
   GLB.ph = np.random.random(7) * 6.283
   GLB.fr = np.random.random(7) * 0.006 + 0.0012
   GLB.parity = 0

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.2, 1.0)
   f1 = STR.F1mix(4.0, 7.0)
   f2 = STR.F2mix(90.0, 330.0)
   time = STR.IT() + STR.FT()

   if trig:
      GLB.ph = np.random.random(7) * 6.283
      GLB.fr = np.random.random(7) * 0.006 + 0.0012
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   np.subtract(v, np.right_shift(v, int(f1)), out=v)
   GLB.parity = GLB.parity + 1
   # --- the glow climbs the sky
   v[2:] = v[:-2]
   v[0:2] = 0
   # --- alternating sides : a dilate that always writes into the left slice
   # --- walks the whole image leftward a pixel a frame
   if GLB.parity % 4 == 0:
      np.maximum(v[:, :-1], v[:, 1:], out=v[:, :-1])
   elif GLB.parity % 4 == 2:
      np.maximum(v[:, 1:], v[:, :-1], out=v[:, 1:])
   v[:, :, 3] = 255
   surface.mark_dirty()

   # --- the base of the curtain, a wandering line across the sky
   npt = 160
   cr.set_line_width(2.2)
   for c in range(3):
      base = 330.0 + c * 46.0
      for i in range(npt):
         x = i * (1280.0 / npt)
         y = base
         for k in range(7):
            y = y + sin(x * GLB.fr[k] + time * (0.4 + k * 0.13) +
                        GLB.ph[k] + c) * (16.0 + k * 3.0)
         hh = 0.30 + 0.14 * sin(x * 0.004 + time * 0.3) + 0.06 * c
         br = f0 * (0.55 + 0.45 * sin(x * 0.01 + time * 1.7 + c))
         if acc:
            # --- broken into discrete rays
            if (int(x * 0.12 + time * 6.0) % 3) != 0:
               continue
         col = hsv_to_rgb(hh % 1.0, 0.85, min(br, 1.0))
         cr.set_source_rgb(col[2], col[1], col[0])
         cr.move_to(x, y)
         cr.line_to(x, y + f2 * (0.5 + 0.5 * sin(x * 0.007 + time)))
         cr.stroke()
