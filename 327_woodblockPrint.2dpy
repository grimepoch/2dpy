def Init():
   # --- author : claude
   # --- a multi-block print, pulled one colour at a time.  Each block is
   # --- laid over the last and the registration is never perfect, so the
   # --- colours creep out from behind their outlines the way an old
   # --- ukiyo-e does.  Nothing is cleaned off between pulls.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Pulls")
   STR.SetFParam1Name("Misregister")
   STR.SetFParam2Name("Palette")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : bokashi, the block is inked as a gradient
   # ---    trigger : carve new blocks

   GLB.st = surface.get_stride() // 4
   GLB.tick = 0

   def carve():
      n = 5
      GLB.n = n
      GLB.bp = np.random.random((n, 5)) * 6.283
      GLB.bh = np.random.random(n)
      GLB.tick = 0
      cr.set_source_rgb(0.72, 0.80, 0.86)
      cr.rectangle(0, 0, 1280, 720)
      cr.fill()
   GLB.carve = carve
   GLB.carve()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.05, 0.9)
   f1 = STR.F1mix(0.0, 14.0)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.carve()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   # --- the paper yellows very slowly under everything
   np.subtract(v, np.right_shift(v, 10), out=v)
   v[:, :, 3] = 255
   surface.mark_dirty()

   GLB.tick = GLB.tick + 1
   if GLB.tick > 130:
      GLB.carve()

   if np.random.random() > f0:
      return

   b = np.random.randint(GLB.n)
   ph = GLB.bp[b]
   ox = (np.random.random() - 0.5) * f1
   oy = (np.random.random() - 0.5) * f1
   c = hsv_to_rgb((GLB.bh[b] + f2) % 1.0, 0.62, 0.88)
   if acc:
      # --- bokashi : the block is wiped from full colour to nothing
      g = cairo.LinearGradient(0, 0, 0, 720)
      g.add_color_stop_rgba(0.0, c[2], c[1], c[0], 0.80)
      g.add_color_stop_rgba(1.0, c[2], c[1], c[0], 0.04)
      cr.set_source(g)
   else:
      cr.set_source_rgba(c[2], c[1], c[0], 0.42)

   # --- the shape cut into this block : a closed curve, so it prints as a
   # --- flat area of colour the way a real block does
   cr.save()
   cr.translate(640 + ox, 360 + oy)
   npt = 34
   for i in range(npt + 1):
      a = i * 6.2831853 / npt
      r = 190.0
      for k in range(5):
         r = r + sin(a * (k + 1.0) + ph[k] + time * 0.04) * (52.0 / (k + 1))
      x = cos(a) * r
      y = sin(a) * r * 0.74
      if i == 0:
         cr.move_to(x, y)
      else:
         cr.line_to(x, y)
   cr.close_path()
   cr.fill()
   cr.restore()

   # --- the key block, the black outline, pulled last and always a touch off
   if np.random.random() < 0.30:
      cr.save()
      cr.translate(640 + ox * 0.4, 360 + oy * 0.4)
      cr.set_source_rgba(0.10, 0.09, 0.08, 0.75)
      cr.set_line_width(3.4)
      for i in range(npt + 1):
         a = i * 6.2831853 / npt
         r = 190.0
         for k in range(5):
            r = r + sin(a * (k + 1.0) + ph[k] + time * 0.04) * (52.0 / (k + 1))
         x = cos(a) * r
         y = sin(a) * r * 0.74
         if i == 0:
            cr.move_to(x, y)
         else:
            cr.line_to(x, y)
      cr.close_path()
      cr.stroke()
      cr.restore()
