def Init():
   # --- author : claude
   # --- demoscene plasma, quantised to chunky blocks and evaluated with numpy
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Block Size")
   STR.SetFParam1Name("Zoom")
   STR.SetFParam2Name("Palette")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : posterise to 4 colours
   # ---    trigger : smooth <-> banded palette

   GLB.bs = 0
   GLB.gx = None
   GLB.gy = None

   def build(bs):
      # --- cache the coordinate grids, they only change with the block size
      nx = int(1280 / bs) + 1
      ny = int(720 / bs) + 1
      GLB.nx = nx
      GLB.ny = ny
      xs = np.arange(nx) * bs
      ys = np.arange(ny) * bs
      GLB.gx = np.tile(xs.reshape(1, nx), (ny, 1)).astype(np.float32)
      GLB.gy = np.tile(ys.reshape(ny, 1), (1, nx)).astype(np.float32)
      GLB.bs = bs
   GLB.build = build

   GLB.build(32)

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(10.0, 64.0)
   f1 = STR.F1mix(0.004, 0.02)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0

   bs = int(f0)
   if bs < 10:
      bs = 10
   if bs != GLB.bs:
      GLB.build(bs)

   x = GLB.gx * f1
   y = GLB.gy * f1

   # --- classic three-term plasma
   v = (np.sin(x + time * 1.3) +
        np.sin(y * 0.8 - time * 0.9) +
        np.sin((x + y) * 0.5 + time * 0.6) +
        np.sin(np.sqrt((x - 640 * f1) ** 2 + (y - 360 * f1) ** 2) * 1.4 - time * 2.0))
   v = (v + 4.0) * 0.125                       # --- into 0..1

   if GLB.xmode:
      v = np.floor(v * 7.0) / 7.0
   if acc:
      v = np.floor(v * 4.0) / 4.0

   # --- a second, slower field shades the plasma so it is not flat neon
   vv = 0.55 + 0.45 * (0.5 + 0.5 * np.sin((x - y) * 0.7 + time * 0.45))
   ss = 0.88

   hue = (v + f2) % 1.0
   # --- HSV with S=1,V=1 straight to RGB, vectorised
   h6 = hue * 6.0
   i  = np.floor(h6)
   fr = h6 - i
   p  = np.zeros_like(v)
   q  = 1.0 - fr
   sel = i.astype(np.int32) % 6
   r = np.choose(sel, [1.0 + p, q,       p,       p,       fr,      1.0 + p])
   g = np.choose(sel, [fr,      1.0 + p, 1.0 + p, q,       p,       p])
   b = np.choose(sel, [p,       p,       fr,      1.0 + p, 1.0 + p, q])

   # --- fold saturation and value back in
   r = vv * (1.0 - ss) + ss * vv * r
   g = vv * (1.0 - ss) + ss * vv * g
   b = vv * (1.0 - ss) + ss * vv * b

   bsf = bs + 1
   for j in range(GLB.ny):
      rr = r[j]
      gg = g[j]
      bb = b[j]
      yy = j * bs
      for k in range(GLB.nx):
         cr.set_source_rgb(bb[k], gg[k], rr[k])
         cr.rectangle(k * bs, yy, bsf, bsf)
         cr.fill()
