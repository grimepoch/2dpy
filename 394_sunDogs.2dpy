def Init():
   # --- author : claude
   # --- ice halos.  Hexagonal plate crystals drifting flat in the air bend
   # --- light through sixty degrees, so a ring appears twenty two degrees
   # --- from the sun, with bright dogs either side of it and an arc sitting
   # --- on top.  The sun climbs and sets, and which halos are possible
   # --- changes with it, so the display keeps rearranging.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Sun Height")
   STR.SetFParam1Name("Crystals")
   STR.SetFParam2Name("Air")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : columns as well as plates, more arcs appear
   # ---    trigger : new crystal population

   GLB.st = surface.get_stride() // 4
   GLB.t = 0.0

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0, 1.0)
   f1 = STR.F1mix(0.15, 1.0)
   f2 = STR.F2mix(0.0, 1.0)
   time = STR.IT() + STR.FT()

   if trig:
      GLB.t = np.random.random() * 10.0
      GLB.xmode = 1 if GLB.xmode == 0 else 0
   GLB.t = GLB.t + 0.004

   # --- the sky, darker overhead
   g = cairo.LinearGradient(0, 0, 0, 720)
   g.add_color_stop_rgb(0.0, 0.55 + f2 * 0.25, 0.34, 0.16)
   g.add_color_stop_rgb(1.0, 0.42, 0.20, 0.08)
   cr.set_source(g)
   cr.rectangle(0, 0, 1280, 720)
   cr.fill()

   sunx = 640.0
   suny = 560.0 - f0 * 330.0
   R22 = 175.0

   cr.set_line_width(2.0 + f1 * 3.0)
   # --- the twenty two degree ring : red inside, because red is bent least
   for k in range(22):
      wl = k / 21.0
      c = hsv_to_rgb(0.02 + wl * 0.14, 0.85 - wl * 0.5, 1.0)
      cr.set_source_rgba(c[2], c[1], c[0], 0.10 * f1)
      cr.new_sub_path()
      cr.arc(sunx, suny, R22 + wl * 26.0, 0, 6.2831853)
      cr.stroke()

   # --- the parhelia, on the ring level with the sun.  They move further
   # --- out as the sun rises, which is why they only look right low down.
   spread = 1.0 + f0 * 0.55
   for sgn in (-1.0, 1.0):
      px = sunx + sgn * R22 * spread
      for k in range(16):
         wl = k / 15.0
         c = hsv_to_rgb(0.02 + wl * 0.14, 0.85 - wl * 0.5, 1.0)
         cr.set_source_rgba(c[2], c[1], c[0], 0.16 * f1)
         cr.save()
         cr.translate(px + sgn * wl * 26.0, suny)
         cr.scale(0.55, 1.0)
         cr.new_sub_path()
         cr.arc(0, 0, 26.0 - wl * 9.0, 0, 6.2831853)
         cr.restore()
         cr.fill()

   # --- the circumzenithal arc, only possible when the sun is low
   cza = max(0.0, 1.0 - f0 * 1.6)
   if cza > 0.02:
      for k in range(18):
         wl = k / 17.0
         c = hsv_to_rgb(0.02 + wl * 0.55, 0.9, 1.0)
         cr.set_source_rgba(c[2], c[1], c[0], 0.16 * cza * f1)
         cr.new_sub_path()
         cr.arc(sunx, suny - R22 * 2.4 - wl * 16.0,
                R22 * 1.15, 3.6652, 5.7596)
         cr.stroke()

   if acc:
      # --- the parhelic circle, a white band all the way round at sun height
      cr.set_source_rgba(0.92, 0.96, 1.0, 0.22 * f1)
      cr.set_line_width(5.0)
      cr.move_to(0, suny)
      cr.line_to(1280, suny)
      cr.stroke()
      # --- and the upper tangent arc riding on the ring
      cr.set_source_rgba(0.9, 0.94, 1.0, 0.25 * f1)
      cr.new_sub_path()
      cr.arc(sunx, suny - R22 * 0.2, R22 * 1.1, 3.54, 5.88)
      cr.stroke()

   cr.set_source_rgb(0.75, 0.92, 1.0)
   cr.new_sub_path()
   cr.arc(sunx, suny, 15.0, 0, 6.2831853)
   cr.fill()
