def Init():
   # --- author : claude
   # --- marbling driven by the material : every note drops ink into the bath
   # --- and displaces everything already floating there
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Rake")
   STR.SetFParam1Name("Drop Size")
   STR.SetFParam2Name("Hue")
   # ---    accent : comb across instead of down
   # ---    trigger : fresh bath

   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"

   GLB.pts = 70
   GLB.maxd = 20
   GLB.th = np.linspace(0.0, 2.0 * pi, GLB.pts)
   GLB.drops = []
   GLB.prev = []
   for i in range(24):
      GLB.prev.append(0)

   def drop(cx, cy, r, hue):
      # --- the area preserving displacement a real ink drop makes
      for d in GLB.drops:
         dx = d[0] - cx
         dy = d[1] - cy
         d2 = dx * dx + dy * dy
         d2 = np.where(d2 < 1.0, 1.0, d2)
         k = np.sqrt(1.0 + (r * r) / d2)
         d[0] = cx + dx * k
         d[1] = cy + dy * k
      GLB.drops.append([cx + np.cos(GLB.th) * r, cy + np.sin(GLB.th) * r, hue])
      while len(GLB.drops) > GLB.maxd:
         del GLB.drops[0]
   GLB.drop = drop

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0, 30.0)
   f1 = STR.F1mix(30.0, 130.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.drops = []
      GLB.xmode = 1 if GLB.xmode==0 else 0

   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      fire = 0
      if GLB.mode == "midi":
         if ids != 0 and GLB.prev[i] != ids:
            fire = 1
            hue = (note % 12) / 12.0
         GLB.prev[i] = ids
      else:
         if velo > 78 and GLB.prev[i] <= 78:
            fire = 1
            hue = i / (GLB.slots * 1.0)
         GLB.prev[i] = velo
      if fire:
         v = velo / 127.0
         GLB.drop(200.0 + np.random.random() * 880.0,
                  140.0 + np.random.random() * 440.0,
                  f1 * (0.4 + v), hue)

   amp = f0
   if amp > 0.05:
      ph = time * 1.3
      for d in GLB.drops:
         if acc:
            d[0] = d[0] + amp * 0.09 * np.sin(d[1] * 0.021 + ph)
         else:
            d[1] = d[1] + amp * 0.09 * np.sin(d[0] * 0.016 + ph)

   cr.set_source_rgb(0.93, 0.92, 0.88)
   if GLB.xmode:
      cr.set_source_rgb(0.05, 0.04, 0.06)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   for d in GLB.drops:
      xs = d[0].tolist()
      ys = d[1].tolist()
      r,g,b = hsv_to_rgb((d[2] * 0.8 + f2) % 1.0, 0.82, 0.95)
      cr.set_source_rgb(b, g, r)
      cr.move_to(xs[0], ys[0])
      for i in range(1, GLB.pts):
         cr.line_to(xs[i], ys[i])
      cr.close_path()
      cr.fill()
