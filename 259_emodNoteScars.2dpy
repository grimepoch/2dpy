def Init():
   # --- author : claude
   # --- notes cut into the surface and the surface heals.  Each hit carves a
   # --- dark scar; every frame the whole field is run through a diffusion
   # --- pass, so old scars close over while fresh ones stay sharp.  Nothing
   # --- is ever cleared - what you see is the scar tissue.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Cut Depth")
   STR.SetFParam1Name("Healing")
   STR.SetFParam2Name("Skin")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : the skin flushes
   # ---    trigger : new skin

   GLB.res = 4
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   yy, xx = np.meshgrid(np.arange(GLB.ny), np.arange(GLB.nx), indexing="ij")
   GLB.iy = yy.astype(np.float32)
   GLB.ix = xx.astype(np.float32)
   GLB.s = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   GLB.prev = np.zeros(GLB.slots, dtype=np.float32)
   GLB.grain = (np.sin(GLB.ix * 0.21 + GLB.iy * 0.13) * 0.5 +
                np.sin(GLB.iy * 0.37) * 0.5)

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.3, 1.0)
   f1 = STR.F1mix(0.02, 0.24)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.s = GLB.s * 0.0
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   s = GLB.s
   k = f1
   s[1:] = s[1:] + (s[:-1] - s[1:]) * k
   s[:-1] = s[:-1] + (s[1:] - s[:-1]) * k
   s[:, 1:] = s[:, 1:] + (s[:, :-1] - s[:, 1:]) * k
   s[:, :-1] = s[:, :-1] + (s[:, 1:] - s[:, :-1]) * k
   s = s * 0.994

   for i in range(GLB.slots):
      d = STR.GetSlotData(i)
      vel = d[2] * 1.0
      if d[0] != 0 and vel > GLB.prev[i] + 5.0:
         # --- the note picks where, the velocity picks how deep
         n = int(d[1])
         a = (n % 24) * 0.2618 + time * 0.13
         rr = 0.18 + ((n // 24) % 5) * 0.17
         cx = GLB.nx * (0.5 + 0.44 * rr * cos(a))
         cy = GLB.ny * (0.5 + 0.44 * rr * sin(a))
         ln = 20.0 + (vel / 127.0) * 70.0
         ux = cos(a + 1.5708)
         uy = sin(a + 1.5708)
         # --- distance to the segment, so the scar is a slash not a dot
         px = GLB.ix - cx
         py = GLB.iy - cy
         t = np.clip(px * ux + py * uy, -ln, ln)
         dd = (px - t * ux) ** 2 + (py - t * uy) ** 2
         s = s + np.exp(-dd * 0.10) * (vel / 127.0) * f0 * 2.2
      GLB.prev[i] = vel

   np.clip(s, 0.0, 3.0, out=s)
   GLB.s = s

   cut = np.clip(s, 0.0, 1.0)
   flush = 0.32 if acc else 0.0
   base = 0.40 + f2 * 0.45 + GLB.grain * 0.035
   # --- skin above, raw below
   red = (base + flush) * (1.0 - cut * 0.35) * 255.0
   grn = (base * 0.74) * (1.0 - cut * 0.86) * 255.0
   blu = (base * 0.66) * (1.0 - cut * 0.92) * 255.0
   GLB.sv[:, :GLB.nx, 0] = np.clip(red, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 1] = np.clip(grn, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 2] = np.clip(blu, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 3] = 255
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
