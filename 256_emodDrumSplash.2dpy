def Init():
   # --- author : claude
   # --- drum hits on a membrane.  Each hit sets a standing mode going and
   # --- the membrane keeps ringing on its own afterwards - the wave equation
   # --- carries it, so hits interfere with each other instead of just
   # --- stacking up.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Tension")
   STR.SetFParam1Name("Ring")
   STR.SetFParam2Name("Skin")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : rimshot, the whole head goes
   # ---    trigger : retune

   GLB.res = 4
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   GLB.u = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   GLB.p = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   GLB.lap = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   GLB.prev = np.zeros(GLB.slots, dtype=np.float32)
   GLB.nb = 200
   GLB.pal = np.zeros((GLB.nb, 3), dtype=np.float32)
   GLB.hue = 0.0

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.12, 0.42)
   f1 = STR.F1mix(0.980, 0.9990)
   f2 = STR.F2()

   if trig:
      GLB.hue = np.random.random()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   u = GLB.u
   p = GLB.p
   lap = GLB.lap
   lap[:, :] = 0.0
   np.add(lap[1:], u[:-1], out=lap[1:])
   np.add(lap[:-1], u[1:], out=lap[:-1])
   np.add(lap[:, 1:], u[:, :-1], out=lap[:, 1:])
   np.add(lap[:, :-1], u[:, 1:], out=lap[:, :-1])
   np.subtract(lap, u * 4.0, out=lap)
   nxt = (2.0 * u - p + f0 * lap) * f1
   GLB.p = u
   u = nxt
   # --- a drumhead is clamped at the rim
   u[0:2, :] = 0.0
   u[-2:, :] = 0.0
   u[:, 0:2] = 0.0
   u[:, -2:] = 0.0

   for i in range(GLB.slots):
      d = STR.GetSlotData(i)
      vel = d[2] * 1.0
      if d[0] != 0 and vel > GLB.prev[i] + 5.0:
         n = int(d[1])
         a = (n % 16) * 0.3927
         rr = 0.15 + ((n // 16) % 5) * 0.17
         cx = int(GLB.nx * (0.5 + 0.40 * rr * cos(a)))
         cy = int(GLB.ny * (0.5 + 0.40 * rr * sin(a)))
         amp = -(vel / 127.0) * 3.4
         w = 3 + int((vel / 127.0) * 5)
         u[max(cy-w, 2):cy+w, max(cx-w, 2):cx+w] = amp
      GLB.prev[i] = vel

   if acc:
      u[2:-2, 2:-2] = u[2:-2, 2:-2] + (
         np.random.random((GLB.ny - 4, GLB.nx - 4)) - 0.5) * 0.5

   np.clip(u, -4.0, 4.0, out=u)
   GLB.u = u

   for i in range(GLB.nb):
      t = i / (GLB.nb - 1.0)
      c = hsv_to_rgb((GLB.hue + f2 + t * 0.30) % 1.0, 0.82 - t * 0.30,
                     0.10 + t * 0.90)
      GLB.pal[i, 0] = c[0] * 255.0
      GLB.pal[i, 1] = c[1] * 255.0
      GLB.pal[i, 2] = c[2] * 255.0
   q = np.clip(np.abs(u) * 1.1 * GLB.nb, 0, GLB.nb - 1).astype(np.int32)
   c = GLB.pal[q]
   GLB.sv[:, :GLB.nx, 0] = c[:, :, 0].astype(np.uint8)
   GLB.sv[:, :GLB.nx, 1] = c[:, :, 1].astype(np.uint8)
   GLB.sv[:, :GLB.nx, 2] = c[:, :, 2].astype(np.uint8)
   GLB.sv[:, :GLB.nx, 3] = 255
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
