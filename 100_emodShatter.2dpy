def Init():
   # --- author : claude
   # --- a pane that takes a hit from every note : shards near the impact
   # --- break loose and fly, the rest of the sheet stays put
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Recover")
   STR.SetFParam1Name("Shards")
   STR.SetFParam2Name("Force")
   # ---    accent : outlines
   # ---    trigger : reset the pane

   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"

   GLB.prev = []
   for i in range(24):
      GLB.prev.append(0)

   def build(spokes):
      GLB.sh = []
      rings = 5
      for r in range(rings):
         r0 = 20.0 + r * (400.0 / rings)
         r1 = 20.0 + (r + 1) * (400.0 / rings)
         for s in range(spokes):
            a0 = s * 2.0 * pi / spokes
            a1 = (s + 1) * 2.0 * pi / spokes
            am = (a0 + a1) * 0.5
            rm = (r0 + r1) * 0.5
            GLB.sh.append([a0, a1, r0, r1,
                           cos(am) * rm, sin(am) * rm,
                           0.0, 0.0, 0.0, 0.0, am, np.random.random()])
      GLB.spokes = spokes
   GLB.build = build
   GLB.build(13)

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.80, 0.995)
   f1 = STR.F1mix(7.0, 16.0)
   f2 = STR.F2mix(2.0, 34.0)

   time = STR.IT() + STR.FT()

   sp = int(f1)
   if trig or sp != GLB.spokes:
      GLB.build(sp)
      if trig:
         GLB.xmode = 1 if GLB.xmode==0 else 0

   # --- a note knocks the shards near its bearing loose
   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      hit = 0
      if GLB.mode == "midi":
         if ids != 0 and GLB.prev[i] != ids:
            hit = 1
            bearing = (note % 12) / 12.0 * 2.0 * pi
         GLB.prev[i] = ids
      else:
         if velo > 72 and GLB.prev[i] <= 72:
            hit = 1
            bearing = i / (GLB.slots * 1.0) * 2.0 * pi
         GLB.prev[i] = velo
      if hit:
         v = velo / 127.0
         for s in GLB.sh:
            d = abs(((s[10] - bearing + pi) % (2.0 * pi)) - pi)
            if d < 0.9:
               k = (1.0 - d / 0.9) * v * f2
               s[8] = s[8] + cos(s[10]) * k
               s[9] = s[9] + sin(s[10]) * k

   # --- fly, then ease back into place
   for s in GLB.sh:
      s[6] = s[6] + s[8]
      s[7] = s[7] + s[9]
      s[8] = s[8] * f0
      s[9] = s[9] * f0
      s[6] = s[6] * f0
      s[7] = s[7] * f0

   cr.set_source_rgb(0.02, 0.02, 0.04)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cx = 640.0
   cy = 360.0
   bands = 6
   for b in range(bands):
      t = b / (bands - 1.0)
      r,g,bl = hsv_to_rgb((0.55 + t * 0.2) % 1.0, 0.4 + 0.3 * t, 0.4 + 0.6 * t)
      cr.set_source_rgb(bl, g, r)
      cr.set_line_width(1.4)
      k = b
      any = 0
      while k < len(GLB.sh):
         s = GLB.sh[k]
         d = sqrt(s[6] * s[6] + s[7] * s[7])
         cr.save()
         cr.translate(cx + s[6], cy + s[7])
         cr.rotate(d * 0.004 * (1.0 if s[11] > 0.5 else -1.0))
         cr.new_sub_path()
         cr.arc(0, 0, s[3], s[0], s[1])
         cr.arc_negative(0, 0, s[2], s[1], s[0])
         cr.close_path()
         cr.restore()
         any = 1
         k = k + bands
      if any:
         if acc:
            cr.stroke()
         else:
            cr.fill()
   cr.new_path()
