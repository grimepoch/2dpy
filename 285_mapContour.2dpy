def Init():
   # --- author : claude
   # --- a survey being drawn up.  Contours are traced one height at a time
   # --- onto a sheet that is never wiped, so the relief assembles itself
   # --- out of single lines - and where the ground is steep the lines crowd
   # --- together on their own.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Survey Rate")
   STR.SetFParam1Name("Interval")
   STR.SetFParam2Name("Ink")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : hachures on the steep ground
   # ---    trigger : new ground

   GLB.st = surface.get_stride() // 4
   GLB.res = 4
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   yy, xx = np.meshgrid(np.arange(GLB.ny), np.arange(GLB.nx), indexing="ij")
   GLB.iy = yy.astype(np.float32)
   GLB.ix = xx.astype(np.float32)
   GLB.lvl = 0.0

   def ground():
      h = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
      for k in range(6):
         fx = 0.006 + np.random.random() * 0.04
         fy = 0.006 + np.random.random() * 0.04
         ph = np.random.random() * 6.283
         h = h + np.sin(GLB.ix * fx + ph) * np.cos(GLB.iy * fy + ph * 0.7) / (
            k * 0.7 + 1.0)
      GLB.h = (h - h.min()) / (h.max() - h.min() + 1e-9)
      GLB.lvl = 0.0
      cr.set_source_rgb(0.78, 0.86, 0.92)
      cr.rectangle(0, 0, 1280, 720)
      cr.fill()
   GLB.ground = ground
   GLB.ground()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.002, 0.05)
   f1 = STR.F1mix(0.02, 0.14)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.ground()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   h = GLB.h
   GLB.lvl = GLB.lvl + f0
   if GLB.lvl > 1.0:
      GLB.ground()
      return
   lv = GLB.lvl

   # --- a contour is the boundary of the region below this height, so it can
   # --- be found as a one cell band rather than traced
   below = h < lv
   edge = np.zeros((GLB.ny, GLB.nx), dtype=bool)
   edge[1:] = edge[1:] | (below[1:] != below[:-1])
   edge[:, 1:] = edge[:, 1:] | (below[:, 1:] != below[:, :-1])

   iy, ix = np.where(edge)
   idx = int(lv / f1)
   # --- every fifth contour is an index line, drawn heavier
   heavy = (idx % 5) == 0
   c = hsv_to_rgb((0.08 + f2 * 0.55) % 1.0, 0.70, 0.45 if heavy else 0.62)
   cr.set_source_rgb(c[2], c[1], c[0])
   R = GLB.res
   s = R + (1 if heavy else 0)
   for k in range(len(iy)):
      cr.rectangle(ix[k] * R, iy[k] * R, s, s)
   cr.fill()

   if acc:
      # --- hachures : short strokes down the steepest slope
      gx = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
      gy = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
      gx[:, 1:] = h[:, 1:] - h[:, :-1]
      gy[1:] = h[1:] - h[:-1]
      cr.set_line_width(1.2)
      cr.set_source_rgba(c[2], c[1], c[0], 0.55)
      for k in range(0, len(iy), 7):
         y = iy[k]
         x = ix[k]
         d = sqrt(gx[y, x] ** 2 + gy[y, x] ** 2) + 1e-6
         cr.move_to(x * R, y * R)
         cr.line_to(x * R - gx[y, x] / d * 9.0, y * R - gy[y, x] / d * 9.0)
      cr.stroke()
