def Init():
   # --- author : claude
   # --- ferrofluid over a magnet array.  The fluid is a height field that
   # --- flows downhill but is pulled up the field lines, and the spikes are
   # --- not drawn - they emerge because surface tension smooths the sheet
   # --- while the magnets keep pulling it into peaks.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Field")
   STR.SetFParam1Name("Tension")
   STR.SetFParam2Name("Sheen")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : slam the field on
   # ---    trigger : rearrange the magnets

   GLB.res = 4
   GLB.nx = 1280 // GLB.res
   GLB.ny = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.nx, GLB.ny)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.ny, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   yy, xx = np.meshgrid(np.arange(GLB.ny), np.arange(GLB.nx), indexing="ij")
   GLB.iy = yy.astype(np.float32)
   GLB.ix = xx.astype(np.float32)
   GLB.h = np.ones((GLB.ny, GLB.nx), dtype=np.float32) * 0.25

   def magnets():
      n = 7
      GLB.mx = np.random.random(n) * GLB.nx
      GLB.my = np.random.random(n) * GLB.ny
      GLB.ms = np.random.random(n) * 0.7 + 0.5
      GLB.mp = np.random.random(n) * 6.283
   GLB.magnets = magnets
   GLB.magnets()

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.02, 0.30)
   f1 = STR.F1mix(0.05, 0.42)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.magnets()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   fld = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   for i in range(len(GLB.mx)):
      cx = GLB.mx[i] + sin(time * 0.3 + GLB.mp[i]) * 18.0
      cy = GLB.my[i] + cos(time * 0.23 + GLB.mp[i]) * 12.0
      d = (GLB.ix - cx) ** 2 + (GLB.iy - cy) ** 2
      fld = fld + GLB.ms[i] * np.exp(-d / 1600.0)

   h = GLB.h
   # --- surface tension : the sheet is pulled toward its own average
   k = f1
   h[1:] = h[1:] + (h[:-1] - h[1:]) * k
   h[:-1] = h[:-1] + (h[1:] - h[:-1]) * k
   h[:, 1:] = h[:, 1:] + (h[:, :-1] - h[:, 1:]) * k
   h[:, :-1] = h[:, :-1] + (h[:, 1:] - h[:, :-1]) * k
   # --- the field pulls it back into peaks, and the peaks win where the
   # --- field is strong.  The fight between the two makes the spikes.
   pull = f0 * (3.0 if acc else 1.0)
   h = h + (fld * 1.4 - h) * pull
   h = h * 0.999 + 0.0004
   np.clip(h, 0.0, 2.2, out=h)
   GLB.h = h

   # --- lit as a metal : the slope is the whole picture
   sx = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   sy = np.zeros((GLB.ny, GLB.nx), dtype=np.float32)
   sx[:, 1:] = (h[:, 1:] - h[:, :-1]) * 30.0
   sy[1:] = (h[1:] - h[:-1]) * 30.0
   spec = np.clip(0.5 - sx * 0.5 + sy * 0.36, 0.0, 1.0)
   spec = spec ** 3
   body = np.clip(h * 0.7, 0.0, 1.0)
   c = hsv_to_rgb(f2, 0.55, 1.0)
   red = body * 34.0 + spec * 255.0 * c[0]
   grn = body * 36.0 + spec * 255.0 * c[1]
   blu = body * 44.0 + spec * 255.0 * c[2]
   GLB.sv[:, :GLB.nx, 0] = np.clip(red, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 1] = np.clip(grn, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 2] = np.clip(blu, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.nx, 3] = 255
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
