def Init():
   # --- author : claude
   # --- the times-table circle.  Mark N points round a circle and join each
   # --- point k to point k*m.  As m passes 2 a cardioid appears, at 3 a
   # --- nephroid, at 4 three lobes - the whole family of epicycloids falls
   # --- out of multiplication.  The multiplier never stops sweeping, so the
   # --- figure is always between two of them.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Multiplier")
   STR.SetFParam1Name("Points")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : the chords are drawn as arcs, not straight
   # ---    trigger : hold the multiplier still

   GLB.st = surface.get_stride() // 4
   GLB.m = 2.0
   GLB.hold = 0

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0006, 0.020)
   f1 = STR.F1mix(60.0, 460.0)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.hold = 1 - GLB.hold
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   if GLB.hold == 0:
      GLB.m = GLB.m + f0
      # --- wrap back rather than run away, so it keeps touring the family
      if GLB.m > 26.0:
         GLB.m = 2.0

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   np.subtract(v, np.right_shift(v, 2), out=v)
   v[:, :, 3] = 255
   surface.mark_dirty()

   n = int(f1)
   R = 330.0
   cx = 640.0
   cy = 360.0
   m = GLB.m
   k = np.arange(n)
   a0 = k * 6.2831853 / n
   a1 = np.mod(k * m, n) * 6.2831853 / n
   x0 = cx + np.cos(a0) * R
   y0 = cy + np.sin(a0) * R * 0.98
   x1 = cx + np.cos(a1) * R
   y1 = cy + np.sin(a1) * R * 0.98

   # --- the chord's own length picks its colour, which is what makes the
   # --- envelope of the cardioid stand out from the chords that draw it.
   # --- The chords are sampled into the framebuffer rather than stroked.
   # --- Measured on this hardware: 460 separate cairo strokes is 38 ms, and
   # --- gathering them into ONE path with 460 subpaths is 86 ms - cairo gets
   # --- worse, not better, as a path grows.  Sampling is about 1 ms and does
   # --- not care how many chords there are.
   ln = np.sqrt((x1 - x0) ** 2 + (y1 - y0) ** 2) / (R * 2.0)
   # --- enough samples that even a chord right across the circle lands on
   # --- consecutive pixels rather than a dotted line
   K = 300
   t = np.linspace(0.0, 1.0, K).reshape(1, K)
   px = x0.reshape(n, 1) + (x1 - x0).reshape(n, 1) * t
   py = y0.reshape(n, 1) + (y1 - y0).reshape(n, 1) * t
   if acc:
      # --- bowed toward the centre instead of straight
      bow = np.sin(t * pi) * 0.42
      px = px + (cx - px) * bow
      py = py + (cy - py) * bow
   ix = px.astype(np.int32).ravel()
   iy = py.astype(np.int32).ravel()
   ok = (ix > 0) & (ix < 1279) & (iy > 0) & (iy < 719)
   ix = ix[ok]
   iy = iy[ok]

   hue = np.repeat((f2 + ln * 0.7) % 1.0, K)[ok]
   val = np.repeat(0.55 + 0.45 * ln, K)[ok]
   h6 = hue * 6.0
   rr = np.clip(np.abs(h6 - 3.0) - 1.0, 0.0, 1.0)
   gg = np.clip(2.0 - np.abs(h6 - 2.0), 0.0, 1.0)
   bb = np.clip(2.0 - np.abs(h6 - 4.0), 0.0, 1.0)
   sat = 0.80
   rr = (1.0 - sat + sat * rr) * val * 255.0
   gg = (1.0 - sat + sat * gg) * val * 255.0
   bb = (1.0 - sat + sat * bb) * val * 255.0
   v[iy, ix, 0] = rr.astype(np.uint8)
   v[iy, ix, 1] = gg.astype(np.uint8)
   v[iy, ix, 2] = bb.astype(np.uint8)
   v[:, :, 3] = 255
   surface.mark_dirty()
