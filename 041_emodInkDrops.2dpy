def Init():
   # --- author : claude
   # --- ink hitting wet paper : each note blooms a ragged blot that keeps
   # --- creeping outward and soaking into what is already there
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Dry")
   STR.SetFParam1Name("Bloom")
   STR.SetFParam2Name("Hue")
   # ---    accent : paper goes dark, ink goes bright
   # ---    trigger : fresh sheet

   # --- 10 slots = FFT analysis bins, 24 slots = MIDI notes
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"

   GLB.blots = []
   GLB.prev = []
   for i in range(24):
      GLB.prev.append(0)
   GLB.wipe = 1

   def drop(x, y, hue, velo):
      # --- a ragged outline, remembered so the blot keeps its shape
      k = 13
      rad = []
      for i in range(k):
         rad.append(0.55 + np.random.random() * 0.45)
      GLB.blots.append([x, y, 0.0, 24.0 + velo * 90.0, hue, rad])
      if len(GLB.blots) > 26:
         del GLB.blots[0]
   GLB.drop = drop

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0, 0.09)
   f1 = STR.F1mix(0.01, 0.09)
   f2 = STR.F2()

   if trig:
      GLB.wipe = 1
      GLB.blots = []
      GLB.xmode = 1 if GLB.xmode==0 else 0

   paper = (0.06, 0.05, 0.07) if acc else (0.93, 0.92, 0.90)

   if GLB.wipe:
      GLB.wipe = 0
      cr.set_source_rgb(paper[2], paper[1], paper[0])
      cr.rectangle(0,0,1280,720)
      cr.fill()
   elif f0 > 0.002:
      # --- the paper slowly dries back toward its own colour
      cr.set_source_rgba(paper[2], paper[1], paper[0], f0)
      cr.rectangle(0,0,1280,720)
      cr.fill()

   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      if GLB.mode == "midi":
         if ids != 0 and GLB.prev[i] != ids:
            GLB.drop(120.0 + np.random.random() * 1040.0,
                     100.0 + np.random.random() * 520.0,
                     (note % 12) / 12.0, velo / 127.0)
         GLB.prev[i] = ids
      else:
         if velo > 75 and GLB.prev[i] <= 75:
            GLB.drop(120.0 + np.random.random() * 1040.0,
                     100.0 + np.random.random() * 520.0,
                     i / (GLB.slots * 1.0), velo / 127.0)
         GLB.prev[i] = velo

   dead = []
   for i in range(len(GLB.blots)):
      b = GLB.blots[i]
      # --- growth slows as the blot spreads, like ink running out of push
      b[2] = b[2] + (1.0 - b[2]) * f1
      if b[2] > 0.995:
         dead.append(i)
         continue
      rad = b[5]
      k = len(rad)
      R = b[3] * b[2]
      r,g,bl = hsv_to_rgb((b[4] * 0.7 + f2) % 1.0, 0.80, 0.95 if acc else 0.55)
      cr.set_source_rgba(bl, g, r, 0.55)

      # --- closed curve through the ragged radii
      cr.move_to(b[0] + cos(0.0) * R * rad[0], b[1] + sin(0.0) * R * rad[0])
      for j in range(1, k + 1):
         a0 = (j - 1) * 2.0 * pi / k
         a1 = j * 2.0 * pi / k
         r0 = rad[(j - 1) % k]
         r1 = rad[j % k]
         am = (a0 + a1) * 0.5
         rm = (r0 + r1) * 0.5 * 1.14
         cr.curve_to(b[0] + cos(am) * R * rm, b[1] + sin(am) * R * rm,
                     b[0] + cos(am) * R * rm, b[1] + sin(am) * R * rm,
                     b[0] + cos(a1) * R * r1, b[1] + sin(a1) * R * r1)
      cr.close_path()
      cr.fill()

   dead.reverse()
   for i in dead:
      del GLB.blots[i]
