def Init():
   # --- author : claude
   # --- a transit diagram drawing itself.  Lines are extended one leg at a
   # --- time in the octolinear style the real ones use - only horizontal,
   # --- vertical and 45 degrees - and the map is never redrawn, so the
   # --- network is the accumulation of every leg ever laid.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Build Rate")
   STR.SetFParam1Name("Leg Length")
   STR.SetFParam2Name("Fade")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : interchange stations
   # ---    trigger : redraw the network

   GLB.st = surface.get_stride() // 4
   GLB.dxs = [1, 1, 0, -1, -1, -1, 0, 1]
   GLB.dys = [0, 1, 1, 1, 0, -1, -1, -1]

   def rebuild():
      n = 7
      GLB.n = n
      GLB.lx = np.random.random(n) * 900.0 + 190.0
      GLB.ly = np.random.random(n) * 460.0 + 130.0
      GLB.ld = np.random.randint(0, 8, n)
      GLB.lh = np.random.random(n)
      GLB.acc_t = 0.0
      cr.set_source_rgba(0, 0, 0, 1)
      cr.rectangle(0, 0, 1280, 720)
      cr.fill()
   GLB.rebuild = rebuild
   GLB.rebuild()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.06, 0.9)
   f1 = STR.F1mix(26.0, 90.0)
   f2 = STR.F2mix(8.0, 11.0)
   time = STR.IT() + STR.FT()

   if trig:
      GLB.rebuild()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   np.subtract(v, np.right_shift(v, int(f2)), out=v)
   v[:, :, 3] = 255
   surface.mark_dirty()

   cr.set_line_width(7.0)
   cr.set_line_cap(cairo.LINE_CAP_ROUND)
   cr.set_line_join(cairo.LINE_JOIN_ROUND)
   for i in range(GLB.n):
      if np.random.random() > f0:
         continue
      # --- octolinear : the direction may only turn by one eighth at a time
      if np.random.random() < 0.35:
         GLB.ld[i] = (GLB.ld[i] + (1 if np.random.random() < 0.5 else -1)) % 8
      d = GLB.ld[i]
      ln = f1 * (0.5 + np.random.random())
      x0 = GLB.lx[i]
      y0 = GLB.ly[i]
      x1 = x0 + GLB.dxs[d] * ln
      y1 = y0 + GLB.dys[d] * ln
      # --- turn back at the edge of the sheet rather than run off it
      if x1 < 70 or x1 > 1210 or y1 < 60 or y1 > 660:
         GLB.ld[i] = (d + 4) % 8
         continue
      GLB.lx[i] = x1
      GLB.ly[i] = y1
      c = hsv_to_rgb(GLB.lh[i], 0.80, 1.0)
      cr.set_source_rgb(c[2], c[1], c[0])
      cr.move_to(x0, y0)
      cr.line_to(x1, y1)
      cr.stroke()

      # --- a station at the end of most legs
      if np.random.random() < 0.55:
         if acc:
            cr.set_source_rgb(1.0, 1.0, 1.0)
            cr.new_sub_path()
            cr.arc(x1, y1, 9.0, 0, 6.2831853)
            cr.fill()
            cr.set_source_rgb(0.08, 0.08, 0.08)
            cr.new_sub_path()
            cr.arc(x1, y1, 5.0, 0, 6.2831853)
            cr.fill()
         else:
            cr.set_source_rgb(0.95, 0.95, 0.95)
            cr.set_line_width(3.0)
            cr.move_to(x1 - 7, y1 - 7)
            cr.line_to(x1 + 7, y1 + 7)
            cr.stroke()
            cr.set_line_width(7.0)
