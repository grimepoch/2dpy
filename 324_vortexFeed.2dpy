def Init():
   # --- author : claude
   # --- a swirl applied to what is already on screen.  A rotation field
   # --- linearises into two shears - x' = x - w.y and y' = y + w.x - so the
   # --- whole standing image can be twisted with banded slice shifts instead
   # --- of a per-pixel gather, and w falls off with radius to make a vortex.
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Swirl")
   STR.SetFParam1Name("Falloff")
   STR.SetFParam2Name("Decay")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : swirl the other way
   # ---    trigger : pull inward as well

   GLB.st = surface.get_stride() // 4
   GLB.pull = 0

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0, 9.0)
   f1 = STR.F1mix(90.0, 700.0)
   f2 = STR.F2mix(3.0, 9.0)

   time = STR.IT() + STR.FT()

   if trig:
      GLB.pull = 1 - GLB.pull
      GLB.xmode = 1 if GLB.xmode==0 else 0

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8, buffer=surface.get_data())
   np.subtract(v, np.right_shift(v, int(f2)), out=v)

   sgn = -1.0 if acc else 1.0
   w = f0 * sgn
   R = f1
   cx = GLB.st * 0.5
   cy = 360.0

   # --- shear one: rows moved in x by -w * (y - cy), tapered by radius
   # --- bands are free (same bytes moved), so use plenty and stay smooth
   nb = 60
   bh = 720 // nb
   for b in range(nb):
      y0 = b * bh
      y1 = y0 + bh
      dy = (y0 + bh * 0.5) - cy
      fall = 1.0 - abs(dy) / R
      if fall < 0.0:
         fall = 0.0
      sft = int(-w * (dy / R) * fall * 6.0)
      if GLB.pull:
         sft = sft + int(-(dy / R) * fall * 2.0)
      if sft > 0:
         v[y0:y1, :-sft] = v[y0:y1, sft:]
      elif sft < 0:
         k = -sft
         v[y0:y1, k:] = v[y0:y1, :-k]

   # --- shear two: columns moved in y by +w * (x - cx)
   nbx = 60
   bw = GLB.st // nbx
   for b in range(nbx):
      x0 = b * bw
      x1 = x0 + bw
      dx = (x0 + bw * 0.5) - cx
      fall = 1.0 - abs(dx) / R
      if fall < 0.0:
         fall = 0.0
      sft = int(w * (dx / R) * fall * 6.0)
      if GLB.pull:
         sft = sft + int(-(dx / R) * fall * 2.0)
      if sft > 0:
         v[:-sft, x0:x1] = v[sft:, x0:x1]
      elif sft < 0:
         k = -sft
         v[k:, x0:x1] = v[:-k, x0:x1]

   v[:, :, 3] = 255
   surface.mark_dirty()

   # --- feed the vortex from the rim
   c = hsv_to_rgb((time * 0.06) % 1.0, 0.85, 1.0)
   cr.set_source_rgb(c[2], c[1], c[0])
   cr.set_line_width(12)
   cr.set_line_cap(cairo.LINE_CAP_ROUND)
   a = time * 1.3
   cr.move_to(640 + 560 * cos(a), 360 + 330 * sin(a))
   cr.line_to(640 + 470 * cos(a + 0.35), 360 + 275 * sin(a + 0.35))
   cr.stroke()
   if GLB.xmode:
      cr.new_sub_path()
      cr.arc(640 + 420 * cos(-a * 0.7), 360 + 250 * sin(-a * 0.7), 16, 0, 2 * pi)
      cr.fill()
