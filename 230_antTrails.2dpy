def Init():
   # --- author : claude
   # --- ants on a pheromone field.  No ant knows where the food is - each
   # --- one only smells the field the others left behind, and strengthens it
   # --- where it walks.  The field is the memory, so the trails you see form
   # --- and abandon themselves without anyone deciding to.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Following")
   STR.SetFParam1Name("Evaporate")
   STR.SetFParam2Name("Colony")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : alarm pheromone, the colony scatters
   # ---    trigger : move the food

   GLB.res = 4
   GLB.gx = 1280 // GLB.res
   GLB.gy = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.gx, GLB.gy)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.gy, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   GLB.ph = np.zeros((GLB.gy, GLB.gx), dtype=np.float32)
   GLB.n = 700
   GLB.ax = np.random.random(GLB.n) * 1280.0
   GLB.ay = np.random.random(GLB.n) * 720.0
   GLB.aa = np.random.random(GLB.n) * 6.283

   def newfood():
      GLB.fx = np.random.random(3) * 1080.0 + 100.0
      GLB.fy = np.random.random(3) * 520.0 + 100.0
   GLB.newfood = newfood
   GLB.newfood()

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0, 1.6)
   f1 = STR.F1mix(0.975, 0.9995)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.newfood()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   ph = GLB.ph
   # --- the field spreads a little and fades a lot
   ph[1:] = ph[1:] + (ph[:-1] - ph[1:]) * 0.16
   ph[:-1] = ph[:-1] + (ph[1:] - ph[:-1]) * 0.16
   ph[:, 1:] = ph[:, 1:] + (ph[:, :-1] - ph[:, 1:]) * 0.16
   ph[:, :-1] = ph[:, :-1] + (ph[:, 1:] - ph[:, :-1]) * 0.16
   ph = ph * f1

   # --- food keeps topping the field up where it sits
   for k in range(3):
      gx = int(GLB.fx[k] / GLB.res)
      gy = int(GLB.fy[k] / GLB.res)
      ph[max(gy-2, 0):gy+3, max(gx-2, 0):gx+3] = 9.0

   # --- each ant samples the field left and right of its nose and turns
   # --- toward the stronger side
   ang = GLB.aa
   sens = 7.0
   for side in range(2):
      sa = ang + (0.6 if side == 0 else -0.6)
      sx = np.clip(((GLB.ax + np.cos(sa) * sens) / GLB.res).astype(np.int32),
                   0, GLB.gx - 1)
      sy = np.clip(((GLB.ay + np.sin(sa) * sens) / GLB.res).astype(np.int32),
                   0, GLB.gy - 1)
      if side == 0:
         left = ph[sy, sx]
      else:
         right = ph[sy, sx]
   turn = np.clip((left - right) * f0, -0.5, 0.5)
   if acc:
      turn = (np.random.random(GLB.n) - 0.5) * 2.2
   GLB.aa = ang + turn + (np.random.random(GLB.n) - 0.5) * 0.30

   GLB.ax = np.mod(GLB.ax + np.cos(GLB.aa) * 2.6, 1280.0)
   GLB.ay = np.mod(GLB.ay + np.sin(GLB.aa) * 2.6, 720.0)
   ix = (GLB.ax / GLB.res).astype(np.int32)
   iy = (GLB.ay / GLB.res).astype(np.int32)
   np.add.at(ph, (iy, ix), 0.85)
   np.clip(ph, 0.0, 9.0, out=ph)
   GLB.ph = ph

   lv = np.clip(ph * (0.11 + f2 * 0.2), 0.0, 1.0)
   GLB.sv[:, :GLB.gx, 0] = np.clip(lv * 235.0 + 6.0, 0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.gx, 1] = np.clip(lv * lv * 190.0 + 5.0,
                                   0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.gx, 2] = np.clip(lv * lv * lv * 120.0 + 9.0,
                                   0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.gx, 3] = 255
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()

   cr.set_source_rgb(0.55, 0.85, 1.0)
   for k in range(3):
      cr.new_sub_path()
      cr.arc(GLB.fx[k], GLB.fy[k], 7.0, 0, 6.2831853)
   cr.fill()
