def Init():
   # --- author : claude
   # --- a real one dimensional wave equation.  Notes strike the string and
   # --- the displacement propagates, reflects off the ends and interferes.
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Tension")
   STR.SetFParam1Name("Damping")
   STR.SetFParam2Name("Amplitude")
   # ---    accent : show the energy envelope
   # ---    trigger : pluck <-> continuous drive

   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"

   GLB.n = 260
   GLB.u = np.zeros(GLB.n)
   GLB.up = np.zeros(GLB.n)
   GLB.prev = []
   for i in range(24):
      GLB.prev.append(0)

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.05, 0.42)
   f1 = STR.F1mix(0.980, 0.9995)
   f2 = STR.F2mix(40.0, 300.0)

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0

   n = GLB.n
   # --- strike the string where the note says
   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      if GLB.mode == "midi":
         hit = (ids != 0 and GLB.prev[i] != ids)
         GLB.prev[i] = ids
         pos = int((note % 24) / 24.0 * n)
      else:
         hit = (velo > 70 and GLB.prev[i] <= 70)
         GLB.prev[i] = velo
         pos = int((i + 0.5) / GLB.slots * n)
      if hit:
         a = velo / 127.0
         for k in range(-7, 8):
            j = pos + k
            if j > 0 and j < n - 1:
               GLB.u[j] = GLB.u[j] + a * cos(k * 0.22) * 1.1
      if GLB.xmode and ids != 0:
         pos2 = int((i + 0.5) / GLB.slots * n)
         if pos2 > 0 and pos2 < n - 1:
            GLB.u[pos2] = GLB.u[pos2] + (velo / 127.0) * 0.09 * sin(time * 9.0)

   # --- the wave equation, two steps per frame for stability
   for s in range(2):
      lap = np.zeros(n)
      lap[1:-1] = GLB.u[:-2] - 2.0 * GLB.u[1:-1] + GLB.u[2:]
      nxt = 2.0 * GLB.u - GLB.up + lap * f0
      nxt = nxt * f1
      nxt[0] = 0.0
      nxt[n - 1] = 0.0
      GLB.up = GLB.u
      GLB.u = nxt

   cr.set_source_rgb(0.02, 0.02, 0.05)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   xs = np.linspace(40.0, 1240.0, n).tolist()
   ys = (360.0 + GLB.u * f2).tolist()
   env = (np.abs(GLB.u) * f2).tolist()

   if acc:
      r,g,b = hsv_to_rgb(0.55, 0.7, 0.6)
      cr.set_source_rgba(b, g, r, 0.35)
      cr.move_to(xs[0], 360.0 + env[0])
      for i in range(1, n):
         cr.line_to(xs[i], 360.0 + env[i])
      for i in range(n - 1, -1, -1):
         cr.line_to(xs[i], 360.0 - env[i])
      cr.close_path()
      cr.fill()

   # --- the string, banded by local displacement
   bands = 7
   for b in range(bands):
      lo = b / (bands * 1.0)
      hi = (b + 1) / (bands * 1.0)
      t = b / (bands - 1.0)
      r,g,bl = hsv_to_rgb((0.6 - t * 0.45) % 1.0, 0.85, 0.4 + 0.6 * t)
      cr.set_source_rgb(bl, g, r)
      cr.set_line_width(1.5 + 3.0 * t)
      i = 0
      any = 0
      while i < n - 1:
         e = env[i] / (f2 + 0.001)
         if e >= lo and e < hi:
            cr.move_to(xs[i], ys[i])
            cr.line_to(xs[i + 1], ys[i + 1])
            any = 1
         i = i + 1
      if any:
         cr.stroke()

   cr.set_source_rgb(0.4, 0.4, 0.5)
   cr.rectangle(34, 300, 6, 120)
   cr.fill()
   cr.rectangle(1240, 300, 6, 120)
   cr.fill()
