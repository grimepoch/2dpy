def Init():
   # --- author : claude
   # --- a star with one arm per slot, each arm as long as that slot is loud
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Fade")
   STR.SetFParam1Name("Reach")
   STR.SetFParam2Name("Spin")
   # ---    accent : spikes instead of a smooth hull
   # ---    trigger : filled <-> outline

   # --- 10 slots = FFT analysis bins, 24 slots = MIDI notes
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"

   GLB.lanes = 12 if GLB.slots == 24 else GLB.slots
   GLB.lvl = []
   for i in range(GLB.lanes):
      GLB.lvl.append(0.0)
   GLB.rot = 0.0

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.06, 0.7)
   f1 = STR.F1mix(60.0, 330.0)
   f2 = STR.F2mix(-0.06, 0.06)

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0

   # --- clear screen
   cr.set_source_rgba(0,0,0,f0)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   n = GLB.lanes

   # --- decay, then let incoming data push each arm back out
   for k in range(n):
      GLB.lvl[k] = GLB.lvl[k] * 0.86

   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      if ids == 0:
         continue
      k = (note % 12) if GLB.mode == "midi" else i
      if k < n:
         v = velo / 127.0
         if v > GLB.lvl[k]:
            GLB.lvl[k] = v

   GLB.rot = GLB.rot + f2

   cr.save()
   cr.translate(640, 360)
   cr.rotate(GLB.rot)

   pts = []
   for k in range(n):
      a = k * 2.0 * pi / n
      r = 70.0 + f1 * GLB.lvl[k]
      pts.append([cos(a) * r, sin(a) * r, GLB.lvl[k], a])

   if acc:
      # --- each arm as its own spike back to the middle
      cr.set_line_width(3)
      for k in range(n):
         p = pts[k]
         rr,gg,bb = hsv_to_rgb((k / (n * 1.0) + time * 0.05) % 1.0, 0.85, 1.0)
         cr.set_source_rgb(bb, gg, rr)
         cr.move_to(0, 0)
         cr.line_to(p[0], p[1])
         cr.stroke()
         cr.new_sub_path()
         cr.arc(p[0], p[1], 4 + 10 * p[2], 0, 2 * pi)
         cr.fill()
   else:
      cr.move_to(pts[0][0], pts[0][1])
      for k in range(1, n):
         cr.line_to(pts[k][0], pts[k][1])
      cr.close_path()
      rg = cairo.RadialGradient(0, 0, 20, 0, 0, 70.0 + f1)
      r1,g1,b1 = hsv_to_rgb((time * 0.05) % 1.0, 0.9, 1.0)
      r2,g2,b2 = hsv_to_rgb((time * 0.05 + 0.4) % 1.0, 0.9, 1.0)
      rg.add_color_stop_rgba(0.0, b1, g1, r1, 0.95)
      rg.add_color_stop_rgba(1.0, b2, g2, r2, 0.55)
      cr.set_source(rg)
      if GLB.xmode:
         cr.set_line_width(4)
         cr.stroke()
      else:
         cr.fill_preserve()
         cr.set_source_rgba(1,1,1,0.8)
         cr.set_line_width(2)
         cr.stroke()

   cr.restore()
