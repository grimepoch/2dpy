def Init():
   # --- author : claude
   # --- a scanner walking a plane through a solid.  Each slice is the true
   # --- cross section at that depth, and the last few are kept as ghosts.
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Depth")
   STR.SetFParam1Name("Ghosts")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : show the readout
   # ---    trigger : sphere <-> torus

   GLB.steps = 150
   GLB.th = np.linspace(0.0, 2.0 * pi, GLB.steps)
   GLB.hist = []

   def text(x, y, s):
      cr.save()
      cr.translate(x, y)
      cr.scale(1.0, -1.0)
      cr.move_to(0, 0)
      cr.show_text(s)
      cr.restore()
   GLB.text = text

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.0, 1.0)
   f1 = STR.F1mix(1.0, 16.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0
      GLB.hist = []

   cr.set_source_rgb(0.02, 0.03, 0.04)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   # --- the plane sweeps back and forth through the solid
   z = -1.0 + 2.0 * (0.5 - 0.5 * cos(time * 0.55 + f0 * 6.28))
   R = 260.0

   def contour(zz):
      # --- returns the radii of the cross section at height zz, or None
      if GLB.xmode:
         # --- torus of tube radius 0.38 about a ring of radius 0.62
         a = 0.62
         b = 0.38
         if abs(zz) > b:
            return None
         k = sqrt(b * b - zz * zz)
         return [a - k, a + k]
      if abs(zz) > 1.0:
         return None
      return [0.0, sqrt(1.0 - zz * zz)]

   c = contour(z)
   GLB.hist.append([z, c])
   ng = int(f1)
   while len(GLB.hist) > ng:
      del GLB.hist[0]

   th = GLB.th
   cx = 640.0
   cy = 360.0

   for gi in range(len(GLB.hist)):
      hz = GLB.hist[gi][0]
      hc = GLB.hist[gi][1]
      if hc is None:
         continue
      age = (gi + 1) / (len(GLB.hist) * 1.0)
      t = 0.5 + 0.5 * hz
      r,g,b = hsv_to_rgb((f2 + t * 0.4) % 1.0, 0.8, 1.0)
      a = age * age
      cr.set_source_rgba(b * a, g * a, r * a, 1.0)
      cr.set_line_width(1.0 + 3.0 * age)
      for ri in range(2):
         rad = hc[ri] * R
         if rad < 1.0:
            continue
         xs = (cx + np.cos(th) * rad).tolist()
         ys = (cy + np.sin(th) * rad * 0.82 + hz * 90.0).tolist()
         cr.move_to(xs[0], ys[0])
         for i in range(1, GLB.steps):
            cr.line_to(xs[i], ys[i])
         cr.close_path()
      cr.stroke()

   # --- the scanning plane
   cr.set_source_rgba(0.3, 1.0, 0.6, 0.75)
   cr.set_line_width(2)
   yy = cy + z * 90.0
   cr.move_to(180, yy)
   cr.line_to(1100, yy)
   cr.stroke()
   cr.set_source_rgba(0.3, 1.0, 0.6, 0.10)
   cr.rectangle(180, yy - 9, 920, 18)
   cr.fill()

   if acc:
      cr.select_font_face("mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
      cr.set_font_size(22)
      cr.set_source_rgb(0.3, 1.0, 0.6)
      GLB.text(190, 660, "SLICE Z %+0.3f" % z)
      GLB.text(190, 630, "MODE  %s" % ("TORUS" if GLB.xmode else "SPHERE"))
      if c is None:
         GLB.text(190, 600, "SECTION EMPTY")
      else:
         GLB.text(190, 600, "R %.3f .. %.3f" % (c[0], c[1]))
      cr.set_line_width(1)
      cr.rectangle(1060, 180, 26, 360)
      cr.stroke()
      cr.rectangle(1060, 360 + z * 180.0 - 3, 26, 6)
      cr.fill()
