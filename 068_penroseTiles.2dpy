def Init():
   # --- author : claude
   # --- Penrose P3 rhombs by deflation.  The tiling is subdivided once and
   # --- cached; the frame only spins and scales it.
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Zoom")
   STR.SetFParam1Name("Depth")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : edges only
   # ---    trigger : rebuild with a new seed wheel

   GLB.phi = (1.0 + sqrt(5.0)) * 0.5
   GLB.depth = 0

   def deflate(tris, gen):
      # --- each half rhomb splits into two or three smaller ones
      out = []
      p = GLB.phi
      for t in tris:
         k = t[0]
         a = t[1]
         b = t[2]
         c = t[3]
         if k == 0:
            qx = a[0] + (b[0] - a[0]) / p
            qy = a[1] + (b[1] - a[1]) / p
            q = [qx, qy]
            out.append([0, c, q, b])
            out.append([1, q, c, a])
         else:
            qx = b[0] + (a[0] - b[0]) / p
            qy = b[1] + (a[1] - b[1]) / p
            rx = b[0] + (c[0] - b[0]) / p
            ry = b[1] + (c[1] - b[1]) / p
            q = [qx, qy]
            r = [rx, ry]
            out.append([1, r, c, a])
            out.append([0, r, q, b])
            out.append([1, q, a, r])
         if len(out) > 1100:
            return out
      return out
   GLB.deflate = deflate

   def build(depth):
      tris = []
      for i in range(10):
         b = [cos((2 * i - 1) * pi / 10.0), sin((2 * i - 1) * pi / 10.0)]
         c = [cos((2 * i + 1) * pi / 10.0), sin((2 * i + 1) * pi / 10.0)]
         if i % 2 == 0:
            t = b
            b = c
            c = t
         tris.append([0, [0.0, 0.0], b, c])
      for g in range(depth):
         tris = GLB.deflate(tris, g)
         if len(tris) > 950:
            break
      GLB.tris = tris
      # --- split by rhomb kind ONCE; re-filtering the list every frame was
      # --- the whole cost, not the rasterising
      GLB.kind = [[], []]
      for t in tris:
         GLB.kind[t[0]].append(t)
      GLB.depth = depth
   GLB.build = build
   GLB.build(4)

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(300.0, 1300.0)
   f1 = STR.F1mix(3.0, 5.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0
   d = int(f1)
   if d != GLB.depth:
      GLB.build(d)

   cr.set_source_rgb(0.03, 0.02, 0.04)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   cr.save()
   cr.translate(640, 360)
   cr.rotate(time * 0.06)
   sc = f0 * (1.0 + 0.06 * sin(time * 0.4))
   cr.scale(sc, sc)

   # --- one path per rhomb kind, so the whole tiling is two fills
   for kind in range(2):
      if GLB.xmode:
         r,g,b = hsv_to_rgb((f2 + kind * 0.5) % 1.0, 0.8, 1.0)
      else:
         r,g,b = hsv_to_rgb((f2 + kind * 0.08) % 1.0, 0.55, 0.35 + 0.5 * kind)
      cr.set_source_rgb(b, g, r)
      bucket = GLB.kind[kind]
      any = 1 if len(bucket) else 0
      for t in bucket:
         cr.move_to(t[1][0], t[1][1])
         cr.line_to(t[2][0], t[2][1])
         cr.line_to(t[3][0], t[3][1])
         cr.close_path()
         any = 1
      if any and not acc:
         cr.fill()
      elif any:
         cr.set_line_width(1.2 / sc)
         cr.stroke()

   if not acc and GLB.xmode:
      # --- lead lines between the rhombs, only in the outlined mode
      cr.set_source_rgba(0, 0, 0, 0.55)
      cr.set_line_width(1.2 / sc)
      for t in GLB.tris:
         cr.move_to(t[2][0], t[2][1])
         cr.line_to(t[1][0], t[1][1])
         cr.line_to(t[3][0], t[3][1])
      cr.stroke()

   cr.restore()
