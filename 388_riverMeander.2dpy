def Init():
   # --- author : claude
   # --- a river migrating across its floodplain.  Each bend grows because
   # --- the current cuts the outside of the curve, until two bends touch and
   # --- the loop is abandoned as an oxbow - and then the reach starts
   # --- bending again.  That cutoff is what keeps it going : without it the
   # --- meanders would wind up and stop, with it the river never finishes.
   # --- The scars of old channels are left on the floodplain and fade very
   # --- slowly, so the plain reaches a balance rather than filling up.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Migration")
   STR.SetFParam1Name("Sinuosity")
   STR.SetFParam2Name("Silt")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : a flood, the river migrates hard
   # ---    trigger : avulsion - the river jumps to a new course

   GLB.st = surface.get_stride() // 4
   GLB.n = 200

   def newcourse():
      t = np.linspace(0.0, 1.0, GLB.n)
      GLB.x = 40.0 + t * 1200.0
      GLB.y = 360.0 + np.sin(t * 9.0) * 30.0 + np.sin(t * 23.0) * 9.0
      GLB.ox = []
   GLB.newcourse = newcourse
   GLB.newcourse()

   cr.set_source_rgb(0.30, 0.42, 0.34)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.10, 1.3)
   f1 = STR.F1mix(2.0, 9.0)
   f2 = STR.F2mix(6.0, 10.0)
   time = STR.IT() + STR.FT()

   if trig:
      GLB.newcourse()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   # --- the floodplain slowly reworks itself, so old scars fade instead of
   # --- accumulating until the screen is full
   np.subtract(v, np.right_shift(v, int(f2)), out=v)
   v[:, :, 3] = 255
   surface.mark_dirty()

   x = GLB.x
   y = GLB.y
   n = GLB.n

   # --- tangents and discrete curvature along the centreline
   dx = np.zeros(n, dtype=np.float64)
   dy = np.zeros(n, dtype=np.float64)
   dx[1:-1] = x[2:] - x[:-2]
   dy[1:-1] = y[2:] - y[:-2]
   dx[0] = x[1] - x[0]
   dy[0] = y[1] - y[0]
   dx[-1] = x[-1] - x[-2]
   dy[-1] = y[-1] - y[-2]
   sp = np.sqrt(dx * dx + dy * dy) + 1e-9
   tx = dx / sp
   ty = dy / sp
   curv = np.zeros(n, dtype=np.float64)
   curv[1:-1] = (tx[1:-1] * (ty[2:] - ty[:-2]) -
                 ty[1:-1] * (tx[2:] - tx[:-2])) / sp[1:-1]

   # --- the bank does not respond where the curve is, it responds a little
   # --- way downstream of it.  That lag is what makes the loops lean over
   # --- and travel, instead of just growing symmetrically.
   k = 9
   ker = np.exp(-np.arange(k) * 0.35)
   ker = ker / ker.sum()
   sm = np.convolve(curv, ker, mode="same")
   lag = 4
   mig = np.zeros(n, dtype=np.float64)
   mig[lag:] = sm[:-lag]

   # --- a tight bend is a big curvature is a faster cut is a tighter bend.
   # --- Left uncapped that runs away long before a cutoff can relieve it,
   # --- and the whole reach collapses into one corner.
   np.clip(mig, -0.035, 0.035, out=mig)
   rate = f0 * (3.2 if acc else 1.0)
   # --- the OUTSIDE of the bend is what gets cut.  For a left-hand bend the
   # --- outward normal is (ty, -tx); taking (-ty, tx) instead migrates every
   # --- bend into its own centre and the river just straightens out.
   nx_ = ty
   ny_ = -tx
   x = x + nx_ * mig * rate * 95.0
   y = y + ny_ * mig * rate * 95.0
   # --- numerical viscosity : without it the centreline grows kinks at the
   # --- point spacing, which the curvature estimate then amplifies
   x[1:-1] = x[1:-1] + (x[:-2] + x[2:] - 2.0 * x[1:-1]) * 0.14
   y[1:-1] = y[1:-1] + (y[:-2] + y[2:] - 2.0 * y[1:-1]) * 0.14
   # --- the two ends are pinned : the river enters and leaves the frame
   x[0] = 40.0
   y[0] = 360.0
   x[-1] = 1240.0
   y[-1] = 360.0
   np.clip(y, 60.0, 660.0, out=y)

   # --- respace the points evenly, or they bunch up on the tight bends and
   # --- the curvature estimate falls apart
   seg = np.sqrt((x[1:] - x[:-1]) ** 2 + (y[1:] - y[:-1]) ** 2)
   arc = np.zeros(n)
   arc[1:] = np.cumsum(seg)
   tot = arc[-1]
   even = np.linspace(0.0, tot, n)
   x = np.interp(even, arc, x)
   y = np.interp(even, arc, y)

   # --- cutoff : any two points far apart ALONG the river but close across
   # --- it have pinched off the loop between them
   cut = 12.0 + (9.0 - f1) * 1.4
   gap = 10
   d2 = ((x.reshape(n, 1) - x.reshape(1, n)) ** 2 +
         (y.reshape(n, 1) - y.reshape(1, n)) ** 2)
   idx = np.arange(n)
   far = (idx.reshape(n, 1) - idx.reshape(1, n)) > gap
   hit = far & (d2 < cut * cut)
   if hit.any():
      ij = np.argwhere(hit)
      i = int(ij[0][1])
      j = int(ij[0][0])
      # --- the abandoned loop becomes standing water on the plain
      cr.set_source_rgb(0.52, 0.40, 0.20)
      cr.set_line_width(9.0)
      cr.set_line_cap(cairo.LINE_CAP_ROUND)
      cr.move_to(x[i], y[i])
      for k2 in range(i + 1, j + 1):
         cr.line_to(x[k2], y[k2])
      cr.stroke()
      keepx = np.concatenate((x[:i + 1], x[j:]))
      keepy = np.concatenate((y[:i + 1], y[j:]))
      m = len(keepx)
      seg = np.sqrt((keepx[1:] - keepx[:-1]) ** 2 +
                    (keepy[1:] - keepy[:-1]) ** 2)
      arc = np.zeros(m)
      arc[1:] = np.cumsum(seg)
      even = np.linspace(0.0, arc[-1], n)
      x = np.interp(even, arc, keepx)
      y = np.interp(even, arc, keepy)

   GLB.x = x
   GLB.y = y

   # --- the scar the channel is leaving behind it
   cr.set_source_rgba(0.36, 0.50, 0.42, 0.55)
   cr.set_line_width(13.0)
   cr.set_line_cap(cairo.LINE_CAP_ROUND)
   cr.set_line_join(cairo.LINE_JOIN_ROUND)
   cr.move_to(x[0], y[0])
   for i in range(1, n):
      cr.line_to(x[i], y[i])
   cr.stroke()

   # --- the water
   c = hsv_to_rgb((0.56 + 0.07 * sin(time * 0.05)) % 1.0, 0.62, 0.85)
   cr.set_source_rgb(c[2], c[1], c[0])
   cr.set_line_width(8.0)
   cr.move_to(x[0], y[0])
   for i in range(1, n):
      cr.line_to(x[i], y[i])
   cr.stroke()
   # --- a point bar on the inside of every bend
   cr.set_source_rgba(0.55, 0.72, 0.86, 0.5)
   cr.set_line_width(2.5)
   cr.move_to(x[0] - nx_[0] * 7.0, y[0] - ny_[0] * 7.0)
   for i in range(1, n):
      cr.line_to(x[i] - nx_[i] * 7.0, y[i] - ny_[i] * 7.0)
   cr.stroke()
