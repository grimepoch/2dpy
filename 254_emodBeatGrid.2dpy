def Init():
   # --- author : claude
   # --- a step sequencer that remembers.  Every hit lights its cell and the
   # --- grid is never cleared, only dimmed - so after a few bars the
   # --- pattern of what has been played is visible underneath what is being
   # --- played now, and you can see the groove as a shape.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Steps")
   STR.SetFParam1Name("Memory")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : every lane flashes
   # ---    trigger : clear the pattern

   GLB.nstep = 16
   GLB.nlane = 12
   GLB.cell = np.zeros((GLB.nlane, GLB.nstep), dtype=np.float32)
   GLB.prev = np.zeros(GLB.slots, dtype=np.float32)

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(4.0, 32.99)
   f1 = STR.F1mix(0.90, 0.998)
   f2 = STR.F2()
   it = STR.IT()
   ft = STR.FT()

   ns = int(f0)
   if ns != GLB.nstep:
      GLB.nstep = ns
      GLB.cell = np.zeros((GLB.nlane, ns), dtype=np.float32)
   if trig:
      GLB.cell = GLB.cell * 0.0
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   step = it % GLB.nstep
   GLB.cell = GLB.cell * f1

   for i in range(GLB.slots):
      d = STR.GetSlotData(i)
      vel = d[2] * 1.0
      if d[0] != 0 and vel > GLB.prev[i] + 5.0:
         lane = int(d[1]) % GLB.nlane
         GLB.cell[lane, step] = min(1.0, GLB.cell[lane, step] * 0.4 +
                                    (vel / 127.0) * 1.1)
      GLB.prev[i] = vel
   if acc:
      GLB.cell[:, step] = np.maximum(GLB.cell[:, step], 0.55)

   cr.set_source_rgba(0, 0, 0, 1)
   cr.rectangle(0, 0, 1280, 720)
   cr.fill()

   cw = 1280.0 / GLB.nstep
   ch = 720.0 / GLB.nlane
   for l in range(GLB.nlane):
      for s in range(GLB.nstep):
         v = GLB.cell[l, s]
         on = s == step
         if v < 0.01 and not on:
            continue
         c = hsv_to_rgb((f2 + l / (GLB.nlane * 1.0) * 0.7) % 1.0, 0.80,
                        min(1.0, 0.10 + v * 1.3))
         if on:
            c = hsv_to_rgb((f2 + l / (GLB.nlane * 1.0) * 0.7) % 1.0, 0.35,
                           min(1.0, 0.32 + v))
         cr.set_source_rgb(c[2], c[1], c[0])
         cr.rectangle(s * cw + 2, l * ch + 2, cw - 4, ch - 4)
         cr.fill()

   # --- the playhead, swept smoothly across the current step
   x = (step + ft) * cw
   cr.set_source_rgba(1.0, 1.0, 1.0, 0.30)
   cr.rectangle(x - 1, 0, 3, 720)
   cr.fill()
