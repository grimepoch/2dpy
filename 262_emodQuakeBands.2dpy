def Init():
   # --- author : claude
   # --- every note is an earthquake.  The canvas is displaced sideways in
   # --- bands and the fault lines are drawn over the top, so the picture
   # --- carries the record of every hit that came before it.
   # --- Rows are moved in 48 contiguous slabs rather than per row : a
   # --- per-row offset is a fancy index over the whole frame and costs more
   # --- than everything else in the program together.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Throw")
   STR.SetFParam1Name("Settle")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : aftershocks
   # ---    trigger : reset the ground

   GLB.st = surface.get_stride() // 4
   GLB.nb = 48
   GLB.bh = 720 // GLB.nb
   GLB.off = np.zeros(GLB.nb, dtype=np.float32)
   GLB.prev = np.zeros(GLB.slots, dtype=np.float32)

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(2.0, 22.0)
   f1 = STR.F1mix(0.70, 0.97)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.off = GLB.off * 0.0
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   # --- a hit is a RISE in level, which is the only reading that works for
   # --- both slot modes : note velocities jump from nothing, but spectrum
   # --- slots are always live and only their level moves
   hits = []
   for i in range(GLB.slots):
      d = STR.GetSlotData(i)
      vel = d[2] * 1.0
      if d[0] != 0 and vel > GLB.prev[i] + 5.0:
         hits.append([d[1], vel])
      GLB.prev[i] = vel

   for h in hits:
      b = int(h[0]) % GLB.nb
      amp = (h[1] / 127.0) * f0
      sgn = 1.0 if (int(h[0]) % 2) == 0 else -1.0
      for k in range(-3, 4):
         j = b + k
         if 0 <= j < GLB.nb:
            GLB.off[j] = GLB.off[j] + sgn * amp / (1.0 + abs(k))

   if acc:
      GLB.off = GLB.off + (np.random.random(GLB.nb) - 0.5) * f0 * 0.5

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   np.subtract(v, np.right_shift(v, 6), out=v)
   for b in range(GLB.nb):
      sft = int(GLB.off[b])
      if sft == 0:
         continue
      y0 = b * GLB.bh
      y1 = y0 + GLB.bh
      if sft > 0:
         if sft >= 1280:
            sft = 1279
         v[y0:y1, :-sft] = v[y0:y1, sft:]
         v[y0:y1, -sft:] = 0
      else:
         k = -sft
         if k >= 1280:
            k = 1279
         v[y0:y1, k:] = v[y0:y1, :-k]
         v[y0:y1, :k] = 0
   v[:, :, 3] = 255
   surface.mark_dirty()
   GLB.off = GLB.off * f1

   # --- the fault : wherever two slabs are moving differently, a bright seam
   for b in range(1, GLB.nb):
      d = abs(GLB.off[b] - GLB.off[b-1])
      if d < 0.6:
         continue
      l = min(d / 10.0, 1.0)
      c = hsv_to_rgb((f2 + b * 0.012) % 1.0, 0.55, 1.0)
      cr.set_source_rgba(c[2] * l, c[1] * l, c[0] * l, 1.0)
      cr.rectangle(0, b * GLB.bh - 1, 1280, 2)
      cr.fill()

   # --- strata, so there is always something for the quake to displace
   for k in range(14):
      y = ((time * 9.0 + k * 52.0) % 760.0) - 20.0
      c = hsv_to_rgb((f2 + k * 0.07) % 1.0, 0.75, 0.55)
      cr.set_source_rgb(c[2], c[1], c[0])
      cr.rectangle(0, y, 1280, 7)
      cr.fill()
