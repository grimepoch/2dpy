def Init():
   # --- author : claude
   # --- a spectrum waterfall in perspective : every frame pushes a new row
   # --- toward the horizon, so you can read the history of the sound
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Depth")
   STR.SetFParam1Name("Height")
   STR.SetFParam2Name("Hue")
   # ---    accent : filled ribbons
   # ---    trigger : wire <-> solid horizon

   # --- 10 slots = FFT analysis bins, 24 slots = MIDI notes
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   GLB.mode = "auto"
   if GLB.slots == 10:
      GLB.mode = "audio"
   if GLB.slots == 24:
      GLB.mode = "midi"

   GLB.n = 12 if GLB.slots == 24 else GLB.slots
   GLB.rows = 34
   GLB.hist = []
   for j in range(GLB.rows):
      r = []
      for i in range(GLB.n):
         r.append(0.0)
      GLB.hist.append(r)
   GLB.lvl = []
   for i in range(GLB.n):
      GLB.lvl.append(0.0)

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.35, 0.95)
   f1 = STR.F1mix(30.0, 180.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.xmode = 1 if GLB.xmode==0 else 0

   n = GLB.n
   for k in range(n):
      GLB.lvl[k] = GLB.lvl[k] * 0.80

   for i in range(GLB.slots):
      (ids, note, velo) = STR.GetSlotData(i)
      if ids == 0:
         continue
      k = (note % 12) if GLB.mode == "midi" else i
      if k < n:
         v = velo / 127.0
         if v > GLB.lvl[k]:
            GLB.lvl[k] = v

   # --- push a new row in at the front
   row = []
   for k in range(n):
      row.append(GLB.lvl[k])
   GLB.hist.insert(0, row)
   while len(GLB.hist) > GLB.rows:
      del GLB.hist[len(GLB.hist) - 1]

   cr.set_source_rgb(0.02, 0.01, 0.04)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   hz = 620.0
   ybase = 90.0

   # --- far rows first so nearer ones cover them
   for j in range(GLB.rows - 1, -1, -1):
      d = j / (GLB.rows * 1.0)
      # --- perspective compression toward the horizon
      p = pow(1.0 - d, f0 * 2.0)
      y = ybase + (hz - ybase) * (1.0 - p)
      wid = 90.0 + 1050.0 * p
      hgt = f1 * p
      if wid < 4:
         continue
      r = GLB.hist[j]
      t = 1.0 - d
      hue = (f2 + d * 0.4) % 1.0
      if GLB.xmode:
         br = t * t
      else:
         br = 0.25 + 0.75 * t
      c = hsv_to_rgb(hue, 0.8, br)

      x0 = 640.0 - wid * 0.5
      cr.move_to(x0, y)
      for k in range(n):
         u = k / (n - 1.0)
         cr.line_to(x0 + wid * u, y + r[k] * hgt)
      cr.line_to(x0 + wid, y)
      if acc:
         cr.close_path()
         cr.set_source_rgb(c[2] * 0.5, c[1] * 0.5, c[0] * 0.5)
         cr.fill_preserve()
         cr.set_source_rgb(c[2], c[1], c[0])
         cr.set_line_width(1.2)
         cr.stroke()
      else:
         cr.set_source_rgb(c[2], c[1], c[0])
         cr.set_line_width(1.0 + 2.0 * t)
         cr.stroke()
