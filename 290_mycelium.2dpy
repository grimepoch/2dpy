def Init():
   # --- author : claude
   # --- a fungus colonising the plate.  Hyphal tips wander, branch and lay
   # --- down filament that is never redrawn - the mat you see is entirely
   # --- history.  A tip that walks into its own mat dies back, so the colony
   # --- spreads outward instead of filling in.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Growth")
   STR.SetFParam1Name("Branching")
   STR.SetFParam2Name("Age")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : fruiting bodies
   # ---    trigger : scatter fresh spores (the mat is left alone - a stray
   # ---              trigger should not throw away a minute of growth)

   GLB.st = surface.get_stride() // 4
   GLB.res = 4
   GLB.gx = 1280 // GLB.res
   GLB.gy = 720 // GLB.res
   GLB.cap = 420

   GLB.occ = np.zeros((GLB.gy, GLB.gx), dtype=np.int32)
   GLB.n = 0
   GLB.tx = np.zeros(GLB.cap)
   GLB.ty = np.zeros(GLB.cap)
   GLB.ta = np.zeros(GLB.cap)
   GLB.tl = np.zeros(GLB.cap)
   GLB.tc = np.full(GLB.cap, -1, dtype=np.int32)

   def spores(n):
      for i in range(n):
         if GLB.n >= GLB.cap:
            return
         j = GLB.n
         GLB.tx[j] = np.random.random() * 1000.0 + 140.0
         GLB.ty[j] = np.random.random() * 520.0 + 100.0
         GLB.ta[j] = np.random.random() * 6.283
         GLB.tl[j] = 280.0 + np.random.random() * 260.0
         GLB.tc[j] = -1
         GLB.n = j + 1
   GLB.spores = spores
   GLB.spores(9)

   cr.set_source_rgba(0, 0, 0, 1)
   cr.rectangle(0, 0, 1280, 720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(1.4, 5.0)
   f1 = STR.F1mix(0.010, 0.075)
   f2 = STR.F2mix(8.0, 11.0)
   time = STR.IT() + STR.FT()

   if trig:
      GLB.spores(6)
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   np.subtract(v, np.right_shift(v, int(f2)), out=v)
   v[:, :, 3] = 255
   surface.mark_dirty()

   occ = GLB.occ
   c = hsv_to_rgb((0.12 + 0.05 * sin(time * 0.1)) % 1.0, 0.25, 0.95)
   cr.set_source_rgb(c[2], c[1], c[0])
   cr.set_line_width(1.4)
   cr.set_line_cap(cairo.LINE_CAP_ROUND)

   i = 0
   born = []
   while i < GLB.n:
      GLB.ta[i] = GLB.ta[i] + (np.random.random() - 0.5) * 0.55
      x0 = GLB.tx[i]
      y0 = GLB.ty[i]
      x1 = x0 + cos(GLB.ta[i]) * f0
      y1 = y0 + sin(GLB.ta[i]) * f0
      GLB.tx[i] = x1
      GLB.ty[i] = y1
      GLB.tl[i] = GLB.tl[i] - 1.0
      cr.move_to(x0, y0)
      cr.line_to(x1, y1)

      gx = int(x1 / GLB.res)
      gy = int(y1 / GLB.res)
      off = (gx < 0 or gx >= GLB.gx or gy < 0 or gy >= GLB.gy)
      # --- walking into established mat is what stops it, not a timer.
      # --- The test only counts when the tip crosses into a NEW cell : a
      # --- slow tip otherwise sits in one cell for several frames and
      # --- crowds itself out after three of them.
      crowd = 0
      if not off:
         cid = gy * GLB.gx + gx
         if cid != GLB.tc[i]:
            crowd = occ[gy, gx]
            occ[gy, gx] = crowd + 1
            GLB.tc[i] = cid
      if off or crowd > 2 or GLB.tl[i] <= 0.0:
         last = GLB.n - 1
         GLB.tx[i] = GLB.tx[last]
         GLB.ty[i] = GLB.ty[last]
         GLB.ta[i] = GLB.ta[last]
         GLB.tl[i] = GLB.tl[last]
         GLB.tc[i] = GLB.tc[last]
         GLB.n = GLB.n - 1
      else:
         if np.random.random() < f1 and GLB.n + len(born) < GLB.cap:
            # --- a branch gets its OWN lease, not the parent's remainder,
            # --- or the whole colony expires on the same frame
            born.append([x1, y1, GLB.ta[i] + (np.random.random() - 0.5) * 2.2,
                         240.0 + np.random.random() * 260.0, GLB.tc[i]])
         i = i + 1
   cr.stroke()

   for b in born:
      j = GLB.n
      GLB.tx[j] = b[0]
      GLB.ty[j] = b[1]
      GLB.ta[j] = b[2]
      GLB.tl[j] = b[3]
      GLB.tc[j] = b[4]
      GLB.n = j + 1
   GLB.occ = occ

   # --- the colony has died out : drop new spores rather than go blank
   if GLB.n < 6:
      GLB.spores(5)

   if acc:
      cc = hsv_to_rgb(0.03, 0.8, 1.0)
      cr.set_source_rgb(cc[2], cc[1], cc[0])
      for k in range(3):
         j = np.random.randint(max(GLB.n, 1))
         cr.new_sub_path()
         cr.arc(GLB.tx[j], GLB.ty[j], 2.0 + np.random.random() * 5.0,
                0, 6.2831853)
      cr.fill()
