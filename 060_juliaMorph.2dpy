def Init():
   # --- author : claude
   # --- a Julia set whose seed c walks a slow circle, so the shape keeps
   # --- turning itself inside out.  Escape times come out of numpy.
   # --- note : screen y=0 is the BOTTOM, colours are passed as (b,g,r)

   STR.SetFParam0Name("Zoom")
   STR.SetFParam1Name("Detail")
   STR.SetFParam2Name("Palette")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : invert the bands
   # ---    trigger : jump the seed somewhere new

   GLB.res = 10
   GLB.nx = int(1280 / GLB.res) + 1
   GLB.ny = int(720 / GLB.res) + 1
   xs = np.linspace(-1.0, 1.0, GLB.nx)
   ys = np.linspace(-0.5625, 0.5625, GLB.ny)
   GLB.X = np.tile(xs.reshape(1, GLB.nx), (GLB.ny, 1)).astype(np.float32)
   GLB.Y = np.tile(ys.reshape(GLB.ny, 1), (1, GLB.nx)).astype(np.float32)
   GLB.jx = 0.0
   GLB.jy = 0.0

   # --- clear screen
   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.7, 2.6)
   f1 = STR.F1mix(8.0, 24.0)
   f2 = STR.F2()

   time = STR.IT() + STR.FT()

   if trig:
      GLB.jx = (np.random.random() - 0.5) * 1.2
      GLB.jy = (np.random.random() - 0.5) * 1.2
      GLB.xmode = 1 if GLB.xmode==0 else 0

   # --- seed walks the cardioid edge, which is where the good shapes live
   a = time * 0.12
   cx = 0.7885 * cos(a) + GLB.jx * 0.3
   cy = 0.7885 * sin(a) + GLB.jy * 0.3

   zx = GLB.X * f0
   zy = GLB.Y * f0
   it = np.zeros(zx.shape, dtype=np.int32)
   maxi = int(f1)
   alive = np.ones(zx.shape, dtype=bool)

   for i in range(maxi):
      zx2 = zx * zx
      zy2 = zy * zy
      alive = alive & ((zx2 + zy2) < 4.0)
      if not alive.any():
         break
      nzx = zx2 - zy2 + cx
      nzy = 2.0 * zx * zy + cy
      zx = np.where(alive, nzx, zx)
      zy = np.where(alive, nzy, zy)
      it = it + alive

   cr.set_source_rgb(0,0,0)
   cr.rectangle(0,0,1280,720)
   cr.fill()

   bands = 14
   q = (it * bands) // (maxi + 1)
   res = GLB.res

   pal = []
   for b in range(bands):
      t = b / (bands - 1.0)
      if acc:
         t = 1.0 - t
      if GLB.xmode:
         r,g,bl = hsv_to_rgb((f2 + t * 0.9) % 1.0, 0.9, 1.0)
      else:
         r,g,bl = hsv_to_rgb((f2 + t * 0.28) % 1.0, 0.95 - 0.6 * t, 0.25 + 0.75 * t)
      pal.append((bl, g, r))

   # --- Walk each row ONCE and let numpy find the run boundaries, rather
   # --- than rescanning every row for every band.
   inner = bands - 1
   for j in range(GLB.ny):
      row = q[j]
      cuts = (np.nonzero(np.diff(row))[0] + 1).tolist()
      starts = [0] + cuts
      ends = cuts + [GLB.nx]
      vals = row[starts].tolist()
      yy = j * res
      for k in range(len(starts)):
         v = vals[k]
         if v >= inner:
            continue
         c = pal[v]
         cr.set_source_rgb(c[0], c[1], c[2])
         cr.rectangle(starts[k] * res, yy, (ends[k] - starts[k]) * res + 0.6, res + 0.6)
         cr.fill()
