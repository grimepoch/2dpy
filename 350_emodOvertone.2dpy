def Init():
   # --- author : claude
   # --- overtone singing.  One drone, and a filter sharp enough to pick a
   # --- single partial out of it and make it audible as a separate note -
   # --- so the melody is made by changing the shape of the mouth, not by
   # --- changing the pitch. The drone is drawn as the full series with the
   # --- selected partial lit.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Drone")
   STR.SetFParam1Name("Selectivity")
   STR.SetFParam2Name("Hue")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : two resonances, a second voice
   # ---    trigger : new drone pitch

   GLB.st = surface.get_stride() // 4
   GLB.sel = 6.0
   GLB.fund = 90.0
   GLB.lvl = 0.0
   GLB.prev = np.zeros(GLB.slots, dtype=np.float32)

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(60.0, 160.0)
   f1 = STR.F1mix(1.0, 22.0)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.fund = f0
      GLB.xmode = 1 if GLB.xmode == 0 else 0
   GLB.fund = GLB.fund + (f0 - GLB.fund) * 0.04

   hit = 0.0
   for i in range(GLB.slots):
      d = STR.GetSlotData(i)
      vel = d[2] * 1.0
      if d[0] != 0 and vel > GLB.prev[i] + 5.0:
         # --- the note picks which partial the mouth is tuned to
         GLB.sel = 3.0 + (int(d[1]) % 14)
         hit = max(hit, vel / 127.0)
      GLB.prev[i] = vel
   GLB.lvl = max(hit, GLB.lvl * 0.93)

   surface.flush()
   v = np.ndarray(shape=(720, GLB.st, 4), dtype=np.uint8,
                  buffer=surface.get_data())
   np.subtract(v, np.right_shift(v, 4), out=v)
   v[:, :, 3] = 255
   surface.mark_dirty()

   npt = 26
   cr.set_line_width(2.0)
   for k in range(1, npt + 1):
      fq = GLB.fund * k
      x = (log(fq / 60.0) / log(60.0)) * 1200.0 + 40.0
      if x < 0 or x > 1280:
         continue
      # --- the resonance : a narrow peak on the chosen partial, and every
      # --- other partial is still there underneath it
      q = f1
      dd = (k - GLB.sel)
      gain = 1.0 / (1.0 + (dd * q * 0.22) ** 2)
      if acc:
         dd2 = (k - GLB.sel * 1.55)
         gain = gain + 0.7 / (1.0 + (dd2 * q * 0.22) ** 2)
      base = 1.0 / (1.0 + k * 0.30)
      h = (base * 0.25 + gain * (0.35 + GLB.lvl * 0.9)) * 520.0
      c = hsv_to_rgb((f2 + k * 0.03) % 1.0, 0.70,
                     min(0.30 + gain, 1.0))
      cr.set_source_rgba(c[2], c[1], c[0], 0.92)
      cr.move_to(x, 660.0)
      cr.line_to(x, 660.0 - h)
      cr.stroke()

   # --- the resonance curve itself, over the top
   cr.set_source_rgba(1.0, 1.0, 1.0, 0.35)
   cr.set_line_width(1.4)
   started = False
   for i in range(0, 129):
      kk = 1.0 + i * (npt / 128.0)
      fq = GLB.fund * kk
      x = (log(fq / 60.0) / log(60.0)) * 1200.0 + 40.0
      dd = (kk - GLB.sel)
      gain = 1.0 / (1.0 + (dd * f1 * 0.22) ** 2)
      y = 660.0 - gain * 420.0
      if not started:
         cr.move_to(x, y)
         started = True
      else:
         cr.line_to(x, y)
   cr.stroke()
