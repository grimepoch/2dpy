def Init():
   # --- author : claude
   # --- pipes growing across the plate.  A run goes until it hits something
   # --- it has already laid, then elbows - so the layout is built entirely
   # --- out of collisions with its own past, and no two are alike.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Flow Rate")
   STR.SetFParam1Name("Bore")
   STR.SetFParam2Name("Alloy")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : valves and flanges
   # ---    trigger : strip the plate

   GLB.res = 8
   GLB.gx = 1280 // GLB.res
   GLB.gy = 720 // GLB.res
   GLB.dxs = [1, 0, -1, 0]
   GLB.dys = [0, 1, 0, -1]

   def strip():
      GLB.occ = np.zeros((GLB.gy, GLB.gx), dtype=np.int32)
      GLB.n = 5
      GLB.px = []
      GLB.py = []
      GLB.pd = []
      GLB.ph = []
      for i in range(GLB.n):
         GLB.px.append(int(np.random.randint(4, GLB.gx - 4)))
         GLB.py.append(int(np.random.randint(4, GLB.gy - 4)))
         GLB.pd.append(int(np.random.randint(0, 4)))
         GLB.ph.append(np.random.random())
      cr.set_source_rgb(0.10, 0.09, 0.08)
      cr.rectangle(0, 0, 1280, 720)
      cr.fill()
   GLB.strip = strip
   GLB.strip()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(0.5, 5.0)
   f1 = STR.F1mix(3.0, 9.0)
   f2 = STR.F2()
   time = STR.IT() + STR.FT()

   if trig:
      GLB.strip()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   occ = GLB.occ
   R = GLB.res
   cr.set_line_cap(cairo.LINE_CAP_ROUND)
   cr.set_line_join(cairo.LINE_JOIN_ROUND)
   steps = int(f0)
   if np.random.random() < (f0 % 1.0):
      steps = steps + 1

   for s in range(steps):
      for i in range(GLB.n):
         x = GLB.px[i]
         y = GLB.py[i]
         d = GLB.pd[i]
         nx = x + GLB.dxs[d]
         ny = y + GLB.dys[d]
         blocked = (nx < 1 or nx >= GLB.gx - 1 or ny < 1 or ny >= GLB.gy - 1
                    or occ[ny, nx] != 0)
         if blocked:
            # --- try the two turns, then give up and start a new run
            opts = []
            for t in (1, 3):
               dd = (d + t) % 4
               tx = x + GLB.dxs[dd]
               ty = y + GLB.dys[dd]
               if (1 <= tx < GLB.gx - 1 and 1 <= ty < GLB.gy - 1
                     and occ[ty, tx] == 0):
                  opts.append(dd)
            if len(opts) == 0:
               GLB.px[i] = int(np.random.randint(4, GLB.gx - 4))
               GLB.py[i] = int(np.random.randint(4, GLB.gy - 4))
               GLB.pd[i] = int(np.random.randint(0, 4))
               GLB.ph[i] = np.random.random()
               continue
            d = opts[np.random.randint(len(opts))]
            GLB.pd[i] = d
            nx = x + GLB.dxs[d]
            ny = y + GLB.dys[d]
         occ[ny, nx] = 1
         GLB.px[i] = nx
         GLB.py[i] = ny

         c = hsv_to_rgb((GLB.ph[i] + f2) % 1.0, 0.55, 0.95)
         cr.set_line_width(f1)
         cr.set_source_rgb(c[2], c[1], c[0])
         cr.move_to(x * R + R * 0.5, y * R + R * 0.5)
         cr.line_to(nx * R + R * 0.5, ny * R + R * 0.5)
         cr.stroke()
         # --- a specular line down the top of the pipe
         cr.set_line_width(max(1.0, f1 * 0.28))
         cr.set_source_rgb(min(c[2] + 0.45, 1.0), min(c[1] + 0.45, 1.0),
                           min(c[0] + 0.45, 1.0))
         cr.move_to(x * R + R * 0.5, y * R + R * 0.5 - f1 * 0.22)
         cr.line_to(nx * R + R * 0.5, ny * R + R * 0.5 - f1 * 0.22)
         cr.stroke()

         if acc and np.random.random() < 0.05:
            cr.set_source_rgb(0.30, 0.55, 0.85)
            cr.new_sub_path()
            cr.arc(nx * R + R * 0.5, ny * R + R * 0.5, f1 * 0.85,
                   0, 6.2831853)
            cr.fill()
   GLB.occ = occ
