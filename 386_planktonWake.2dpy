def Init():
   # --- author : claude
   # --- a bioluminescent wake.  Dinoflagellates flash when the water round
   # --- them is sheared, so anything moving through them leaves a trail of
   # --- light - and each one needs time to recharge before it can flash
   # --- again, so the sea remembers where the last pass went.
   # --- note : colours are passed as (b,g,r)

   STR.SetFParam0Name("Swimmers")
   STR.SetFParam1Name("Recharge")
   STR.SetFParam2Name("Glow")
   GLB.slots = STR.GetMaxSlots()
   GLB.xmode = 0
   # ---    accent : a breaking wave lights the whole front
   # ---    trigger : new swimmers

   GLB.st = surface.get_stride() // 4
   GLB.res = 4
   GLB.gx = 1280 // GLB.res
   GLB.gy = 720 // GLB.res
   GLB.small = cairo.ImageSurface(cairo.FORMAT_ARGB32, GLB.gx, GLB.gy)
   GLB.sst = GLB.small.get_stride() // 4
   GLB.sv = np.ndarray(shape=(GLB.gy, GLB.sst, 4), dtype=np.uint8,
                       buffer=GLB.small.get_data())
   # --- charge is what each cell has available to flash with
   GLB.chg = np.ones((GLB.gy, GLB.gx), dtype=np.float32)
   GLB.lit = np.zeros((GLB.gy, GLB.gx), dtype=np.float32)

   def swimmers():
      n = 7
      GLB.n = n
      GLB.px = np.random.random(n) * GLB.gx
      GLB.py = np.random.random(n) * GLB.gy
      GLB.pa = np.random.random(n) * 6.283
      GLB.pv = 0.8 + np.random.random(n) * 1.6
   GLB.swimmers = swimmers
   GLB.swimmers()

   cr.set_source_rgba(0,0,0,1)
   cr.rectangle(0,0,1280,720)
   cr.fill()


def Render(cr):
   acc  = STR.CheckAccent()
   trig = STR.CheckTrigger()
   f0 = STR.F0mix(1.0, 6.99)
   f1 = STR.F1mix(0.002, 0.030)
   f2 = STR.F2mix(0.4, 1.6)
   time = STR.IT() + STR.FT()

   if trig:
      GLB.swimmers()
      GLB.xmode = 1 if GLB.xmode == 0 else 0

   GLB.lit = GLB.lit * 0.90
   # --- the cells recharge slowly, which is why a second pass over the same
   # --- water is dimmer than the first
   GLB.chg = np.clip(GLB.chg + f1, 0.0, 1.0)

   n = int(f0)
   GLB.pa[:GLB.n] = GLB.pa[:GLB.n] + (
      np.random.random(GLB.n) - 0.5) * 0.35
   GLB.px[:GLB.n] = np.mod(GLB.px[:GLB.n] +
                           np.cos(GLB.pa[:GLB.n]) * GLB.pv[:GLB.n], GLB.gx)
   GLB.py[:GLB.n] = np.mod(GLB.py[:GLB.n] +
                           np.sin(GLB.pa[:GLB.n]) * GLB.pv[:GLB.n], GLB.gy)

   for i in range(min(n, GLB.n)):
      cx = int(GLB.px[i])
      cy = int(GLB.py[i])
      w = 7
      x0 = max(cx - w, 0)
      x1 = min(cx + w, GLB.gx)
      y0 = max(cy - w, 0)
      y1 = min(cy + w, GLB.gy)
      if x1 <= x0 or y1 <= y0:
         continue
      # --- the flash takes the charge that was there
      take = GLB.chg[y0:y1, x0:x1] * 0.8
      GLB.lit[y0:y1, x0:x1] = np.maximum(GLB.lit[y0:y1, x0:x1], take)
      GLB.chg[y0:y1, x0:x1] = GLB.chg[y0:y1, x0:x1] - take

   if acc:
      # --- a breaker : a whole line of shear crossing the frame
      xs = int((time * 30.0) % GLB.gx)
      take = GLB.chg[:, xs:xs+3] * 0.9
      GLB.lit[:, xs:xs+3] = np.maximum(GLB.lit[:, xs:xs+3], take)
      GLB.chg[:, xs:xs+3] = GLB.chg[:, xs:xs+3] - take

   glow = np.clip(GLB.lit * f2, 0.0, 1.0)
   GLB.sv[:, :GLB.gx, 0] = np.clip(glow * glow * 120.0 + 2.0,
                                   0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.gx, 1] = np.clip(glow * 225.0 + 5.0,
                                   0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.gx, 2] = np.clip(glow * 245.0 + 14.0,
                                   0, 255).astype(np.uint8)
   GLB.sv[:, :GLB.gx, 3] = 255
   GLB.small.mark_dirty()
   pat = cairo.SurfacePattern(GLB.small)
   pat.set_filter(cairo.FILTER_NEAREST)
   m = cairo.Matrix()
   m.scale(1.0 / GLB.res, 1.0 / GLB.res)
   pat.set_matrix(m)
   cr.set_source(pat)
   cr.paint()
